## luced-2d's scripting API, as Maya's is to its commands: every call here is
## one editor action, done in the open document as the script runs, and the
## whole run is one undo step. A script is a Luce program — `import luced`, a
## `main` — run by the editor's Luce interpreter in a sandbox folder.
##
## Colors are sRGB, 0..1 a channel. Positions and sizes are document pixels,
## (0, 0) the top-left corner. Layers count from 0 at the bottom of the stack.
## Queries (`document_width`, `layer_names`, ...) tell the document as it was when the
## script started; what the script itself changes is not seen by them.
##
## How it works: each call prints one line, `@l2d` and the action's name and
## fields separated by tabs, which the editor reads and does. Any other line
## a script prints goes to the script console.
import document

func send(action: str, fields: list[str]):
    var message = "@l2d " + action
    for field in fields:
        message = message + "\t" + field.replace("\\", "\\\\").replace("\t", "\\t").replace("\n", "\\n")
    print(message)

# mark: What the document was =================================================================

## The document's width and height in pixels.
pub func document_width() -> int:
    return document.width()

pub func document_height() -> int:
    return document.height()

## The layers' names, bottom to top.
pub func layer_names() -> list[str]:
    return document.layers()

## The selected layer's place in the stack.
pub func selected_layer() -> int:
    return document.selected()

## The open document's file, or "" when it was never saved.
pub func document_path() -> str:
    return document.path()

# mark: Documents ============================================================================

## A new empty document of `width` by `height` pixels in its own tab.
pub func new_document(width: int, height: int):
    send("new_document", [str(width), str(height)])

## Open the picture or document at `path` in its own tab.
pub func open(path: str):
    send("open", [path])

## Save the document at `path` (an .l2d keeps its layers).
pub func save(path: str):
    send("save", [path])

## Export the flattened picture: PNG or JPEG by the name's extension;
## `quality` 1..100 for JPEG.
pub func export(path: str, quality: int = 90):
    send("export", [path, str(quality)])

## Place a picture file as a new layer, centred.
pub func place(path: str):
    send("place", [path])

## Undo the last step, or redo it.
pub func undo():
    send("undo", [])

pub func redo():
    send("redo", [])

## Any menu command by its id, as the Settings dialog's shortcut list names
## them ("flip_horizontal", "merge_down", "select_object", ...), headless too.
## One that opens a dialog opens it; the parametric calls here are for those.
pub func run(command: str):
    send("run", [command])

# mark: Layers ===============================================================================

## A new empty layer named `name` above the selected one, selected.
pub func add_layer(name: str):
    send("add_layer", [name])

## Select the layer at `index` (0 the bottom).
pub func select_layer(index: int):
    send("select_layer", [str(index)])

## Select the topmost layer called `name`.
pub func select_layer_named(name: str):
    send("select_layer_named", [name])

pub func rename_layer(name: str):
    send("rename_layer", [name])

pub func delete_layer():
    send("delete_layer", [])

pub func duplicate_layer():
    send("duplicate_layer", [])

pub func merge_down():
    send("merge_down", [])

## Move the selected layer `steps` places up the stack (negative: down).
pub func move_layer_up(steps: int):
    send("reorder", [str(steps)])

## The selected layer's opacity, 0..1.
pub func set_opacity(opacity: float):
    send("set_opacity", [str(opacity)])

## The selected layer's blend mode by Photoshop's name ("Multiply", "Screen", ...).
pub func set_blend(mode: str):
    send("set_blend", [mode])

pub func set_visible(visible: bool):
    send("set_visible", [str(visible)])

## Move the selected layer's pixels by (`dx`, `dy`).
pub func move_by(dx: int, dy: int):
    send("move_by", [str(dx), str(dy)])

## A mask on the selected layer revealing the selection (everything without one).
pub func add_mask():
    send("add_mask", [])

# mark: Painting =============================================================================

## The foreground color, and the background's.
pub func set_color(red: float, green: float, blue: float):
    send("set_color", [str(red), str(green), str(blue)])

pub func set_background(red: float, green: float, blue: float):
    send("set_background", [str(red), str(green), str(blue)])

## The brush: its diameter in pixels, hardness and opacity 0..1.
pub func set_brush(size: float, hardness: float = 0.75, opacity: float = 1.0):
    send("set_brush", [str(size), str(hardness), str(opacity)])

## Paint one stroke through `points`, x and y pairs; `erase` erases instead.
pub func stroke(points: list[float], erase: bool = false):
    var fields = [str(erase)]
    for value in points:
        fields.append(str(value))
    send("stroke", fields)

## A straight stroke from (`x0`, `y0`) to (`x1`, `y1`).
pub func line(x0: float, y0: float, x1: float, y1: float):
    stroke([x0, y0, x1, y1])

## Fill the selection (the whole layer without one) with the foreground color.
pub func fill():
    send("fill", [])

## Erase the selection (the whole layer without one).
pub func clear():
    send("clear", [])

## A gradient from the foreground color at (`x0`, `y0`) to the background at
## (`x1`, `y1`); `radial` for a circle about the start.
pub func gradient(x0: float, y0: float, x1: float, y1: float, radial: bool = false):
    send("gradient", [str(x0), str(y0), str(x1), str(y1), str(radial)])

## A text layer of `words` at (`x`, `y`), `size` points, in the foreground color.
pub func text(x: float, y: float, words: str, size: float = 48.0):
    send("text", [str(x), str(y), words, str(size)])

# mark: Selections ===========================================================================

## Select a rectangle or an ellipse; `mode` 0 new, 1 add, 2 subtract, 3 intersect.
pub func select_rectangle(x: int, y: int, width: int, height: int, mode: int = 0):
    send("select_rectangle", [str(x), str(y), str(width), str(height), str(mode)])

pub func select_ellipse(x: int, y: int, width: int, height: int, mode: int = 0):
    send("select_ellipse", [str(x), str(y), str(width), str(height), str(mode)])

pub func select_all():
    send("select_all", [])

pub func deselect():
    send("deselect", [])

pub func invert_selection():
    send("invert_selection", [])

## What stands out in the selected layer.
pub func select_subject():
    send("select_subject", [])

# mark: Adjustments and filters ==============================================================

## Adjust the selected layer's pixels once by adjustment `name` ("Levels",
## "Hue / Saturation", "Exposure", "Vignette", ...) with its settings in the
## units its dialog shows, in its dialog's order; fewer keep the defaults.
pub func adjust(name: str, settings: list[float]? = none):
    var fields = [name]
    for value in settings else []:
        fields.append(str(value))
    send("adjust", fields)

## The same adjustment as a live adjustment layer above the selected layer.
pub func add_adjustment_layer(name: str, settings: list[float]? = none):
    var fields = [name]
    for value in settings else []:
        fields.append(str(value))
    send("adjustment_layer", fields)

## Filter `name` ("Gaussian Blur", "Motion Blur", "Lens Correction", "Bloom",
## "Tonal Contrast", "Add Noise") with its settings as its dialog shows them.
pub func filter(name: str, settings: list[float]? = none):
    var fields = [name]
    for value in settings else []:
        fields.append(str(value))
    send("filter", fields)

## Fill the selection with what is around it.
pub func content_aware_fill():
    send("content_aware_fill", [])

## Hide everything but the selected layer's subject behind a new mask.
pub func remove_background():
    send("remove_background", [])

# mark: The canvas ===========================================================================

## Scale the whole document to `width` by `height` pixels.
pub func resize_image(width: int, height: int):
    send("resize_image", [str(width), str(height)])

## Change the canvas to `width` by `height`, the picture kept at the top-left
## moved by (`x`, `y`).
pub func resize_canvas(width: int, height: int, x: int = 0, y: int = 0):
    send("resize_canvas", [str(width), str(height), str(x), str(y)])

## Crop to the rectangle.
pub func crop(x: int, y: int, width: int, height: int):
    send("crop", [str(x), str(y), str(width), str(height)])

pub func flip_canvas(horizontal: bool = true):
    send("flip_canvas", [str(horizontal)])
