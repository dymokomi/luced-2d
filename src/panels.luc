## The window's contents, after Compositor's: the menu bar, a contextual tool
## header, the dock (the viewport with its tool rail and rulers, Layers and
## Properties, and whatever else the "+" or the Window menu opened —
## panel_catalog.luc) and a status line; the dialogs
## float above. Each part lives in its own module; this one composes them,
## wires every shared command to what the window does for it, and refreshes
## them all when the document changes.
from ui import Font, Text, VStack, HStack, Toolbar, Size, Spacer, Widget, DStack, Panel, Rule, Dialog, ContextMenu, NumberField
from input import Key
from workspace import Workspace
from actions import Actions
from view import CanvasView
from layers import LayerList
from tabs import DocumentTabs
from rulers import Ruler, RulerCorner
from document_panel import DocumentSettings
from palette import Palette
from color_picker import ColorPicker
from settings import Store
from settings_panel import SettingsDialog
from kit import Kit
from tool_header import ToolHeader
from brush_settings import BrushSettings
from adjust_dialog import AdjustDialog
from style_dialog import StyleDialog
from adjustments import adjustments, applies_at_once, gradient_map, curves_adjustment
from properties import Properties
from prompts import Prompts
from document_files import DocumentFiles
from crash_dialog import CrashDialog
from menus import menu_bar
from layers_panel import LayersPanel
from size_dialogs import SizeDialogs
from color_range_dialog import ColorRangeDialog
from replace_color_dialog import ReplaceColorDialog
from select_mask_dialog import SelectMaskDialog
from channel_dialogs import SaveSelectionDialog, LoadSelectionDialog
from text_editing import TextEditing
from script_editor import ScriptEditor
from tool_rail import ToolRail
from layer_transfer import copy_layers, paste_layers, layers_to_paste, send_layers
from panel_catalog import PanelCatalog
from panel_list import panel_entries
from dock_layout import DockLayout
from align import align_modes, align_layers
from canvas import Canvas
import math
from units import unit_ids
from transform_box import mode_skew, mode_distort, mode_perspective

pub class Panels:
    pub let body: VStack
    ## Frames until the canvas takes the keys back (0: nothing pending). Docking
    ## focuses the panels it adds, after this frame, so the canvas asks later.
    var focus_canvas_in: int = 0
    pub let view: CanvasView
    ## The open documents' tabs across the top of the viewport.
    pub let tabs: DocumentTabs
    ## Rulers above and left of the canvas; the row above holds the corner too.
    pub let top_ruler: Ruler
    pub let left_ruler: Ruler
    let ruler_row: HStack
    let left_ruler_menu: ContextMenu
    pub let workspace: Workspace
    pub let actions: Actions
    pub let status: Text
    ## The zoom as a number to type, in the status bar's corner.
    let zoom_field: NumberField
    pub let header: ToolHeader
    pub let brush: BrushSettings
    pub let adjust: AdjustDialog
    pub let style: StyleDialog
    ## File › Script Editor…
    pub let scripts: ScriptEditor
    pub let properties: Properties
    pub let prompts: Prompts
    pub let crash: CrashDialog
    pub let layers: LayerList
    ## The dock and its panes, each pane's buttons on a shelf at its bottom.
    pub let dock: DStack
    pub let viewport_panel: Panel
    pub let layers_panel: LayersPanel
    ## Every panel the "+" and the Window menu open (panel_catalog.luc).
    pub let catalog: PanelCatalog
    ## The arrangement kept across runs (dock_layout.luc).
    pub let dock_layout: DockLayout
    ## The tool rail: its buttons, groups and flyouts (tool_rail.luc).
    pub let rail: ToolRail
    ## The palette below the tool rail and the picker its swatches open, as Compositor's.
    pub let palette: Palette
    pub let picker: ColorPicker
    ## On a mask the palette offers only black (hide) and white (reveal), as Compositor's does.
    pub let mask_prompt: Dialog
    ## The workspace revision the panels last showed.
    var shown_revision: int = -1
    var mask_background: bool = false
    pub let document_settings: DocumentSettings
    pub let size_dialogs: SizeDialogs
    pub let color_range: ColorRangeDialog
    pub let replace_color: ReplaceColorDialog
    pub let select_mask: SelectMaskDialog
    pub let save_selection: SaveSelectionDialog
    pub let load_selection: LoadSelectionDialog
    pub let text_editing: TextEditing
    pub let settings_dialog: SettingsDialog
    pub let files: DocumentFiles
    let kit: Kit

    pub func init(self, workspace: Workspace, actions: Actions, font: Font, store: Store? = none) -> unit!:
        self.workspace = workspace
        self.actions = actions
        self.kit = Kit(font)
        let kit = self.kit
        self.settings_dialog = SettingsDialog(workspace, actions, font, store else Store())
        self.settings_dialog.applied = self.refresh
        self.prompts = Prompts(workspace, font)
        self.prompts.refreshed = self.refresh
        kit.keep(self.prompts.prompt.on_submit(self.prompts.apply))
        self.files = DocumentFiles(workspace, self.prompts, kit)
        self.files.refreshed = self.refresh
        self.view = CanvasView(workspace, font)
        self.view.on_open_files = self.files.open_files
        self.view.on_key_up = self.spring_back
        self.view.on_changed = self.refresh
        self.view.on_text = self.place_text
        self.view.on_edit_text = self.edit_text
        self.view.on_refused = self.prompts.tell
        self.tabs = DocumentTabs(workspace, font)
        self.tabs.on_switch = self.switch_document
        self.tabs.on_close = self.files.close_document_at
        self.layers_panel = LayersPanel(workspace, actions, kit)
        self.layers = self.layers_panel.layer_list
        self.layers.on_drop_outside = self.layers_dropped
        self.layers_panel.refreshed = self.refresh
        self.layers_panel.failed = self.prompts.tell
        self.status = Text("", font = font)
        self.zoom_field = NumberField(100.0, 1.0, 6400.0, 1.0, suffix = "%", font = font, cells = 7.0)
        kit.keep(self.zoom_field.on_change(self.type_zoom))
        self.header = ToolHeader(workspace, kit)
        self.header.brush_settings = self.open_brush
        self.header.refreshed = self.refresh
        self.header.finished = self.finish_box
        self.brush = BrushSettings(workspace, kit)
        self.adjust = AdjustDialog(workspace, kit)
        self.adjust.changed = self.document_changed
        self.adjust.refreshed = self.refresh
        self.adjust.failed = self.prompts.tell
        self.style = StyleDialog(workspace, kit)
        self.style.changed = self.document_changed
        self.style.refreshed = self.refresh
        self.style.pick_color = func (title: str, hex: str, changed: func(str) -> unit!) -> unit!:
            self.picker.open_for(title, hex, changed)
        self.layers_panel.open_style = self.style.open
        self.scripts = ScriptEditor(workspace, actions, kit)
        self.scripts.changed = self.refresh
        self.properties = Properties(workspace, kit, actions.blends, self.toggle_visibility, self.toggle_clipped, self.toggle_mask, self.style.open)
        # Both places that show a Gradient Map pick its colors with the picker.
        self.adjust.controls.map_colors.pick_color = self.pick_any_color
        self.properties.adjustment.map_colors.pick_color = self.pick_any_color
        self.properties.changed = self.document_changed
        self.properties.refreshed = self.refresh
        self.crash = CrashDialog(kit)
        self.palette = Palette(workspace)
        self.palette.on_pick = self.pick_color
        self.picker = ColorPicker(workspace, font)
        self.picker.closed = self.refresh
        self.picker.committed = self.settings_dialog.remember
        kit.dialog_keys(self.picker.dialog, self.cancel_picker, self.accept_picker)
        self.mask_prompt = Dialog([Text("Mask color", font = font), HStack([kit.button("Black · Hide", self.choose_mask_black),
                                   kit.button("White · Reveal", self.choose_mask_white), Spacer()], spacing = 8.0)], width = 300.0)
        kit.dialog_keys(self.mask_prompt, self.hide_mask_prompt, self.keep_mask_prompt)
        self.document_settings = DocumentSettings(workspace, font)
        self.document_settings.applied = self.refresh
        kit.dialog_keys(self.document_settings.dialog, self.document_settings.cancel, self.document_settings.apply)
        kit.dialog_keys(self.settings_dialog.dialog, self.settings_dialog.cancel, self.settings_dialog.save)
        self.text_editing = TextEditing(workspace, kit, actions.commit_text)
        self.text_editing.changed = self.refresh
        self.text_editing.failed = self.prompts.tell
        self.header.type_controls.changed = self.text_editing.restyle
        kit.bind(actions.commit_text, self.text_editing.commit)
        self.size_dialogs = SizeDialogs(workspace, actions, kit)
        self.size_dialogs.report(self.refresh, self.prompts.tell)
        self.tabs.on_new = self.size_dialogs.new_canvas.open
        self.color_range = ColorRangeDialog(workspace, kit)
        self.color_range.applied = self.refresh
        self.color_range.failed = self.prompts.tell
        kit.bind(actions.color_range, self.color_range.open)
        self.replace_color = ReplaceColorDialog(workspace, kit)
        self.replace_color.applied = self.refresh
        self.replace_color.failed = self.prompts.tell
        kit.bind(actions.replace_color, self.replace_color.open)
        self.select_mask = SelectMaskDialog(workspace, kit)
        self.select_mask.applied = self.refresh
        self.select_mask.failed = self.prompts.tell
        kit.bind(actions.select_mask, self.select_mask.open)
        self.save_selection = SaveSelectionDialog(workspace, kit)
        self.save_selection.applied = self.refresh
        self.save_selection.failed = self.prompts.tell
        kit.bind(actions.save_selection, self.save_selection.open)
        self.load_selection = LoadSelectionDialog(workspace, kit)
        self.load_selection.applied = self.refresh
        self.load_selection.failed = self.prompts.tell
        kit.bind(actions.load_selection, self.load_selection.open)
        self.connect()
        # The tool rail, as eleusis's viewport rail: 32-point buttons, the active
        # tool selected, and the palette below them.
        self.rail = ToolRail(actions, kit)
        var rail_items: list[Widget] = self.rail.items
        rail_items.append(Rule())
        rail_items.append(self.palette)
        # Quick Mask's button under the swatches, as Photoshop's.
        rail_items.append(self.rail.quick)
        let rail = VStack(rail_items, spacing = 3.0, padding = 6.0)
        rail.layout().set_limits(Size(44.0, 100.0), Size(44.0, 16384.0))
        rail.layout().set_flex(horizontal = 0.0)
        # The viewport: the tool rail beside the canvas, a one-point backdrop rule
        # between them as eleusis's viewport has, and rulers around the canvas;
        # right-click either ruler for its units.
        self.top_ruler = Ruler(workspace, self.view, font, true)
        self.left_ruler = Ruler(workspace, self.view, font, false)
        self.ruler_row = HStack([RulerCorner(), ContextMenu(self.top_ruler, actions.units, font = font)], spacing = 0.0)
        self.left_ruler_menu = ContextMenu(self.left_ruler, actions.units, font = font)
        self.view.linked = [self.top_ruler.layout(), self.left_ruler.layout()]
        let view_row = HStack([self.left_ruler_menu, self.view], spacing = 0.0)
        view_row.layout().set_flex()
        let canvas_area = VStack([self.ruler_row, view_row], spacing = 0.0)
        canvas_area.layout().set_flex()
        let canvas_row = HStack([rail, Rule(structural = true, vertical = true), canvas_area], spacing = 0.0)
        canvas_row.layout().set_flex()
        let viewport = VStack([self.tabs, canvas_row], spacing = 0.0)
        viewport.layout().set_flex()
        self.viewport_panel = Panel("Viewport", viewport, minimum = Size(320.0, 200.0), closable = false, id = "viewport")
        self.dock = DStack([self.viewport_panel], font = font)
        self.dock.layout().set_flex()
        self.catalog = PanelCatalog(self.dock, self.viewport_panel, workspace, kit, self.view, self.settings_dialog, self.layers_panel, self.properties, self.brush)
        self.catalog.refreshed = self.refresh
        self.catalog.failed = self.prompts.tell
        self.catalog.open_picker = self.pick_color
        self.catalog.brush_chosen = func () -> unit!:
            self.choose_tool("brush")
        self.catalog.align_commands = actions.aligns
        # The panels as they always start; the app brings back the kept arrangement.
        self.dock_layout = DockLayout(self.dock, self.catalog, self.viewport_panel)
        self.dock_layout.arrange_default()
        kit.bind(actions.reset_layout, func () -> unit!:
            self.dock_layout.reset()
            # Re-docking panels focuses the last one added; the keys belong to the canvas.
            self.focus_canvas_in = 2
            self.refresh())
        var align_index = 0
        for each in align_modes():
            let chosen = each
            kit.bind(actions.aligns[align_index], func () -> unit!:
                discard(align_layers(self.workspace, chosen))
                self.refresh())
            align_index += 1
        var window_index = 0
        for entry in panel_entries():
            let id = entry.id
            kit.bind(actions.windows[window_index], func () -> unit!:
                self.catalog.toggle(id)
                self.refresh())
            window_index += 1
        # The status bar is where a control's hint shows, as in eleusis: no tooltips.
        self.body = VStack([menu_bar(actions, font), self.header.bar, self.dock, Toolbar([self.zoom_field, self.status, Spacer(), self.header.hint], font = font),
                            self.prompts.prompt, self.mask_prompt, self.adjust.dialog, self.style.dialog, self.scripts.dialog, self.settings_dialog.dialog,
                            self.document_settings.dialog, self.crash.dialog, self.files.confirm, self.files.export_dialog.dialog, self.text_editing.dialog,
                            self.picker.dialog, self.color_range.dialog, self.replace_color.dialog, self.select_mask.dialog, self.save_selection.dialog, self.load_selection.dialog] + self.size_dialogs.dialogs(), spacing = 0.0)
        self.body.layout().set_flex()
        self.refresh()

    ## Wire every shared command to what this window does for it.
    func connect(self) -> unit!:
        let actions = self.actions
        let kit = self.kit
        kit.bind(actions.open_document, self.files.open_document)
        kit.bind(actions.import_image, self.files.import_image)
        kit.bind(actions.save, self.files.save)
        kit.bind(actions.save_as, self.files.save_as)
        kit.bind(actions.export_png, self.files.export_png)
        kit.bind(actions.export_jpeg, self.files.export_jpeg)
        kit.bind(actions.close_document, self.files.close_document)
        kit.bind(actions.exit_app, self.files.quit)
        kit.bind(actions.next_document, func () -> unit!:
            self.workspace.next_document(1)
            self.refresh())
        kit.bind(actions.previous_document, func () -> unit!:
            self.workspace.next_document(-1)
            self.refresh())
        kit.bind(actions.document_settings, func () -> unit!:
            if kit.may_open(self.document_settings.dialog):
                self.document_settings.open())
        kit.bind(actions.settings, func () -> unit!:
            if kit.may_open(self.settings_dialog.dialog):
                self.settings_dialog.open())
        kit.bind(actions.undo, func () -> unit!:
            # During a free transform or a live gradient, undo drops it, as nothing is kept yet.
            if self.workspace.transform != none:
                self.workspace.finish_transform(false)
            elif self.workspace.mesh_warp != none:
                self.workspace.finish_mesh_warp(false)
            elif self.workspace.gradient != none:
                self.workspace.finish_gradient(false)
            else:
                self.workspace.undo()
            self.refresh())
        kit.bind(actions.redo, self.then_refresh(self.workspace.redo))
        kit.bind(actions.fill, func () -> unit!:
            self.workspace.fill_selection(false)
            self.refresh())
        kit.bind(actions.fill_background, func () -> unit!:
            self.workspace.fill_selection(false, true)
            self.refresh())
        kit.bind(actions.redo_y, func () -> unit!:
            actions.redo.trigger())
        kit.bind(actions.fill_delete, func () -> unit!:
            actions.fill.trigger())
        kit.bind(actions.fill_background_delete, func () -> unit!:
            actions.fill_background.trigger())
        kit.bind(actions.clear, func () -> unit!:
            # Its key (Backspace) takes a Polygonal Lasso corner back while one is drawn.
            if self.view.polygon.active:
                self.view.polygon.take_back()
            else:
                self.workspace.fill_selection(true)
            self.refresh())
        kit.bind(actions.swap_colors, self.then_refresh(self.workspace.swap_colors))
        kit.bind(actions.reset_colors, self.then_refresh(self.workspace.reset_colors))
        kit.bind(actions.select_all, self.then_refresh(self.workspace.select_all))
        kit.bind(actions.deselect, self.then_refresh(self.workspace.deselect))
        kit.bind(actions.inverse, self.then_refresh(self.workspace.invert_selection))
        kit.bind(actions.expand, func () -> unit!:
            self.prompts.ask("expand", "Expand the selection by, in pixels (1..512)", "4", "Expand"))
        kit.bind(actions.contract, func () -> unit!:
            self.prompts.ask("contract", "Contract the selection by, in pixels (1..512)", "4", "Contract"))
        kit.bind(actions.feather, func () -> unit!:
            self.prompts.ask("feather", "Feather the selection's edge by, in pixels (1..512)", "4", "Feather"))
        kit.bind(actions.border, func () -> unit!:
            self.prompts.ask("border", "Border of the selection, width in pixels (1..200)", "10", "Border"))
        kit.bind(actions.smooth, func () -> unit!:
            self.prompts.ask("smooth", "Smooth the selection over, in pixels (1..100)", "2", "Smooth"))
        kit.bind(actions.grow, self.then_refresh(func () -> unit!:
            self.workspace.grow_selection(true)))
        kit.bind(actions.similar, self.then_refresh(func () -> unit!:
            self.workspace.grow_selection(false)))
        kit.bind(actions.transform_selection, self.transform_selection)
        kit.bind(actions.quick_mask, self.then_refresh(self.workspace.toggle_quick_mask))
        kit.bind(actions.crop, self.crop)
        kit.bind(actions.reveal_all, func () -> unit!:
            if not self.workspace.reveal_all():
                self.status.set_text("Nothing lies past the canvas")
            self.refresh())
        kit.bind(actions.blur, self.adjust.blur)
        kit.bind(actions.script_editor, self.scripts.open)
        var filter = 0
        for command in actions.filters:
            let chosen = filter
            kit.bind(command, func () -> unit!:
                self.adjust.filter(chosen))
            filter += 1
        kit.bind(actions.free_transform, self.free_transform)
        kit.bind(actions.transform_skew, func () -> unit!:
            self.transform_mode(mode_skew))
        kit.bind(actions.transform_distort, func () -> unit!:
            self.transform_mode(mode_distort))
        kit.bind(actions.transform_perspective, func () -> unit!:
            self.transform_mode(mode_perspective))
        kit.bind(actions.transform_warp, func () -> unit!:
            self.mesh_warp(false))
        kit.bind(actions.puppet_warp, func () -> unit!:
            self.mesh_warp(true))
        kit.bind(actions.flip_horizontal, self.then_refresh(func () -> unit!:
            self.workspace.flip_layer(true)))
        kit.bind(actions.flip_vertical, self.then_refresh(func () -> unit!:
            self.workspace.flip_layer(false)))
        kit.bind(actions.flip_canvas_horizontal, self.then_refresh(func () -> unit!:
            self.workspace.flip_canvas(true)))
        kit.bind(actions.flip_canvas_vertical, self.then_refresh(func () -> unit!:
            self.workspace.flip_canvas(false)))
        kit.bind(actions.layer_style, self.style.open)
        kit.bind(actions.add_noise, self.adjust.add_noise)
        var layer_kinds: list[int] = []
        for adjustment in adjustments():
            if adjustment.layerable:
                layer_kinds.append(adjustment.kind)
        var at = 0
        for command in actions.adjustment_layers:
            let kind = layer_kinds[at]
            at += 1
            kit.bind(command, self.attempting("Adjustment Layer", func () -> unit!:
                self.new_adjustment_layer(kind)))
        kit.bind(actions.cut, func () -> unit!:
            self.attempt("Cut", func () -> unit!:
                self.copy_or_cut(true)))
        kit.bind(actions.copy, func () -> unit!:
            self.attempt("Copy", func () -> unit!:
                self.copy_or_cut(false)))
        kit.bind(actions.copy_merged, func () -> unit!:
            self.attempt("Copy Merged", func () -> unit!:
                self.workspace.copy_selection(true, false)))
        kit.bind(actions.paste_in_place, func () -> unit!:
            self.attempt("Paste in Place", func () -> unit!:
                if layers_to_paste():
                    paste_layers(self.workspace, true)
                else:
                    self.workspace.paste_in_place()
                self.refresh()))
        kit.bind(actions.paste, func () -> unit!:
            self.attempt("Paste", func () -> unit!:
                if layers_to_paste():
                    paste_layers(self.workspace, false)
                    self.refresh()
                    return
                # Paste lands in the middle of the view, as Photoshop's does.
                let bounds = self.view.layout().bounds()
                let x = (bounds.width * 0.5 - self.workspace.offset_x) / self.workspace.zoom
                let y = (bounds.height * 0.5 - self.workspace.offset_y) / self.workspace.zoom
                self.workspace.paste(x, y)))
        kit.bind(actions.layer_via_copy, func () -> unit!:
            self.attempt("Layer via Copy", func () -> unit!:
                self.workspace.layer_via_copy(false)))
        kit.bind(actions.layer_via_cut, func () -> unit!:
            self.attempt("Layer via Cut", func () -> unit!:
                self.workspace.layer_via_copy(true)))
        kit.bind(actions.layer_up, func () -> unit!:
            self.workspace.reorder(1)
            self.refresh())
        kit.bind(actions.layer_down, func () -> unit!:
            self.workspace.reorder(-1)
            self.refresh())
        kit.bind(actions.toggle_mask, self.toggle_mask)
        kit.bind(actions.hide_all_mask, self.attempting("Add Mask", func () -> unit!:
            self.workspace.toggle_mask(true)))
        kit.bind(actions.toggle_mask_enabled, self.attempting("Mask", self.workspace.toggle_mask_enabled))
        kit.bind(actions.toggle_mask_link, self.attempting("Mask", self.workspace.toggle_mask_link))
        kit.bind(actions.copy_mask, self.attempting("Copy Mask", self.workspace.copy_mask))
        kit.bind(actions.toggle_preview, self.adjust.toggle_preview)
        kit.bind(actions.paste_mask, self.attempting("Paste Mask", self.workspace.paste_mask))
        kit.bind(actions.load_transparency, self.attempting("Load Transparency", self.workspace.load_transparency))
        kit.bind(actions.toggle_mask_editing, self.then_refresh(self.workspace.toggle_mask_editing))
        kit.bind(actions.toggle_visibility, self.toggle_visibility)
        kit.bind(actions.show_guides, func () -> unit!:
            self.workspace.show_guides = not self.workspace.show_guides
            self.view_changed())
        kit.bind(actions.snap, func () -> unit!:
            self.workspace.snap = not self.workspace.snap
            self.view_changed())
        kit.bind(actions.lock_guides, func () -> unit!:
            self.workspace.lock_guides = not self.workspace.lock_guides
            self.view_changed())
        kit.bind(actions.clear_guides, self.attempting("Clear Guides", func () -> unit!:
            self.workspace.canvas.clear_guides()
            self.workspace.touch()))
        kit.bind(actions.show_transform_controls, func () -> unit!:
            self.workspace.show_transform_controls = not self.workspace.show_transform_controls
            self.workspace.touch()
            self.refresh())
        kit.bind(actions.show_rulers, func () -> unit!:
            self.workspace.show_rulers = not self.workspace.show_rulers
            self.view_changed())
        kit.bind(actions.show_grid, func () -> unit!:
            self.workspace.show_grid = not self.workspace.show_grid
            self.view_changed())
        var unit_index = 0
        for unit_name in unit_ids():
            let chosen = unit_name
            kit.bind(actions.units[unit_index], func () -> unit!:
                self.workspace.units = chosen
                self.view_changed())
            unit_index += 1
        kit.bind(actions.fit, func () -> unit!:
            self.workspace.fitted = false
            self.refresh())
        kit.bind(actions.actual_size, func () -> unit!:
            let bounds = self.view.layout().bounds()
            self.workspace.actual_size(bounds.width, bounds.height)
            self.refresh())
        kit.bind(actions.zoom_in, func () -> unit!:
            self.zoom_by(1))
        kit.bind(actions.zoom_out, func () -> unit!:
            self.zoom_by(-1))
        kit.bind(actions.bigger, func () -> unit!:
            self.workspace.scale_brush(1.25)
            self.refresh())
        kit.bind(actions.smaller, func () -> unit!:
            self.workspace.scale_brush(0.8)
            self.refresh())
        kit.bind(actions.harder, func () -> unit!:
            self.workspace.harden_brush(0.25)
            self.refresh())
        kit.bind(actions.softer, func () -> unit!:
            self.workspace.harden_brush(-0.25)
            self.refresh())
        kit.bind(actions.next_blend, func () -> unit!:
            self.workspace.cycle_blend(1)
            self.refresh())
        kit.bind(actions.previous_blend, func () -> unit!:
            self.workspace.cycle_blend(-1)
            self.refresh())
        var kind = 0
        for command in actions.adjustments:
            let selected = kind
            kit.bind(command, func () -> unit!:
                self.adjust_kind(selected))
            kind += 1
        var mode = 0
        for command in actions.blends:
            let chosen = mode
            kit.bind(command, func () -> unit!:
                self.set_blend(chosen))
            mode += 1
        for command in actions.tools:
            let tool = command.id()
            kit.bind(command, func () -> unit!:
                self.choose_tool(next_in_cycle(tool, self.workspace.tool)))

    ## `change` to the workspace, then refresh the window.
    func then_refresh(self, change: func() -> unit!) -> func() -> unit!:
        return func () -> unit!:
            change()
            self.refresh()

    # -- Tools and colors.

    ## A key let go over the canvas: if it is the current tool's key and the
    ## tool was used while it was held, return to the tool before, as
    ## Photoshop's spring-loaded tools do. A tap keeps the new tool.
    pub func spring_back(self, key: Key) -> unit!:
        let workspace = self.workspace
        if not workspace.tool_used or workspace.tool_before == workspace.tool:
            return
        for command in self.actions.tools:
            if command.id() == workspace.tool and command.shortcut().key == key:
                self.choose_tool(workspace.tool_before)
                return

    pub func choose_tool(self, tool: str) -> unit!:
        self.workspace.choose_tool(tool)
        self.refresh()

    ## Brush…: Brush Settings, floating the first time.
    pub func open_brush(self) -> unit!:
        self.brush.open(self.dock)

    ## A palette swatch clicked: the picker opens for that color — or, on a
    ## mask, the black/white choice.
    pub func pick_color(self, background: bool) -> unit!:
        self.mask_background = background
        if self.workspace.canvas.editing_mask():
            if self.kit.may_open(self.mask_prompt):
                self.mask_prompt.open()
            return
        if not self.kit.may_open(self.picker.dialog):
            return
        self.picker.open(background)
        self.refresh()

    ## The picker on any color: its title, the "#rrggbb" it starts from, where changes go.
    func pick_any_color(self, title: str, hex: str, changed: func(str) -> unit!) -> unit!:
        if self.kit.may_open(self.picker.dialog) or self.adjust.dialog.is_open():
            self.picker.open_for(title, hex, changed)

    func cancel_picker(self) -> unit!:
        self.picker.finish(false)

    func accept_picker(self) -> unit!:
        self.picker.finish(true)

    func hide_mask_prompt(self) -> unit!:
        self.mask_prompt.hide()

    ## The mask prompt has no default choice: Enter leaves it open.
    func keep_mask_prompt(self) -> unit!:
        return

    func choose_mask_black(self) -> unit!:
        self.choose_mask_color(0.0)

    func choose_mask_white(self) -> unit!:
        self.choose_mask_color(1.0)

    func choose_mask_color(self, value: float) -> unit!:
        self.workspace.set_palette(value, value, value, self.mask_background)
        self.mask_prompt.hide()
        self.refresh()

    ## The Text tool clicked or dragged a new text layer into place; not while
    ## another dialog is open, as the editor is one.
    func place_text(self, x: float, y: float, box_width: float) -> unit!:
        if not self.kit.may_open(self.text_editing.dialog):
            return
        self.attempt("Text", func () -> unit!:
            self.text_editing.begin_new(x, y, box_width))

    func edit_text(self, index: int) -> unit!:
        if not self.kit.may_open(self.text_editing.dialog):
            return
        self.attempt("Text", func () -> unit!:
            self.text_editing.begin_existing(index))

    ## Open the adjustment's sliders with a live preview, or apply the ones
    ## that take no parameters (invert, desaturate) at once.
    pub func adjust_kind(self, kind: int) -> unit!:
        if applies_at_once(kind):
            self.attempt("Adjust", func () -> unit!:
                self.workspace.adjust(kind, []))
            return
        self.adjust.open(kind)

    ## A new adjustment layer of `kind` at its defaults, above the selected
    ## layer and selected: its settings show in Properties.
    func new_adjustment_layer(self, kind: int) -> unit!:
        let spec = adjustments()[kind]
        var numbers = spec.engine(spec.defaults())
        if kind == gradient_map:
            numbers = numbers + self.workspace.colors_encoded()
        # A new Curves layer starts straight, whatever a dialog last staged.
        if kind == curves_adjustment:
            var channel = 0
            while channel < 4:
                self.workspace.canvas.reset_curve(channel)
                channel += 1
        discard(self.workspace.add_adjustment_layer(kind, spec.name, numbers))

    ## Edit › Free Transform: the box goes up around the layer's pixels on the canvas.
    pub func free_transform(self) -> unit!:
        let started = self.workspace.begin_transform() catch failure:
            self.prompts.tell(f"Cannot transform: {failure.message}")
            return
        if not started:
            self.prompts.tell("Nothing to transform: the layer has no pixels")
        # Enter and Esc go to the canvas.
        self.view.layout().request_focus()
        self.refresh()

    ## Edit › Transform › Skew, Distort or Perspective: the free-transform box
    ## (up already, or put up now) with its handles in that mode.
    func transform_mode(self, mode: int) -> unit!:
        let started = self.workspace.begin_transform_mode(mode) catch failure:
            self.prompts.tell(f"Cannot transform: {failure.message}")
            return
        if not started:
            self.prompts.tell("Nothing to transform: the layer has no pixels")
        self.view.layout().request_focus()
        self.refresh()

    ## Edit › Transform › Warp or Edit › Puppet Warp on the selected layer.
    func mesh_warp(self, puppet: bool) -> unit!:
        let name = "Puppet Warp" if puppet else "Warp"
        let started = self.workspace.begin_mesh_warp(puppet) catch failure:
            self.prompts.tell(f"Cannot {name.lower()}: {failure.message}")
            return
        if not started:
            self.prompts.tell(f"Cannot {name.lower()} while something else is under way")
        self.view.layout().request_focus()
        self.refresh()

    ## Select › Transform Selection: the box goes up around the selection, moving its outline.
    pub func transform_selection(self) -> unit!:
        let started = self.workspace.begin_selection_transform() catch failure:
            self.prompts.tell(f"Cannot transform the selection: {failure.message}")
            return
        if not started:
            self.prompts.tell("Nothing selected to transform")
        self.view.layout().request_focus()
        self.refresh()

    ## The header's Apply or Cancel: the free transform, or the Crop tool's box.
    pub func finish_box(self, keep: bool) -> unit!:
        if self.workspace.gradient != none:
            self.workspace.finish_gradient(keep)
        elif self.workspace.transform != none:
            self.workspace.finish_transform(keep)
        elif self.workspace.mesh_warp != none:
            self.workspace.finish_mesh_warp(keep)
        else:
            self.workspace.finish_crop(keep)
        self.refresh()

    pub func crop(self) -> unit!:
        self.workspace.crop() catch failure:
            self.prompts.tell(f"Cannot crop: {failure.message}")
            return
        self.refresh()

    ## Run a command's `step`; a failure (nothing selected, no image on the
    ## clipboard, a group where pixels are needed) is said in the prompt under
    ## `name`. The window refreshes after it.
    func attempt(self, name: str, step: func() -> unit!) -> unit!:
        step() catch failure:
            self.prompts.tell(f"{name}: {failure.message}")
            return
        self.refresh()

    ## `attempt` as a command's action.
    func attempting(self, name: str, step: func() -> unit!) -> func() -> unit!:
        return func () -> unit!:
            self.attempt(name, step)

    # -- Layers.

    pub func select_layer(self, index: int) -> unit!:
        self.workspace.select(index)
        self.refresh()

    pub func toggle_visibility(self) -> unit!:
        self.workspace.toggle_visibility()
        self.refresh()

    pub func toggle_mask(self) -> unit!:
        self.attempt("Mask", func () -> unit!:
            self.workspace.toggle_mask())

    pub func toggle_clipped(self) -> unit!:
        self.workspace.toggle_clipped()
        self.refresh()

    pub func set_blend(self, mode: int) -> unit!:
        self.workspace.set_blend(mode)
        self.refresh()

    # -- Documents.

    pub func switch_document(self, index: int) -> unit!:
        self.workspace.switch_document(index)
        self.refresh()

    ## Copy (Cut with `cut`): the selected pixels, or with none selected the
    ## selected layers whole.
    func copy_or_cut(self, cut: bool) -> unit!:
        if self.workspace.canvas.has_selection():
            Canvas.forget_copied_layers()
            self.workspace.copy_selection(false, cut)
        else:
            copy_layers(self.workspace, cut)
        self.refresh()

    ## Layers dragged from the Layers panel and let go at window point
    ## (`x`, `y`): onto another document's tab, they go there.
    func layers_dropped(self, x: float, y: float) -> unit!:
        let index = self.tabs.tab_at(x, y)
        if index >= 0 and index != self.workspace.current:
            send_layers(self.workspace, index)
            self.refresh()

    ## Show a crash report the last run left.
    pub func show_crash(self, report: str) -> unit!:
        self.crash.show(report)

    # -- Showing the state.

    ## A view aid changed: keep it and redraw.
    func view_changed(self) -> unit!:
        self.settings_dialog.remember_view()
        self.refresh()

    ## A zoom typed in the status bar, in percent, about the view's middle.
    func type_zoom(self, percent: float) -> unit!:
        let bounds = self.view.layout().bounds()
        self.workspace.zoom_about(percent / 100.0 / self.workspace.zoom, bounds.width * 0.5, bounds.height * 0.5)
        self.refresh()

    ## Zoom In or Out: the next step, about the view's middle.
    func zoom_by(self, direction: int) -> unit!:
        let bounds = self.view.layout().bounds()
        self.workspace.zoom_step(direction, bounds.width * 0.5, bounds.height * 0.5)
        self.refresh()

    ## The document's pixels changed without a structural change: redraw the
    ## canvas and the layer thumbnails.
    func document_changed(self) -> unit!:
        self.view.layout().invalidate()
        self.layers.layout().invalidate()

    ## Once a frame: when the document changed since the panels last showed it
    ## (a stroke let go, a key's edit), show it — not mid-stroke, when every
    ## frame changes it. Menus and shortcuts then offer what is possible now.
    pub func refresh_if_changed(self) -> unit!:
        if self.workspace.revision == self.shown_revision or self.workspace.canvas.painting():
            return
        self.refresh()

    pub func refresh(self) -> unit!:
        let workspace = self.workspace
        self.shown_revision = workspace.revision
        self.header.show(self.picker.is_open())
        self.palette.layout().invalidate()
        self.picker.sync()
        if self.dock.contains(self.brush.panel):
            self.brush.show()
        self.properties.show()
        self.catalog.show_made()
        var window_index = 0
        for entry in panel_entries():
            self.actions.windows[window_index].set_checked(self.catalog.is_open(entry.id))
            window_index += 1
        let name = workspace.path if workspace.path != "" else "Untitled"
        let percent = int(workspace.zoom * 100.0 + 0.5)
        let dpi = int(math.floor(workspace.canvas.resolution() + 0.5))
        self.zoom_field.set_value(float(percent))
        self.status.set_text(f"{workspace.width()} × {workspace.height()} px  |  {dpi} px/in  |  {workspace.canvas.profile()}  |  {name}")
        self.layers_panel.show()
        self.rail.show(workspace)
        self.actions.update(workspace)
        # The view aids, with their state in the View menu.
        self.ruler_row.layout().set_visible(workspace.show_rulers)
        self.left_ruler_menu.layout().set_visible(workspace.show_rulers)
        self.top_ruler.layout().invalidate()
        self.left_ruler.layout().invalidate()
        self.actions.show_rulers.set_checked(workspace.show_rulers)
        self.actions.show_guides.set_checked(workspace.show_guides)
        self.actions.snap.set_checked(workspace.snap)
        self.actions.lock_guides.set_checked(workspace.lock_guides)
        self.actions.clear_guides.set_enabled(workspace.canvas.guide_count() > 0)
        self.actions.show_transform_controls.set_checked(workspace.show_transform_controls)
        self.actions.show_grid.set_checked(workspace.show_grid)
        var shown = 0
        for unit_name in unit_ids():
            self.actions.units[shown].set_checked(workspace.units == unit_name)
            shown += 1
        self.layers.layout().invalidate()
        self.tabs.layout().invalidate()
        self.view.layout().invalidate()

    pub func close(self):
        self.prompts.cancel()
        self.settings_dialog.close()
        self.picker.close()
        self.document_settings.close()
        self.size_dialogs.close()
        self.text_editing.close_all()
        if self.workspace.previewing():
            self.workspace.end_preview(false) catch failure:
                discard(failure)
        self.kit.close()

    ## Each frame: give the canvas the keys once a pending focus is due.
    pub func settle_focus(self) -> unit!:
        if self.focus_canvas_in <= 0:
            return
        self.focus_canvas_in -= 1
        if self.focus_canvas_in == 0:
            self.view.layout().request_focus()

## Shift+L steps through the lassos as Photoshop's does: Polygonal, then
## Magnetic, then back to the Lasso. Other shortcuts pick their own tool.
pub func next_in_cycle(chosen: str, current: str) -> str:
    if chosen != "polygon":
        return chosen
    if current == "polygon":
        return "magnetic"
    if current == "magnetic":
        return "lasso"
    return "polygon"
