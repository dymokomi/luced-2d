from ui import Font, Text, Button, ListView, ListItem, VStack, HStack, Toolbar, Panel, SplitView, Size, TextPrompt, Spacer, Theme
from gpu import Color
from interop import Connection
from workspace import Workspace
from view import CanvasView

## The window's contents: a toolbar, the canvas beside the layers panel, a
## status line, and one text prompt that stands in for file dialogs for now.
pub class Panels:
    pub let body: VStack
    pub let view: CanvasView
    pub let workspace: Workspace
    pub let status: Text
    pub let prompt: TextPrompt
    pub let layers: ListView
    let font: Font
    let connections: list[Connection]
    var prompt_mode: str = ""
    var shown_revision: int = -1

    pub func init(self, workspace: Workspace, font: Font) -> unit!:
        self.workspace = workspace
        self.font = font
        self.connections = []
        self.view = CanvasView(workspace)
        self.prompt = TextPrompt(font = font)
        self.layers = ListView([], font = font)
        self.status = Text("", font = font)
        let toolbar = Toolbar([self.button("New", self.new_document), self.button("Open", self.open_document), self.button("Save", self.save_document),
                               self.button("Save As", self.save_document_as), Spacer(),
                               self.button("Brush", self.brush), self.button("Eraser", self.eraser), self.button("Size", self.edit_diameter),
                               self.swatch("Black", 0.0, 0.0, 0.0), self.swatch("White", 1.0, 1.0, 1.0), self.swatch("Orange", 0.8069, 0.3515, 0.0497),
                               self.swatch("Blue", 0.02, 0.18, 0.65), self.swatch("Red", 0.75, 0.03, 0.02), Spacer(),
                               self.button("Undo", self.undo), self.button("Redo", self.redo), Spacer(),
                               self.button("Fit", self.fit), self.button("100%", self.actual_size), self.button("+", self.zoom_in), self.button("-", self.zoom_out)], font = font)
        let layer_content = VStack([self.layers, HStack([self.button("Add", self.add_layer), self.button("Delete", self.delete_layer),
                                    self.button("Show/Hide", self.toggle_visibility), self.button("Opacity", self.edit_opacity)], spacing = 4.0)], spacing = 4.0, padding = 8.0)
        layer_content.layout().set_flex()
        let layer_panel = Panel("LAYERS", layer_content, minimum = Size(260.0, 180.0), closable = false)
        let canvas_panel = Panel("CANVAS", self.view, minimum = Size(200.0, 160.0), closable = false)
        let split = SplitView(canvas_panel, layer_panel, fraction = 0.78)
        self.body = VStack([toolbar, split, Toolbar([self.status], font = font), self.prompt], spacing = 0.0)
        self.body.layout().set_flex()
        self.connections.append(self.layers.on_activate(self.select_layer))
        self.connections.append(self.prompt.on_submit(self.apply))
        self.refresh()

    func button(self, text: str, callback: func() -> unit!) -> Button!:
        let button = Button(text, font = self.font)
        self.connections.append(button.on_click(callback))
        return button

    func swatch(self, text: str, red: float, green: float, blue: float) -> Button!:
        let button = self.button(text, func () -> unit!:
            self.workspace.set_color(red, green, blue)
            self.refresh())
        button.layout().set_theme(Theme(button = Color(red, green, blue), panel = Color(red, green, blue), pressed = Color(red, green, blue),
                                        foreground = Color(1.0, 1.0, 1.0) if red + green + blue < 1.2 else Color(0.0, 0.0, 0.0)))
        return button

    pub func brush(self) -> unit!:
        self.workspace.erasing = false
        self.refresh()

    pub func eraser(self) -> unit!:
        self.workspace.erasing = true
        self.refresh()

    pub func undo(self) -> unit!:
        self.workspace.undo()
        self.refresh()

    pub func redo(self) -> unit!:
        self.workspace.redo()
        self.refresh()

    pub func bigger(self) -> unit!:
        self.workspace.scale_brush(1.25)
        self.refresh()

    pub func smaller(self) -> unit!:
        self.workspace.scale_brush(0.8)
        self.refresh()

    pub func edit_diameter(self) -> unit!:
        self.ask("diameter", "Brush diameter, 1..4096 pixels", f"{int(self.workspace.diameter)}", "Apply")

    func cancel_prompt(self):
        self.prompt_mode = ""
        self.prompt.layout().set_visible(false)

    func ask(self, mode: str, title: str, value: str, accept: str) -> unit!:
        self.prompt.open(title, value, accept = accept)
        self.prompt_mode = mode

    pub func new_document(self) -> unit!:
        self.ask("new", "New document size, width x height in pixels", f"{self.workspace.width()} x {self.workspace.height()}", "Create")

    pub func open_document(self) -> unit!:
        self.ask("open", "Open a PNG, JPEG, TIFF or EXR file", self.workspace.path, "Open")

    pub func save_document(self) -> unit!:
        if self.workspace.path == "":
            self.save_document_as()
            return
        self.workspace.save(self.workspace.path)
        self.refresh()

    pub func save_document_as(self) -> unit!:
        self.ask("save", "Save the flattened document as (extension picks the format)", self.workspace.path, "Save")

    pub func edit_opacity(self) -> unit!:
        let percent = int(self.workspace.canvas.layer_opacity(self.workspace.selected) * 100.0 + 0.5)
        self.ask("opacity", "Layer opacity, 0..100 percent", f"{percent}", "Apply")

    pub func fit(self) -> unit!:
        self.workspace.fitted = false
        self.refresh()

    pub func actual_size(self) -> unit!:
        let bounds = self.view.layout().bounds()
        self.workspace.actual_size(bounds.width, bounds.height)
        self.refresh()

    pub func zoom_in(self) -> unit!:
        self.zoom_by(2.0)

    pub func zoom_out(self) -> unit!:
        self.zoom_by(0.5)

    func zoom_by(self, factor: float) -> unit!:
        let bounds = self.view.layout().bounds()
        self.workspace.zoom_about(factor, bounds.width * 0.5, bounds.height * 0.5)
        self.refresh()

    pub func add_layer(self) -> unit!:
        self.workspace.add_layer()
        self.refresh()

    pub func delete_layer(self) -> unit!:
        self.workspace.delete_layer()
        self.refresh()

    pub func toggle_visibility(self) -> unit!:
        self.workspace.toggle_visibility()
        self.refresh()

    pub func select_layer(self, row: int) -> unit!:
        self.workspace.select(self.workspace.layer_count() - 1 - row)
        self.refresh()

    func reject(self, text: str, message: str) -> unit!:
        self.prompt.open(message, text, accept = "Retry")

    pub func apply(self, text: str) -> unit!:
        let mode = self.prompt_mode
        let trimmed = text.trim()
        if mode == "":
            return
        if mode == "open":
            self.workspace.open(trimmed) catch failure:
                self.reject(text, f"Could not open: {failure.message}")
                return
        elif mode == "save":
            if trimmed == "":
                self.reject(text, "Enter a file name with an extension")
                return
            self.workspace.save(trimmed) catch failure:
                self.reject(text, f"Could not save: {failure.message}")
                return
        elif mode == "new":
            let parts = trimmed.split("x")
            if parts.length != 2:
                self.reject(text, "Enter a size like 1920 x 1080")
                return
            let width = int(parts[0].trim()) catch failure:
                self.reject(text, "Enter a size like 1920 x 1080")
                return
            let height = int(parts[1].trim()) catch failure:
                self.reject(text, "Enter a size like 1920 x 1080")
                return
            if width < 1 or height < 1 or width > 16384 or height > 16384:
                self.reject(text, "Each side must be 1..16384 pixels")
                return
            self.workspace.create(width, height)
        elif mode == "diameter":
            let pixels = int(trimmed) catch failure:
                self.reject(text, "Enter a whole number: 1..4096")
                return
            if pixels < 1 or pixels > 4096:
                self.reject(text, "Enter a whole number: 1..4096")
                return
            self.workspace.diameter = float(pixels)
        elif mode == "opacity":
            let percent = int(trimmed) catch failure:
                self.reject(text, "Enter a whole number: 0..100")
                return
            if percent < 0 or percent > 100:
                self.reject(text, "Enter a whole number: 0..100")
                return
            self.workspace.set_opacity(float(percent) / 100.0)
        self.cancel_prompt()
        self.refresh()

    pub func refresh(self) -> unit!:
        let workspace = self.workspace
        let name = workspace.path if workspace.path != "" else "Untitled"
        let percent = int(workspace.zoom * 100.0 + 0.5)
        let tool = "Eraser" if workspace.erasing else "Brush"
        self.status.set_text(f"{name}  |  {workspace.width()} x {workspace.height()} px  |  {percent}%  |  {tool} {int(workspace.diameter)} px ([ ] to resize)  |  B brush, E eraser, scroll pans, cmd+scroll zooms")
        let items: list[ListItem] = []
        var index = workspace.layer_count() - 1
        while index >= 0:
            let mark = "[x]" if workspace.canvas.layer_visible(index) else "[ ]"
            let opacity = int(workspace.canvas.layer_opacity(index) * 100.0 + 0.5)
            items.append(ListItem(f"{mark} {workspace.canvas.layer_name(index)}  {opacity}%"))
            index -= 1
        self.layers.set_items(items)
        self.layers.select(workspace.layer_count() - 1 - workspace.selected)
        self.view.layout().invalidate()

    pub func close(self):
        self.cancel_prompt()
        for connection in self.connections:
            connection.disconnect()
        self.connections.clear()
