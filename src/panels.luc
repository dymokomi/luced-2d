from ui import Font, Text, Button, VStack, HStack, Toolbar, Size, TextPrompt, Spacer, Application, Menu, Command, Slider, Widget, CurveEditor, DStack, Panel, DockPosition, Shelf, ButtonStyle, Rule, TextField, NumberField, Checkbox, Dialog
from interop import Connection
from workspace import Workspace
from canvas import Canvas
from actions import Actions
from view import CanvasView
from layers import LayerList
from colors import Palette, ColorPicker
from settings import Store
from settings_panel import SettingsDialog

## The window's contents, after Compositor's: a contextual tool header, a tool
## rail beside the canvas and the layers panel, and a status line. One text
## prompt stands in for the dialogs the desktop lacks.
pub class Panels:
    pub let body: VStack
    pub let view: CanvasView
    pub let workspace: Workspace
    pub let status: Text
    pub let prompt: TextPrompt
    pub let layers: LayerList
    pub let actions: Actions
    pub let header_title: Text
    pub let header_hint: Text
    ## The brush settings are eleusis scrubbers: drag to change, click to type.
    pub let size_field: NumberField
    pub let hardness_field: NumberField
    pub let opacity_field: NumberField
    pub let layer_opacity: Slider
    pub let layer_opacity_field: NumberField
    pub let brush_controls: HStack
    ## The dock and its three panes: the viewport, the layers and the properties
    ## of the selected layer, each pane's buttons on a shelf at its bottom.
    pub let dock: DStack
    pub let viewport_panel: Panel
    pub let layers_panel: Panel
    pub let properties_panel: Panel
    pub let tool_buttons: list[Button]
    pub let layer_name: TextField
    pub let visible_box: Checkbox
    pub let clipped_box: Checkbox
    pub let mask_box: Checkbox
    pub let styles_text: Text
    pub let blend_menu: Menu
    pub let wand_controls: HStack
    pub let text_controls: HStack
    ## The palette below the tool rail and the picker its swatches open, as Compositor's.
    pub let palette: Palette
    pub let settings_dialog: SettingsDialog
    pub let picker: ColorPicker
    pub let mask_prompt: Dialog
    pub let text_size_slider: Slider
    pub let tolerance_slider: Slider
    pub let contiguous_button: Button
    pub let layer_count: Text
    ## The adjust dialog, after Compositor's floating panels: a card centred over
    ## the canvas holding one column of rows for the open adjustment (or the
    ## blur, the free transform, the layer style), live-previewing, with
    ## Cancel/Apply. Each row is a slider and a number field showing one value.
    pub let adjust_dialog: Dialog
    pub let adjust_title: Text
    let adjust_rows: list[VStack]
    pub let adjust_sliders: list[list[Slider]]
    pub let adjust_fields: list[list[NumberField]]
    var built_sliders: list[Slider]
    var built_fields: list[NumberField]
    ## The Curves row: the editor for one channel at a time, chosen from a menu.
    pub let curve_editor: CurveEditor
    pub let curve_channel_label: Text
    var curve_channel: int = 0
    var adjust_kind: int = -1
    ## Layer Style (row 10): three effect toggles beside their sliders; the style
    ## before the bar opened, for Cancel.
    pub let style_toggles: list[Checkbox]
    var style_on: list[bool]
    var style_before: list[float]
    pub var app: Application? = none
    let font: Font
    let connections: list[Connection]
    var prompt_mode: str = ""
    var mask_background: bool = false

    pub func init(self, workspace: Workspace, actions: Actions, font: Font, store: Store? = none) -> unit!:
        self.workspace = workspace
        let settings_store = store else Store()
        self.settings_dialog = SettingsDialog(workspace, actions, font, settings_store)
        self.settings_dialog.applied = self.refresh
        self.actions = actions
        self.font = font
        self.connections = []
        self.view = CanvasView(workspace)
        self.prompt = TextPrompt(font = font)
        self.layers = LayerList(workspace, font)
        self.status = Text("", font = font)
        self.style_on = [false, false, false]
        self.style_before = []
        self.connect()
        # The contextual header: what the active tool needs.
        self.header_title = Text("Brush", font = font)
        self.header_hint = Text("", font = font)
        self.size_field = NumberField(workspace.diameter, 1.0, 500.0, 1.0, suffix = " px", font = font)
        self.hardness_field = NumberField(workspace.hardness * 100.0, 0.0, 100.0, 1.0, suffix = "%", font = font)
        self.opacity_field = NumberField(workspace.opacity * 100.0, 1.0, 100.0, 1.0, suffix = "%", font = font)
        self.connections.append(self.size_field.on_change(func (value: float) -> unit!:
            self.workspace.diameter = value
            self.workspace.touch()))
        self.connections.append(self.hardness_field.on_change(func (value: float) -> unit!:
            self.workspace.hardness = value / 100.0
            self.workspace.touch()))
        self.connections.append(self.opacity_field.on_change(func (value: float) -> unit!:
            self.workspace.opacity = value / 100.0
            self.workspace.touch()))
        self.palette = Palette(workspace)
        self.palette.on_pick = self.pick_color
        self.picker = ColorPicker(workspace, font)
        self.picker.closed = self.refresh
        # On a mask the palette offers only black (hide) and white (reveal), as Compositor's does.
        self.mask_prompt = Dialog([Text("Mask colour", font = font), HStack([self.button("Black · Hide", self.choose_mask_black), self.button("White · Reveal", self.choose_mask_white), Spacer()], spacing = 8.0)], width = 300.0)
        self.brush_controls = HStack([self.labelled("Size", self.size_field), self.labelled("Hardness", self.hardness_field), self.labelled("Opacity", self.opacity_field)], spacing = 12.0)
        self.tolerance_slider = Slider("Tolerance", 0.0, 255.0, workspace.tolerance, 1.0, font = font)
        self.connections.append(self.tolerance_slider.on_change(func (value: float) -> unit!:
            self.workspace.tolerance = value))
        self.contiguous_button = self.button("Contiguous ✓", self.toggle_contiguous)
        self.wand_controls = HStack([self.tolerance_slider, self.contiguous_button], spacing = 12.0)
        self.text_size_slider = Slider("Size", 8.0, 256.0, workspace.text_size, 1.0, font = font)
        self.connections.append(self.text_size_slider.on_change(func (value: float) -> unit!:
            self.workspace.text_size = value))
        self.text_controls = HStack([self.text_size_slider], spacing = 12.0)
        self.view.on_text = self.place_text
        self.header_title.layout().set_limits(Size(120.0, 0.0), Size(120.0, 16384.0))
        # The adjust dialog's rows, in the units Photoshop shows.
        self.adjust_title = Text("", font = font)
        self.adjust_rows = []
        self.adjust_sliders = []
        self.adjust_fields = []
        self.built_sliders = []
        self.built_fields = []
        self.adjust_row([self.adjust_control("Brightness", -100.0, 100.0, 0.0), self.adjust_control("Contrast", -100.0, 100.0, 0.0)])
        self.adjust_row([self.adjust_control("Hue", -180.0, 180.0, 0.0, 0, "°"), self.adjust_control("Saturation", -100.0, 100.0, 0.0),
                         self.adjust_control("Lightness", -100.0, 100.0, 0.0)])
        self.adjust_row([])
        self.adjust_row([self.adjust_control("In Black", 0.0, 255.0, 0.0), self.adjust_control("In White", 0.0, 255.0, 255.0),
                         self.adjust_control("Gamma", 0.1, 9.99, 1.0, 2), self.adjust_control("Out Black", 0.0, 255.0, 0.0),
                         self.adjust_control("Out White", 0.0, 255.0, 255.0)])
        self.adjust_row([])
        self.adjust_row([self.adjust_control("Threshold", 0.0, 255.0, 128.0)])
        self.adjust_row([self.adjust_control("Levels", 2.0, 32.0, 4.0)])
        # Curves (row 7): the editor for one channel at a time, chosen from a menu.
        self.curve_editor = CurveEditor()
        self.connections.append(self.curve_editor.on_change(self.curve_changed))
        var channels: list[Command] = []
        var channel = 0
        for name in ["RGB", "Red", "Green", "Blue"]:
            let chosen = channel
            let command = Command(name, id = f"curve_channel_{channel}")
            self.connections.append(command.on_trigger(func () -> unit!:
                self.show_curve_channel(chosen)))
            channels.append(command)
            channel += 1
        self.curve_channel_label = Text("RGB", font = font)
        var curve_items: list[Widget] = []
        curve_items.append(HStack([Menu("Channel ▾", channels, font = font), self.curve_channel_label, Spacer(), self.button("Reset", self.reset_curve)], spacing = 8.0))
        curve_items.append(self.curve_editor)
        self.adjust_row(curve_items)
        self.adjust_row([self.adjust_control("Radius", 0.5, 250.0, 8.0, 1, " px")])
        self.adjust_row([self.adjust_control("Width", 1.0, 400.0, 100.0, 0, "%"), self.adjust_control("Height", 1.0, 400.0, 100.0, 0, "%"),
                         self.adjust_control("Angle", -180.0, 180.0, 0.0, 0, "°"), self.adjust_control("X", -2000.0, 2000.0, 0.0, 0, " px"),
                         self.adjust_control("Y", -2000.0, 2000.0, 0.0, 0, " px")])
        # Layer Style (row 10): each effect is a checkbox heading over its rows, as Compositor's Effects panel.
        self.style_toggles = []
        var style_items: list[Widget] = []
        self.style_section(style_items, 0, "Drop Shadow", [self.adjust_control("X", -100.0, 100.0, 4.0, 0, " px"), self.adjust_control("Y", -100.0, 100.0, 4.0, 0, " px"),
                                                          self.adjust_control("Blur", 0.0, 100.0, 4.0, 0, " px"), self.adjust_control("Opacity", 0.0, 100.0, 75.0, 0, "%")])
        self.style_section(style_items, 1, "Stroke", [self.adjust_control("Size", 0.0, 100.0, 3.0, 0, " px"), self.adjust_control("Opacity", 0.0, 100.0, 100.0, 0, "%")])
        self.style_section(style_items, 2, "Outer Glow", [self.adjust_control("Size", 0.0, 100.0, 8.0, 0, " px"), self.adjust_control("Opacity", 0.0, 100.0, 75.0, 0, "%")])
        self.adjust_row(style_items)
        var dialog_items: list[Widget] = [self.adjust_title]
        for row in self.adjust_rows:
            dialog_items.append(row)
        dialog_items.append(HStack([Spacer(), self.button("Cancel", self.cancel_preview), self.button("Apply", self.apply_preview)], spacing = 8.0))
        self.adjust_dialog = Dialog(dialog_items, width = 420.0)
        # The menus present the shared commands, shortcuts and all.
        let menus = Toolbar([Menu("File", [actions.new_document, actions.open_document, actions.save, actions.save_as], font = font),
                             Menu("Edit", [actions.undo, actions.redo, actions.free_transform, actions.fill, actions.fill_background, actions.clear, actions.swap_colors, actions.reset_colors, Command("", divider = true), actions.settings], font = font),
                             Menu("Select", [actions.select_all, actions.deselect, actions.inverse, actions.expand, actions.contract, actions.feather], font = font),
                             Menu("Image", [actions.crop, actions.canvas_size, actions.image_size], font = font),
                             Menu("Adjust", actions.adjustments, font = font),
                             Menu("Layer", [actions.add_layer, actions.duplicate_layer, actions.layer_up, actions.layer_down, actions.merge_down, actions.delete_layer,
                                            actions.toggle_mask, actions.toggle_mask_editing, actions.toggle_clipped, actions.toggle_visibility, actions.rename_layer, actions.layer_style], font = font),
                             Menu("Filter", [actions.blur], font = font),
                             Menu("View", [actions.fit, actions.actual_size, actions.zoom_in, actions.zoom_out], font = font),
                             Spacer()], font = font)
        let header = Toolbar([self.header_title, self.brush_controls, self.wand_controls, self.text_controls, Spacer()], font = font)
        # The tool rail, as eleusis's viewport rail: 28-point buttons, the active tool selected.
        var rail_items: list[Widget] = []
        self.tool_buttons = []
        var index = 0
        for command in actions.tools:
            let button = self.tool_button(actions.tool_icons[index], command)
            self.tool_buttons.append(button)
            rail_items.append(button)
            index += 1
        # Below the tools, the palette, as Compositor's rail.
        rail_items.append(Rule())
        rail_items.append(self.palette)
        let rail = VStack(rail_items, spacing = 3.0, padding = 6.0)
        rail.layout().set_limits(Size(40.0, 100.0), Size(40.0, 16384.0))
        rail.layout().set_flex(horizontal = 0.0)
        # The layers panel: appearance, the list, and the footer.
        self.layer_count = Text("", font = font)
        self.layer_opacity = Slider("", 0.0, 100.0, 100.0, 1.0, font = font, show_value = false)
        self.layer_opacity_field = NumberField(100.0, 0.0, 100.0, 1.0, suffix = "%", font = font, cells = 6.0)
        self.connections.append(self.layer_opacity.on_change(func (value: float) -> unit!:
            self.workspace.set_opacity(value / 100.0)
            self.layer_opacity_field.set_value(value)
            self.layers.layout().invalidate()))
        self.connections.append(self.layer_opacity_field.on_change(func (value: float) -> unit!:
            self.workspace.set_opacity(value / 100.0)
            self.layer_opacity.set_value(value)
            self.layers.layout().invalidate()))
        # Layers: the list, with its actions on the shelf below (the destructive one alone at the right).
        let layers_shelf = Shelf([self.shelf_button("plus", self.add_layer), self.shelf_button("duplicate", self.duplicate_layer),
                                  self.shelf_button("layer-mask", self.toggle_mask), self.shelf_button("send-backward", self.toggle_clipped),
                                  Spacer(), self.shelf_button("trash", self.delete_layer)])
        self.layers.layout().set_flex()
        self.layers_panel = Panel("Layers", self.layers, minimum = Size(220.0, 120.0), closable = false, footer = layers_shelf)
        # Properties: what the selected layer is, one row each.
        # The name is edited in place; committing it renames the layer.
        self.layer_name = TextField("", font = font, placeholder = "Layer name", cells = 18.0)
        self.connections.append(self.layer_name.on_commit(func (value: str) -> unit!:
            if value.trim() != "":
                self.workspace.rename(value.trim())
            self.refresh()))
        self.visible_box = self.checkbox("Visible", self.toggle_visibility)
        self.clipped_box = self.checkbox("Clip", self.toggle_clipped)
        self.mask_box = self.checkbox("Mask", self.toggle_mask)
        self.styles_text = Text("None", font = font)
        self.blend_menu = Menu("Normal ▾", actions.blends, font = font)
        self.layer_opacity.layout().set_flex()
        let properties = VStack([self.property_row("Layer", self.layer_name), self.property_row("Blend", self.blend_menu),
                                 self.property_row("Opacity", HStack([self.layer_opacity, self.layer_opacity_field], spacing = 6.0)),
                                 self.property_row("Flags", HStack([self.visible_box, self.clipped_box, self.mask_box], spacing = 10.0)),
                                 self.property_row("Styles", HStack([self.styles_text, self.button("Edit…", self.layer_style)], spacing = 8.0)),
                                 Spacer()], spacing = 0.0, padding = 0.0)
        self.properties_panel = Panel("Properties", properties, minimum = Size(220.0, 100.0), closable = false)
        # The viewport: the tool rail beside the canvas.
        # A one-point backdrop rule separates the rail from the canvas, as eleusis's viewport does.
        let viewport = HStack([rail, Rule(structural = true, vertical = true), self.view], spacing = 0.0)
        viewport.layout().set_flex()
        self.viewport_panel = Panel("Viewport", viewport, minimum = Size(320.0, 200.0), closable = false)
        self.dock = DStack([self.viewport_panel, self.layers_panel, self.properties_panel], font = font)
        self.dock.move(self.layers_panel, self.viewport_panel, DockPosition.right)
        self.dock.move(self.properties_panel, self.layers_panel, DockPosition.bottom)
        self.dock.set_fraction(self.viewport_panel, 0.76)
        self.dock.set_fraction(self.layers_panel, 0.55)
        self.dock.layout().set_flex()
        # The status bar is where a control's hint shows, as in eleusis: no tooltips.
        self.body = VStack([menus, header, self.dock, Toolbar([self.status, Spacer(), self.header_hint], font = font), self.prompt, self.picker.dialog, self.mask_prompt, self.adjust_dialog, self.settings_dialog.dialog], spacing = 0.0)
        self.body.layout().set_flex()
        self.connections.append(self.prompt.on_submit(self.apply))
        self.refresh()

    ## One control of the adjust dialog, after Compositor's rows: a muted label
    ## in a 64-point column, a slider, and a number field with its unit, both
    ## showing one value. Every change re-previews the open adjustment.
    func adjust_control(self, label: str, minimum: float, maximum: float, value: float, decimals: int = 0, suffix: str = "") -> Widget!:
        let step = 0.01 if decimals == 2 else (0.1 if decimals == 1 else 1.0)
        let slider = Slider("", minimum, maximum, value, step, decimals = decimals, font = self.font, show_value = false)
        slider.layout().set_flex()
        let field = NumberField(value, minimum, maximum, step, decimals, suffix = suffix, font = self.font, cells = 7.0)
        self.connections.append(slider.on_change(func (changed: float) -> unit!:
            field.set_value(changed)
            self.preview()))
        self.connections.append(field.on_change(func (changed: float) -> unit!:
            slider.set_value(changed)
            self.preview()))
        self.built_sliders.append(slider)
        self.built_fields.append(field)
        let caption = Text(label, font = self.font, muted = true)
        caption.layout().set_limits(Size(64.0, 0.0), Size(64.0, 16384.0))
        return HStack([caption, slider, field], spacing = 10.0)

    ## One adjustment's column of rows, hidden until it opens; the controls
    ## built since the last row belong to it.
    func adjust_row(self, items: list[Widget]) -> unit!:
        let row = VStack(items, spacing = 10.0)
        row.layout().set_visible(false)
        self.adjust_rows.append(row)
        self.adjust_sliders.append(self.built_sliders)
        self.adjust_fields.append(self.built_fields)
        self.built_sliders = []
        self.built_fields = []

    ## One effect of the Layer Style: its checkbox heading, then its rows.
    func style_section(self, items: list[Widget], effect: int, name: str, controls: list[Widget]) -> unit!:
        let box = Checkbox(name, font = self.font)
        self.connections.append(box.on_change(func (value: bool) -> unit!:
            discard(value)
            self.toggle_style(effect)))
        self.style_toggles.append(box)
        items.append(box)
        for control in controls:
            items.append(control)

    ## Set one control of row `kind` from code: the slider and its field together.
    func set_control(self, kind: int, index: int, value: float) -> unit!:
        self.adjust_sliders[kind][index].set_value(value)
        self.adjust_fields[kind][index].set_value(value)

    ## The open adjustment's slider values in the units the canvas takes.
    func adjust_values(self) -> list[float]:
        let kind = self.adjust_kind
        let sliders = self.adjust_sliders[kind]
        var values: list[float] = []
        for slider in sliders:
            values.append(slider.value())
        if kind == 0:
            return [values[0] / 100.0, values[1] / 100.0]
        if kind == 1:
            return [values[0] / 360.0, values[1] / 100.0, values[2] / 100.0]
        if kind == 3:
            return [values[0] / 255.0, values[1] / 255.0, values[2], values[3] / 255.0, values[4] / 255.0]
        if kind == 5:
            return [values[0] / 255.0]
        return values

    ## Show the open adjustment (the blur, row 8; the free transform, row 9) with the controls as they are.
    pub func preview(self) -> unit!:
        let kind = self.adjust_kind
        if kind == 10:
            self.apply_styles()
            return
        if kind < 0 or not self.workspace.previewing():
            return
        if kind == 8:
            self.workspace.preview_blur(self.adjust_sliders[8][0].value())
        elif kind == 9:
            let sliders = self.adjust_sliders[9]
            self.workspace.preview_transform(sliders[0].value() / 100.0, sliders[1].value() / 100.0, sliders[2].value(), sliders[3].value(), sliders[4].value())
        else:
            self.workspace.preview_adjust(kind, self.adjust_values())
        self.view.layout().invalidate()

    ## The editor's points become the canvas's curve for the shown channel, then re-preview.
    pub func curve_changed(self) -> unit!:
        let canvas = self.workspace.canvas
        canvas.reset_curve(self.curve_channel)
        var index = 0
        while index < self.curve_editor.point_count():
            canvas.add_curve_point(self.curve_channel, self.curve_editor.point_x(index), self.curve_editor.point_y(index))
            index += 1
        self.preview()

    ## Load the canvas's curve for `channel` into the editor.
    func show_curve_channel(self, channel: int) -> unit!:
        self.curve_channel = channel
        let canvas = self.workspace.canvas
        self.curve_editor.reset()
        var index = 0
        while index < canvas.curve_point_count(channel):
            self.curve_editor.add_point(canvas.curve_point_x(channel, index), canvas.curve_point_y(channel, index))
            index += 1
        self.curve_channel_label.set_text(["RGB", "Red", "Green", "Blue"][channel])

    func reset_curve(self) -> unit!:
        self.workspace.canvas.reset_curve(self.curve_channel)
        self.show_curve_channel(self.curve_channel)
        self.preview()

    ## Layer styles are not destructive: the controls write straight to the layer.
    func apply_styles(self) -> unit!:
        let s = self.adjust_sliders[10]
        self.workspace.set_styles(self.style_on[0], s[0].value(), s[1].value(), s[2].value(), s[3].value() / 100.0,
                                  self.style_on[1], s[4].value(), s[5].value() / 100.0, self.style_on[2], s[6].value(), s[7].value() / 100.0)
        self.view.layout().invalidate()
        self.layers.layout().invalidate()

    pub func toggle_style(self, effect: int) -> unit!:
        self.style_on[effect] = not self.style_on[effect]
        self.show_style_toggles()
        self.apply_styles()

    func show_style_toggles(self) -> unit!:
        var effect = 0
        while effect < 3:
            self.style_toggles[effect].set_checked(self.style_on[effect])
            effect += 1

    ## Layer › Layer Style…: the dialog shows the selected layer's styles for editing.
    pub func layer_style(self) -> unit!:
        if self.workspace.previewing():
            self.workspace.end_preview(false)
        self.style_before = []
        var field = 0
        while field < 20:
            self.style_before.append(self.workspace.style_value(field))
            field += 1
        let before = self.style_before
        self.style_on = [before[0] != 0.0, before[8] != 0.0, before[14] != 0.0]
        self.set_control(10, 0, before[1])
        self.set_control(10, 1, before[2])
        self.set_control(10, 2, before[3])
        self.set_control(10, 3, before[7] * 100.0)
        self.set_control(10, 4, before[9])
        self.set_control(10, 5, before[13] * 100.0)
        self.set_control(10, 6, before[15])
        self.set_control(10, 7, before[19] * 100.0)
        self.show_style_toggles()
        self.adjust_kind = 10
        var index = 0
        for row in self.adjust_rows:
            row.layout().set_visible(index == 10)
            index += 1
        self.adjust_title.set_text("Layer Style")
        self.adjust_dialog.open()
        self.refresh()

    ## Open the adjust dialog for `kind` (8 for blur) with its controls at their defaults.
    func open_preview(self, kind: int, title: str) -> unit!:
        if self.workspace.previewing():
            self.workspace.end_preview(false)
        self.workspace.begin_preview() catch failure:
            self.ask("", f"Cannot adjust: {failure.message}", "", "OK")
            return
        self.adjust_kind = kind
        if kind == 7:
            var channel = 0
            while channel < 4:
                self.workspace.canvas.reset_curve(channel)
                channel += 1
            self.show_curve_channel(0)
        var index = 0
        for row in self.adjust_rows:
            row.layout().set_visible(index == kind)
            index += 1
        self.adjust_title.set_text(title)
        self.adjust_dialog.open()
        self.preview()
        self.refresh()

    func close_preview(self, keep: bool) -> unit!:
        if self.adjust_kind == 10 and not keep and self.style_before.length == 20:
            # Cancel puts the styles back as they were when the dialog opened.
            let b = self.style_before
            let id = self.workspace.selected_id()
            self.workspace.canvas.set_shadow(id, b[0] != 0.0, b[1], b[2], b[3], b[4], b[5], b[6], b[7])
            self.workspace.canvas.set_stroke(id, b[8] != 0.0, b[9], b[10], b[11], b[12], b[13])
            self.workspace.canvas.set_glow(id, b[14] != 0.0, b[15], b[16], b[17], b[18], b[19])
            self.workspace.touch()
        if self.workspace.previewing():
            self.workspace.end_preview(keep)
        self.adjust_kind = -1
        self.adjust_dialog.hide()
        self.refresh()

    pub func apply_preview(self) -> unit!:
        self.close_preview(true)

    pub func cancel_preview(self) -> unit!:
        self.close_preview(false)

    func button(self, text: str, callback: func() -> unit!) -> Button!:
        let button = Button(text, font = self.font)
        self.connections.append(button.on_click(callback))
        return button

    ## Wire every shared command to what this window does for it.
    func connect(self) -> unit!:
        let actions = self.actions
        self.bind(actions.new_document, self.new_document)
        self.bind(actions.open_document, self.open_document)
        self.bind(actions.save, self.save_document)
        self.bind(actions.save_as, self.save_document_as)
        self.bind(actions.undo, self.undo)
        self.bind(actions.redo, self.redo)
        self.bind(actions.fill, self.fill_selection)
        self.bind(actions.settings, self.settings_dialog.open)
        self.bind(actions.fill_background, self.fill_background)
        self.bind(actions.clear, self.clear_selection)
        self.bind(actions.swap_colors, func () -> unit!:
            self.workspace.swap_colors()
            self.refresh())
        self.bind(actions.reset_colors, func () -> unit!:
            self.workspace.reset_colors()
            self.refresh())
        self.bind(actions.select_all, self.select_all)
        self.bind(actions.deselect, self.deselect)
        self.bind(actions.inverse, self.invert_selection)
        self.bind(actions.expand, self.expand_selection)
        self.bind(actions.contract, self.contract_selection)
        self.bind(actions.feather, self.feather_selection)
        self.bind(actions.crop, self.crop)
        self.bind(actions.canvas_size, self.canvas_size)
        self.bind(actions.image_size, self.image_size)
        self.bind(actions.blur, self.blur)
        self.bind(actions.free_transform, self.free_transform)
        self.bind(actions.layer_style, self.layer_style)
        self.bind(actions.rename_layer, self.rename_layer)
        self.bind(actions.add_layer, self.add_layer)
        self.bind(actions.duplicate_layer, self.duplicate_layer)
        self.bind(actions.layer_up, self.layer_up)
        self.bind(actions.layer_down, self.layer_down)
        self.bind(actions.merge_down, self.merge_down)
        self.bind(actions.delete_layer, self.delete_layer)
        self.bind(actions.toggle_mask, self.toggle_mask)
        self.bind(actions.toggle_mask_editing, self.toggle_mask_editing)
        self.bind(actions.toggle_clipped, self.toggle_clipped)
        self.bind(actions.toggle_visibility, self.toggle_visibility)
        self.bind(actions.fit, self.fit)
        self.bind(actions.actual_size, self.actual_size)
        self.bind(actions.zoom_in, self.zoom_in)
        self.bind(actions.zoom_out, self.zoom_out)
        self.bind(actions.bigger, self.bigger)
        self.bind(actions.smaller, self.smaller)
        var kind = 0
        for command in actions.adjustments:
            let selected = kind
            self.bind(command, func () -> unit!:
                self.adjust(selected))
            kind += 1
        var mode = 0
        for command in actions.blends:
            let chosen = mode
            self.bind(command, func () -> unit!:
                self.set_blend(chosen))
            mode += 1
        for command in actions.tools:
            let tool = command.id()
            self.bind(command, func () -> unit!:
                self.choose_tool(tool))

    ## Layer › Rename…: ask for the selected layer's new name.
    pub func rename_layer(self) -> unit!:
        self.ask("rename", "Layer name", self.workspace.canvas.layer_name(self.workspace.selected), "Rename")

    ## A palette swatch clicked: the picker opens for that colour — or, on a
    ## mask, the black/white choice.
    pub func pick_color(self, background: bool) -> unit!:
        self.mask_background = background
        if self.workspace.canvas.editing_mask():
            self.mask_prompt.open()
            return
        self.picker.open(background)
        self.refresh()

    func choose_mask_black(self) -> unit!:
        self.choose_mask_color(0.0)

    func choose_mask_white(self) -> unit!:
        self.choose_mask_color(1.0)

    func choose_mask_color(self, value: float) -> unit!:
        self.workspace.set_palette(value, value, value, self.mask_background)
        self.mask_prompt.hide()
        self.refresh()

    pub func fill_background(self) -> unit!:
        self.workspace.fill_selection(false, true)
        self.refresh()

    ## The text tool clicked: ask for the text to set there.
    func place_text(self) -> unit!:
        self.ask("text", "Text to set at the click, in the foreground colour", "", "Set")

    func toggle_contiguous(self) -> unit!:
        self.workspace.contiguous = not self.workspace.contiguous
        self.contiguous_button.set_text("Contiguous ✓" if self.workspace.contiguous else "Contiguous")

    func bind(self, command: Command, callback: func() -> unit!) -> unit!:
        self.connections.append(command.on_trigger(callback))

    ## A square icon button that triggers a tool command.
    func tool_button(self, icon: str, command: Command) -> Button!:
        let button = Button(icon = icon, font = self.font)
        self.connections.append(button.on_click(func () -> unit!:
            command.trigger()))
        button.layout().set_size(28.0, 28.0)
        return button

    ## A shelf button: 25 points square, plain, so only the icon shows at rest.
    func shelf_button(self, icon: str, callback: func() -> unit!) -> Button!:
        let button = Button(icon = icon, font = self.font)
        button.set_style(ButtonStyle.plain)
        self.connections.append(button.on_click(callback))
        button.layout().set_size(25.0, 25.0)
        return button

    ## A properties row after eleusis: a muted label in a fixed column, the
    ## control, and a one-point rule beneath.
    func property_row(self, label: str, control: Widget) -> VStack!:
        let caption = Text(label, font = self.font, muted = true)
        caption.layout().set_limits(Size(64.0, 0.0), Size(64.0, 16384.0))
        let row = HStack([caption, control], spacing = 6.0, padding = 4.0)
        return VStack([row, Rule()], spacing = 0.0)

    ## A header control with its muted caption before it.
    func labelled(self, label: str, control: Widget) -> HStack!:
        return HStack([Text(label, font = self.font, muted = true), control], spacing = 4.0)

    ## A flag checkbox; the state itself comes from the layer on refresh, so the
    ## callback toggles the flag rather than copying the box's value.
    func checkbox(self, label: str, callback: func() -> unit!) -> Checkbox!:
        let box = Checkbox(label, font = self.font)
        self.connections.append(box.on_change(func (value: bool) -> unit!:
            discard(value)
            callback()))
        return box

    func icon_button(self, icon: str, callback: func() -> unit!) -> Button!:
        let button = Button(icon = icon, font = self.font)
        self.connections.append(button.on_click(callback))
        return button

    pub func choose_tool(self, tool: str) -> unit!:
        self.workspace.choose_tool(tool)
        self.refresh()

    pub func blur(self) -> unit!:
        self.open_preview(8, "Gaussian Blur")

    pub func free_transform(self) -> unit!:
        var index = 0
        while index < 5:
            self.set_control(9, index, 100.0 if index < 2 else 0.0)
            index += 1
        self.open_preview(9, "Free Transform")

    pub func select_all(self) -> unit!:
        self.workspace.select_all()
        self.refresh()

    pub func invert_selection(self) -> unit!:
        self.workspace.invert_selection()
        self.refresh()

    pub func expand_selection(self) -> unit!:
        self.ask("expand", "Expand the selection by, in pixels (1..512)", "4", "Expand")

    pub func contract_selection(self) -> unit!:
        self.ask("contract", "Contract the selection by, in pixels (1..512)", "4", "Contract")

    pub func feather_selection(self) -> unit!:
        self.ask("feather", "Feather the selection's edge by, in pixels (1..512)", "4", "Feather")

    pub func deselect(self) -> unit!:
        self.workspace.deselect()
        self.refresh()

    pub func fill_selection(self) -> unit!:
        self.workspace.fill_selection(false)
        self.refresh()

    pub func clear_selection(self) -> unit!:
        self.workspace.fill_selection(true)
        self.refresh()

    func cancel_prompt(self):
        self.prompt_mode = ""
        self.prompt.layout().set_visible(false)

    func ask(self, mode: str, title: str, value: str, accept: str) -> unit!:
        self.prompt.open(title, value, accept = accept)
        self.prompt_mode = mode

    pub func new_document(self) -> unit!:
        self.ask("new", "New document size, width x height in pixels", f"{self.workspace.width()} x {self.workspace.height()}", "Create")

    pub func open_document(self) -> unit!:
        if let app = self.app:
            let chosen = app.open_file("Open an .l2d document, a Photoshop .psd, or a PNG, JPEG, TIFF or EXR picture") catch failure:
                self.ask("open", "Open a PSD, PNG, JPEG, TIFF or EXR file", self.workspace.path, "Open")
                return
            if chosen != "":
                self.workspace.open(chosen) catch failure:
                    self.ask("open", f"Could not open: {failure.message}", chosen, "Open")
                    return
                self.refresh()
            return
        self.ask("open", "Open a PSD, PNG, JPEG, TIFF or EXR file", self.workspace.path, "Open")

    pub func save_document(self) -> unit!:
        if self.workspace.path == "":
            self.save_document_as()
            return
        self.workspace.save(self.workspace.path)
        self.refresh()

    pub func save_document_as(self) -> unit!:
        if let app = self.app:
            let suggested = self.workspace.path if self.workspace.path != "" else "Untitled.l2d"
            let chosen = app.save_file("Save as .l2d to keep the layers, or as PNG, JPEG or TIFF for a flattened picture", suggested) catch failure:
                self.ask("save", "Save the flattened document as (extension picks the format)", self.workspace.path, "Save")
                return
            if chosen != "":
                self.workspace.save(chosen) catch failure:
                    self.ask("save", f"Could not save: {failure.message}", chosen, "Save")
                    return
                self.refresh()
            return
        self.ask("save", "Save the flattened document as (extension picks the format)", self.workspace.path, "Save")

    ## Open the adjustment's sliders with a live preview, or apply the ones
    ## that take no parameters at once.
    pub func adjust(self, kind: int) -> unit!:
        if kind == 2 or kind == 4:
            self.workspace.adjust(kind, [])
            self.refresh()
            return
        var title = "Brightness / Contrast"
        if kind == 1:
            title = "Hue / Saturation / Lightness"
        elif kind == 3:
            title = "Levels"
        elif kind == 5:
            title = "Threshold"
        elif kind == 6:
            title = "Posterize"
        elif kind == 7:
            title = "Curves"
        self.open_preview(kind, title)

    pub func crop(self) -> unit!:
        self.workspace.crop() catch failure:
            self.ask("", f"Cannot crop: {failure.message}", "", "OK")
            return
        self.refresh()

    pub func canvas_size(self) -> unit!:
        self.ask("canvas", "Canvas size: width x height, then the old canvas's offset x y (e.g. 1920 x 1080 0 0)", f"{self.workspace.width()} x {self.workspace.height()} 0 0", "Resize")

    pub func image_size(self) -> unit!:
        self.ask("image", "Image size: width x height in pixels", f"{self.workspace.width()} x {self.workspace.height()}", "Resize")

    func parse_size(self, text: str) -> list[int]!:
        var numbers: list[int] = []
        for part in text.replace("x", " ").split(" "):
            let piece = part.trim()
            if piece == "":
                continue
            let number = int(piece) catch failure:
                return []
            numbers.append(number)
        return numbers

    pub func fit(self) -> unit!:
        self.workspace.fitted = false
        self.refresh()

    pub func actual_size(self) -> unit!:
        let bounds = self.view.layout().bounds()
        self.workspace.actual_size(bounds.width, bounds.height)
        self.refresh()

    pub func zoom_in(self) -> unit!:
        self.zoom_by(2.0)

    pub func zoom_out(self) -> unit!:
        self.zoom_by(0.5)

    func zoom_by(self, factor: float) -> unit!:
        let bounds = self.view.layout().bounds()
        self.workspace.zoom_about(factor, bounds.width * 0.5, bounds.height * 0.5)
        self.refresh()

    pub func undo(self) -> unit!:
        self.workspace.undo()
        self.refresh()

    pub func redo(self) -> unit!:
        self.workspace.redo()
        self.refresh()

    pub func bigger(self) -> unit!:
        self.workspace.scale_brush(1.25)
        self.refresh()

    pub func smaller(self) -> unit!:
        self.workspace.scale_brush(0.8)
        self.refresh()

    pub func add_layer(self) -> unit!:
        self.workspace.add_layer()
        self.refresh()

    pub func duplicate_layer(self) -> unit!:
        self.workspace.duplicate()
        self.refresh()

    pub func layer_up(self) -> unit!:
        self.workspace.reorder(1)
        self.refresh()

    pub func layer_down(self) -> unit!:
        self.workspace.reorder(-1)
        self.refresh()

    pub func merge_down(self) -> unit!:
        self.workspace.merge_down()
        self.refresh()

    pub func delete_layer(self) -> unit!:
        self.workspace.delete_layer()
        self.refresh()

    pub func toggle_visibility(self) -> unit!:
        self.workspace.toggle_visibility()
        self.refresh()

    pub func set_blend(self, mode: int) -> unit!:
        let workspace = self.workspace
        workspace.canvas.set_layer(workspace.selected_id(), workspace.canvas.layer_visible(workspace.selected), workspace.canvas.layer_opacity(workspace.selected), mode)
        workspace.touch()
        self.refresh()

    pub func cycle_blend(self, step: int) -> unit!:
        self.workspace.cycle_blend(step)
        self.refresh()

    pub func toggle_mask(self) -> unit!:
        self.workspace.toggle_mask()
        self.refresh()

    pub func toggle_mask_editing(self) -> unit!:
        self.workspace.toggle_mask_editing()
        self.refresh()

    pub func toggle_clipped(self) -> unit!:
        self.workspace.toggle_clipped()
        self.refresh()

    pub func select_layer(self, index: int) -> unit!:
        self.workspace.select(index)
        self.refresh()

    func reject(self, text: str, message: str) -> unit!:
        self.prompt.open(message, text, accept = "Retry")

    pub func apply(self, text: str) -> unit!:
        let mode = self.prompt_mode
        let trimmed = text.trim()
        if mode == "":
            return
        if mode == "open":
            self.workspace.open(trimmed) catch failure:
                self.reject(text, f"Could not open: {failure.message}")
                return
        elif mode == "rename":
            if trimmed == "":
                return
            self.workspace.rename(trimmed) catch failure:
                self.reject(text, f"Could not rename: {failure.message}")
                return
        elif mode == "text":
            if trimmed == "":
                return
            self.workspace.draw_text(trimmed) catch failure:
                self.reject(text, f"Could not set text: {failure.message}")
                return
        elif mode == "save":
            if trimmed == "":
                self.reject(text, "Enter a file name with an extension")
                return
            self.workspace.save(trimmed) catch failure:
                self.reject(text, f"Could not save: {failure.message}")
                return
        elif mode == "new":
            let parts = trimmed.split("x")
            if parts.length != 2:
                self.reject(text, "Enter a size like 1920 x 1080")
                return
            let width = int(parts[0].trim()) catch failure:
                self.reject(text, "Enter a size like 1920 x 1080")
                return
            let height = int(parts[1].trim()) catch failure:
                self.reject(text, "Enter a size like 1920 x 1080")
                return
            if width < 1 or height < 1 or width > 16384 or height > 16384:
                self.reject(text, "Each side must be 1..16384 pixels")
                return
            self.workspace.create(width, height)
        elif mode == "canvas":
            let numbers = self.parse_size(trimmed)
            if numbers.length != 4 and numbers.length != 2:
                self.reject(text, "Enter: width x height offset_x offset_y")
                return
            let ox = numbers[2] if numbers.length == 4 else 0
            let oy = numbers[3] if numbers.length == 4 else 0
            self.workspace.resize_canvas(numbers[0], numbers[1], ox, oy) catch failure:
                self.reject(text, f"Could not resize: {failure.message}")
                return
        elif mode == "image":
            let numbers = self.parse_size(trimmed)
            if numbers.length != 2:
                self.reject(text, "Enter: width x height")
                return
            self.workspace.resize_image(numbers[0], numbers[1]) catch failure:
                self.reject(text, f"Could not resize: {failure.message}")
                return
        elif mode == "expand" or mode == "contract" or mode == "feather":
            let amount = int(trimmed) catch failure:
                self.reject(text, "Enter a whole number: 1..512")
                return
            if amount < 1 or amount > 512:
                self.reject(text, "Enter a whole number: 1..512")
                return
            let pixels = amount if mode == "expand" else (-amount if mode == "contract" else 0)
            self.workspace.adjust_selection(pixels, amount if mode == "feather" else 0) catch failure:
                self.reject(text, f"Could not adjust: {failure.message}")
                return
        self.cancel_prompt()
        self.refresh()

    pub func refresh(self) -> unit!:
        let workspace = self.workspace
        let name = workspace.path if workspace.path != "" else "Untitled"
        let percent = int(workspace.zoom * 100.0 + 0.5)
        var tool = workspace.tool_name()
        if workspace.canvas.editing_mask() and (workspace.tool == "brush" or workspace.tool == "eraser"):
            tool = tool + " on mask"
        self.header_title.set_text(tool)
        self.brush_controls.layout().set_visible(workspace.tool == "brush" or workspace.tool == "eraser" or workspace.tool == "gradient")
        self.wand_controls.layout().set_visible(workspace.tool == "wand")
        self.text_controls.layout().set_visible(workspace.tool == "text")
        self.palette.layout().invalidate()
        self.picker.sync()
        self.size_field.set_value(workspace.diameter)
        self.hardness_field.set_value(workspace.hardness * 100.0)
        self.opacity_field.set_value(workspace.opacity * 100.0)
        var hint = "Drag to paint · [ ] size · Space to pan · scroll pans, cmd-scroll zooms"
        if self.picker.is_open():
            hint = "Click the canvas to sample a colour · X swaps · D resets"
        elif workspace.tool == "move":
            hint = "Drag to move the layer · arrows nudge 1 px, shift 10 px"
        elif workspace.tool == "marquee" or workspace.tool == "ellipse" or workspace.tool == "lasso":
            hint = "Drag to select · shift adds · alt subtracts · cmd-A all · cmd-D deselect · Delete clears"
        elif workspace.tool == "wand":
            hint = "Click a colour to select it · shift adds · alt subtracts"
        elif workspace.tool == "text":
            hint = "Click where the text starts, then type it"
        elif workspace.tool == "eyedropper":
            hint = "Click a colour to make it the foreground colour"
        elif workspace.tool == "gradient":
            hint = "Drag from the foreground colour to the background colour · fills the selection"
        elif workspace.tool == "hand":
            hint = "Drag to pan"
        elif workspace.tool == "zoom":
            hint = "Click to zoom in · alt-click to zoom out"
        self.header_hint.set_text(hint)
        self.status.set_text(f"{percent}%  |  {workspace.width()} × {workspace.height()} px  |  sRGB · Transparent  |  {name}")
        self.layer_count.set_text(f"{workspace.layer_count()}")
        self.layers_panel.set_text(f"Layers · {workspace.layer_count()}")
        if not self.layer_name.layout().is_focused():
            self.layer_name.set_text(workspace.canvas.layer_name(workspace.selected))
        self.blend_menu.set_text(Canvas.blend_mode_name(workspace.canvas.layer_blend(workspace.selected)) + " ▾")
        self.visible_box.set_checked(workspace.canvas.layer_visible(workspace.selected))
        self.clipped_box.set_checked(workspace.canvas.layer_clipped(workspace.selected))
        self.mask_box.set_checked(workspace.canvas.layer_masked(workspace.selected))
        var styled = ""
        if workspace.canvas.layer_styled(workspace.selected):
            if workspace.style_value(0) != 0.0:
                styled = styled + "Shadow "
            if workspace.style_value(8) != 0.0:
                styled = styled + "Stroke "
            if workspace.style_value(14) != 0.0:
                styled = styled + "Glow"
        self.styles_text.set_text(styled if styled != "" else "None")
        var slot = 0
        for command in self.actions.tools:
            self.tool_buttons[slot].set_style(ButtonStyle.selected if command.id() == workspace.tool else ButtonStyle.sunken)
            slot += 1
        self.actions.update(workspace)
        self.layer_opacity.set_value(workspace.canvas.layer_opacity(workspace.selected) * 100.0)
        self.layer_opacity_field.set_value(workspace.canvas.layer_opacity(workspace.selected) * 100.0)
        self.layers.layout().invalidate()
        self.view.layout().invalidate()

    pub func close(self):
        self.cancel_prompt()
        self.settings_dialog.close()
        self.picker.close()
        if self.workspace.previewing():
            self.workspace.end_preview(false) catch failure:
                discard(failure)
        for connection in self.connections:
            connection.disconnect()
        self.connections.clear()
