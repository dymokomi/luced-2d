from ui import Font, Text, Button, VStack, HStack, Toolbar, SplitView, Size, TextPrompt, Spacer, Theme, Application, Menu, Command, Slider
from gpu import Color
from interop import Connection
from workspace import Workspace
from canvas import Canvas
from view import CanvasView
from layers import LayerList

## The window's contents, after Compositor's: a contextual tool header, a tool
## rail beside the canvas and the layers panel, and a status line. One text
## prompt stands in for the dialogs the desktop lacks.
pub class Panels:
    pub let body: VStack
    pub let view: CanvasView
    pub let workspace: Workspace
    pub let status: Text
    pub let prompt: TextPrompt
    pub let layers: LayerList
    pub let adjustments: list[Command]
    pub let blends: list[Command]
    pub let header_title: Text
    pub let header_hint: Text
    pub let size_slider: Slider
    pub let hardness_slider: Slider
    pub let opacity_slider: Slider
    pub let layer_opacity: Slider
    pub let brush_controls: HStack
    pub let layer_count: Text
    pub var app: Application? = none
    let font: Font
    let connections: list[Connection]
    var prompt_mode: str = ""

    pub func init(self, workspace: Workspace, font: Font) -> unit!:
        self.workspace = workspace
        self.font = font
        self.connections = []
        self.view = CanvasView(workspace)
        self.prompt = TextPrompt(font = font)
        self.layers = LayerList(workspace, font)
        self.status = Text("", font = font)
        # Adjustments and blend modes are commands, so menus and shortcuts share them.
        self.adjustments = [Command("Brightness / Contrast", id = "adjust_0"), Command("Hue / Saturation / Lightness", id = "adjust_1"),
                            Command("Invert", id = "adjust_2"), Command("Levels", id = "adjust_3"), Command("Desaturate", id = "adjust_4"),
                            Command("Threshold", id = "adjust_5"), Command("Posterize", id = "adjust_6")]
        var kind = 0
        for command in self.adjustments:
            let selected = kind
            self.connections.append(command.on_trigger(func () -> unit!:
                self.adjust(selected)))
            kind += 1
        self.blends = []
        var mode = 0
        while mode < Canvas.blend_mode_count():
            let chosen = mode
            let command = Command(Canvas.blend_mode_name(mode), id = f"blend_{mode}")
            self.connections.append(command.on_trigger(func () -> unit!:
                self.set_blend(chosen)))
            self.blends.append(command)
            mode += 1
        # The contextual header: what the active tool needs.
        self.header_title = Text("Brush", font = font)
        self.header_hint = Text("", font = font)
        self.size_slider = Slider("Size", 1.0, 500.0, workspace.diameter, 1.0, font = font)
        self.hardness_slider = Slider("Hardness", 0.0, 100.0, workspace.hardness * 100.0, 1.0, font = font)
        self.opacity_slider = Slider("Opacity", 1.0, 100.0, workspace.opacity * 100.0, 1.0, font = font)
        self.connections.append(self.size_slider.on_change(func (value: float) -> unit!:
            self.workspace.diameter = value
            self.workspace.touch()))
        self.connections.append(self.hardness_slider.on_change(func (value: float) -> unit!:
            self.workspace.hardness = value / 100.0
            self.workspace.touch()))
        self.connections.append(self.opacity_slider.on_change(func (value: float) -> unit!:
            self.workspace.opacity = value / 100.0
            self.workspace.touch()))
        self.brush_controls = HStack([self.size_slider, self.hardness_slider, self.opacity_slider,
                                      self.swatch("  ", 0.0, 0.0, 0.0), self.swatch("  ", 1.0, 1.0, 1.0), self.swatch("  ", 0.8069, 0.3515, 0.0497),
                                      self.swatch("  ", 0.02, 0.18, 0.65), self.swatch("  ", 0.75, 0.03, 0.02)], spacing = 12.0)
        self.header_title.layout().set_limits(Size(120.0, 0.0), Size(120.0, 16384.0))
        let menus = Toolbar([Menu("File", [self.command("New…", self.new_document), self.command("Open…", self.open_document),
                                           self.command("Save", self.save_document), self.command("Save As…", self.save_document_as)], font = font),
                             Menu("Edit", [self.command("Undo", self.undo), self.command("Redo", self.redo),
                                           self.command("Fill Selection with Colour", self.fill_selection), self.command("Clear Selection", self.clear_selection)], font = font),
                             Menu("Select", [self.command("All", self.select_all), self.command("Deselect", self.deselect)], font = font),
                             Menu("Image", self.adjustments, font = font),
                             Menu("Layer", [self.command("New Layer", self.add_layer), self.command("Delete Layer", self.delete_layer),
                                            self.command("Add / Remove Mask", self.toggle_mask), self.command("Edit Mask / Pixels", self.toggle_mask_editing),
                                            self.command("Clip to Below / Release", self.toggle_clipped), self.command("Hide / Show", self.toggle_visibility)], font = font),
                             Menu("View", [self.command("Fit", self.fit), self.command("Actual Size", self.actual_size),
                                           self.command("Zoom In", self.zoom_in), self.command("Zoom Out", self.zoom_out)], font = font),
                             Spacer(), self.header_hint], font = font)
        let header = Toolbar([self.header_title, self.brush_controls, Spacer()], font = font)
        # The tool rail: one button per tool.
        let rail = VStack([self.tool_button("M", "marquee"), self.tool_button("B", "brush"), self.tool_button("E", "eraser"), self.tool_button("H", "hand"), self.tool_button("Z", "zoom"),
                           Spacer(), self.button("Undo", self.undo), self.button("Redo", self.redo)], spacing = 6.0, padding = 6.0)
        rail.layout().set_limits(Size(56.0, 100.0), Size(56.0, 16384.0))
        rail.layout().set_flex(horizontal = 0.0)
        # The layers panel: appearance, the list, and the footer.
        self.layer_count = Text("", font = font)
        self.layer_opacity = Slider("Opacity", 0.0, 100.0, 100.0, 1.0, font = font)
        self.connections.append(self.layer_opacity.on_change(func (value: float) -> unit!:
            self.workspace.set_opacity(value / 100.0)
            self.layers.layout().invalidate()))
        let appearance = VStack([HStack([Text("Layers", font = font), Spacer(), self.layer_count], spacing = 8.0),
                                 HStack([Text("Blend", font = font), Menu("Choose ▾", self.blends, font = font), Spacer()], spacing = 8.0),
                                 self.layer_opacity], spacing = 6.0, padding = 10.0)
        let footer = HStack([self.button("+", self.add_layer), self.button("Mask", self.toggle_mask), self.button("Clip", self.toggle_clipped),
                             Spacer(), self.button("Delete", self.delete_layer)], spacing = 6.0, padding = 8.0)
        let layer_panel = VStack([appearance, self.layers, footer], spacing = 0.0)
        layer_panel.layout().set_limits(Size(252.0, 200.0), Size(352.0, 16384.0))
        let middle = HStack([rail, SplitView(self.view, layer_panel, fraction = 0.8)], spacing = 0.0)
        middle.layout().set_flex()
        self.body = VStack([menus, header, middle, Toolbar([self.status], font = font), self.prompt], spacing = 0.0)
        self.body.layout().set_flex()
        self.connections.append(self.prompt.on_submit(self.apply))
        self.refresh()

    func button(self, text: str, callback: func() -> unit!) -> Button!:
        let button = Button(text, font = self.font)
        self.connections.append(button.on_click(callback))
        return button

    func command(self, text: str, callback: func() -> unit!) -> Command!:
        let command = Command(text)
        self.connections.append(command.on_trigger(callback))
        return command

    func tool_button(self, text: str, tool: str) -> Button!:
        return self.button(text, func () -> unit!:
            self.choose_tool(tool))

    func swatch(self, text: str, red: float, green: float, blue: float) -> Button!:
        let button = self.button(text, func () -> unit!:
            self.workspace.set_color(red, green, blue)
            self.refresh())
        button.layout().set_theme(Theme(button = Color(red, green, blue), panel = Color(red, green, blue), pressed = Color(red, green, blue),
                                        foreground = Color(1.0, 1.0, 1.0) if red + green + blue < 1.2 else Color(0.0, 0.0, 0.0)))
        return button

    pub func choose_tool(self, tool: str) -> unit!:
        self.workspace.choose_tool(tool)
        self.refresh()

    pub func brush(self) -> unit!:
        self.choose_tool("brush")

    pub func eraser(self) -> unit!:
        self.choose_tool("eraser")

    pub func hand(self) -> unit!:
        self.choose_tool("hand")

    pub func marquee(self) -> unit!:
        self.choose_tool("marquee")

    pub func select_all(self) -> unit!:
        self.workspace.select_all()
        self.refresh()

    pub func deselect(self) -> unit!:
        self.workspace.deselect()
        self.refresh()

    pub func fill_selection(self) -> unit!:
        self.workspace.fill_selection(false)
        self.refresh()

    pub func clear_selection(self) -> unit!:
        self.workspace.fill_selection(true)
        self.refresh()

    pub func zoom_tool(self) -> unit!:
        self.choose_tool("zoom")

    func cancel_prompt(self):
        self.prompt_mode = ""
        self.prompt.layout().set_visible(false)

    func ask(self, mode: str, title: str, value: str, accept: str) -> unit!:
        self.prompt.open(title, value, accept = accept)
        self.prompt_mode = mode

    pub func new_document(self) -> unit!:
        self.ask("new", "New document size, width x height in pixels", f"{self.workspace.width()} x {self.workspace.height()}", "Create")

    pub func open_document(self) -> unit!:
        if let app = self.app:
            let chosen = app.open_file("Open a PNG, JPEG, TIFF or EXR picture") catch failure:
                self.ask("open", "Open a PNG, JPEG, TIFF or EXR file", self.workspace.path, "Open")
                return
            if chosen != "":
                self.workspace.open(chosen) catch failure:
                    self.ask("open", f"Could not open: {failure.message}", chosen, "Open")
                    return
                self.refresh()
            return
        self.ask("open", "Open a PNG, JPEG, TIFF or EXR file", self.workspace.path, "Open")

    pub func save_document(self) -> unit!:
        if self.workspace.path == "":
            self.save_document_as()
            return
        self.workspace.save(self.workspace.path)
        self.refresh()

    pub func save_document_as(self) -> unit!:
        if let app = self.app:
            let suggested = self.workspace.path if self.workspace.path != "" else "Untitled.png"
            let chosen = app.save_file("Save the flattened document; the extension picks the format", suggested) catch failure:
                self.ask("save", "Save the flattened document as (extension picks the format)", self.workspace.path, "Save")
                return
            if chosen != "":
                self.workspace.save(chosen) catch failure:
                    self.ask("save", f"Could not save: {failure.message}", chosen, "Save")
                    return
                self.refresh()
            return
        self.ask("save", "Save the flattened document as (extension picks the format)", self.workspace.path, "Save")

    ## Ask for an adjustment's parameters, or apply the ones that need none.
    pub func adjust(self, kind: int) -> unit!:
        if kind == 2 or kind == 4:
            self.workspace.adjust(kind, [])
            self.refresh()
            return
        var title = ""
        var value = ""
        if kind == 0:
            title = "Brightness and contrast, each -100..100"
            value = "0 0"
        elif kind == 1:
            title = "Hue shift in degrees, saturation and lightness -100..100"
            value = "0 0 0"
        elif kind == 3:
            title = "Levels: input black, input white (0..255), gamma, output black, output white (0..255)"
            value = "0 255 1.0 0 255"
        elif kind == 5:
            title = "Threshold level, 0..255"
            value = "128"
        elif kind == 6:
            title = "Posterize levels, 2..255"
            value = "4"
        self.ask(f"adjust {kind}", title, value, "Apply")

    func apply_adjustment(self, kind: int, text: str) -> bool!:
        var numbers: list[float] = []
        for part in text.split(" "):
            let piece = part.trim()
            if piece == "":
                continue
            let number = float(piece) catch failure:
                return false
            numbers.append(number)
        var values: list[float] = []
        if kind == 0:
            if numbers.length != 2:
                return false
            values = [numbers[0] / 100.0, numbers[1] / 100.0]
        elif kind == 1:
            if numbers.length != 3:
                return false
            values = [numbers[0] / 360.0, numbers[1] / 100.0, numbers[2] / 100.0]
        elif kind == 3:
            if numbers.length != 5:
                return false
            values = [numbers[0] / 255.0, numbers[1] / 255.0, numbers[2], numbers[3] / 255.0, numbers[4] / 255.0]
        elif kind == 5:
            if numbers.length != 1:
                return false
            values = [numbers[0] / 255.0]
        elif kind == 6:
            if numbers.length != 1:
                return false
            values = [numbers[0]]
        self.workspace.adjust(kind, values)
        return true

    pub func fit(self) -> unit!:
        self.workspace.fitted = false
        self.refresh()

    pub func actual_size(self) -> unit!:
        let bounds = self.view.layout().bounds()
        self.workspace.actual_size(bounds.width, bounds.height)
        self.refresh()

    pub func zoom_in(self) -> unit!:
        self.zoom_by(2.0)

    pub func zoom_out(self) -> unit!:
        self.zoom_by(0.5)

    func zoom_by(self, factor: float) -> unit!:
        let bounds = self.view.layout().bounds()
        self.workspace.zoom_about(factor, bounds.width * 0.5, bounds.height * 0.5)
        self.refresh()

    pub func undo(self) -> unit!:
        self.workspace.undo()
        self.refresh()

    pub func redo(self) -> unit!:
        self.workspace.redo()
        self.refresh()

    pub func bigger(self) -> unit!:
        self.workspace.scale_brush(1.25)
        self.refresh()

    pub func smaller(self) -> unit!:
        self.workspace.scale_brush(0.8)
        self.refresh()

    pub func add_layer(self) -> unit!:
        self.workspace.add_layer()
        self.refresh()

    pub func delete_layer(self) -> unit!:
        self.workspace.delete_layer()
        self.refresh()

    pub func toggle_visibility(self) -> unit!:
        self.workspace.toggle_visibility()
        self.refresh()

    pub func set_blend(self, mode: int) -> unit!:
        let workspace = self.workspace
        workspace.canvas.set_layer(workspace.selected_id(), workspace.canvas.layer_visible(workspace.selected), workspace.canvas.layer_opacity(workspace.selected), mode)
        workspace.touch()
        self.refresh()

    pub func cycle_blend(self, step: int) -> unit!:
        self.workspace.cycle_blend(step)
        self.refresh()

    pub func toggle_mask(self) -> unit!:
        self.workspace.toggle_mask()
        self.refresh()

    pub func toggle_mask_editing(self) -> unit!:
        self.workspace.toggle_mask_editing()
        self.refresh()

    pub func toggle_clipped(self) -> unit!:
        self.workspace.toggle_clipped()
        self.refresh()

    pub func select_layer(self, index: int) -> unit!:
        self.workspace.select(index)
        self.refresh()

    func reject(self, text: str, message: str) -> unit!:
        self.prompt.open(message, text, accept = "Retry")

    pub func apply(self, text: str) -> unit!:
        let mode = self.prompt_mode
        let trimmed = text.trim()
        if mode == "":
            return
        if mode == "open":
            self.workspace.open(trimmed) catch failure:
                self.reject(text, f"Could not open: {failure.message}")
                return
        elif mode == "save":
            if trimmed == "":
                self.reject(text, "Enter a file name with an extension")
                return
            self.workspace.save(trimmed) catch failure:
                self.reject(text, f"Could not save: {failure.message}")
                return
        elif mode == "new":
            let parts = trimmed.split("x")
            if parts.length != 2:
                self.reject(text, "Enter a size like 1920 x 1080")
                return
            let width = int(parts[0].trim()) catch failure:
                self.reject(text, "Enter a size like 1920 x 1080")
                return
            let height = int(parts[1].trim()) catch failure:
                self.reject(text, "Enter a size like 1920 x 1080")
                return
            if width < 1 or height < 1 or width > 16384 or height > 16384:
                self.reject(text, "Each side must be 1..16384 pixels")
                return
            self.workspace.create(width, height)
        elif mode.length > 7 and mode[..<7] == "adjust ":
            let kind = int(mode[7..]) catch failure:
                return
            let applied = self.apply_adjustment(kind, trimmed) catch failure:
                self.reject(text, f"Could not adjust: {failure.message}")
                return
            if not applied:
                self.reject(text, "Enter the numbers the title asks for, separated by spaces")
                return
        self.cancel_prompt()
        self.refresh()

    pub func refresh(self) -> unit!:
        let workspace = self.workspace
        let name = workspace.path if workspace.path != "" else "Untitled"
        let percent = int(workspace.zoom * 100.0 + 0.5)
        var tool = workspace.tool_name()
        if workspace.canvas.editing_mask() and (workspace.tool == "brush" or workspace.tool == "eraser"):
            tool = tool + " on mask"
        self.header_title.set_text(tool)
        self.brush_controls.layout().set_visible(workspace.tool == "brush" or workspace.tool == "eraser")
        self.size_slider.set_value(workspace.diameter)
        self.hardness_slider.set_value(workspace.hardness * 100.0)
        self.opacity_slider.set_value(workspace.opacity * 100.0)
        var hint = "Drag to paint · [ ] size · Space to pan · scroll pans, cmd-scroll zooms"
        if workspace.tool == "marquee":
            hint = "Drag to select · cmd-A all · cmd-D deselect · Delete clears"
        elif workspace.tool == "hand":
            hint = "Drag to pan"
        elif workspace.tool == "zoom":
            hint = "Click to zoom in · alt-click to zoom out"
        self.header_hint.set_text(hint)
        self.status.set_text(f"{percent}%  |  {workspace.width()} × {workspace.height()} px  |  sRGB · Transparent  |  {name}")
        self.layer_count.set_text(f"{workspace.layer_count()}")
        self.layer_opacity.set_value(workspace.canvas.layer_opacity(workspace.selected) * 100.0)
        self.layers.layout().invalidate()
        self.view.layout().invalidate()

    pub func close(self):
        self.cancel_prompt()
        for connection in self.connections:
            connection.disconnect()
        self.connections.clear()
