from ui import Widget, Layout, Size, Constraints, Event, Painter, Image, Point
from gpu import RenderTarget, Rect, Region, Filter
from input import EventKind, Cursor, Key, ScrollUnit
from workspace import Workspace
import theme
import math

## The document on screen: backdrop, checkerboard under transparent pixels,
## the flattened document at the workspace's zoom and offset, and a hairline
## around it drawn at screen resolution. Scroll pans; scroll with the primary
## modifier zooms about the pointer; space or the middle button drags.
pub class CanvasView: Widget:
    let box: Layout
    pub let workspace: Workspace
    ## Called when the text tool clicks, after the position is remembered.
    pub var on_text: func() -> unit!? = none
    var dragging: bool = false
    var painting: bool = false
    ## A gradient drag in progress, from a document point.
    var gradient_dragging: bool = false
    var gradient_x: float = 0.0
    var gradient_y: float = 0.0
    var last_x: float = 0.0
    var last_y: float = 0.0
    var pointer_x: float = 0.0
    var pointer_y: float = 0.0
    var pointer_inside: bool = false
    var space_held: bool = false
    var selecting: bool = false
    var select_mode: int = 0
    var lasso: bool = false
    var lasso_points: int = 0
    var lasso_last_x: float = 0.0
    var lasso_last_y: float = 0.0
    var moving: bool = false
    var move_x: float = 0.0
    var move_y: float = 0.0
    var move_now_x: float = 0.0
    var move_now_y: float = 0.0
    var select_x: float = 0.0
    var select_y: float = 0.0
    var select_now_x: float = 0.0
    var select_now_y: float = 0.0
    var ants: float = 0.0
    let checker: Image

    pub func init(self, workspace: Workspace) -> unit!:
        self.workspace = workspace
        self.checker = Image(256, 256)
        for y in 0..<256:
            for x in 0..<256:
                self.checker.set_pixel(x, y, theme.checker_dark() if (x // 8 + y // 8) % 2 == 1 else theme.checker_light())
        self.box = Layout()
        self.box.set_focusable(true)
        self.box.set_cursor(Cursor.arrow)
        self.box.set_flex()
        self.box.set_limits(Size(200.0, 160.0), Size(16384.0, 16384.0))

    pub func layout(self) -> Layout:
        return self.box

    pub func measure(self, available: Constraints) -> Size!:
        return Size(900.0, 700.0)

    pub func draw(self, target: RenderTarget) -> unit!:
        let painter = Painter(target)
        let size = target.size()
        if not self.workspace.fitted:
            self.workspace.fit(size.width, size.height)
        painter.rectangle(Rect(0.0, 0.0, size.width, size.height), theme.backdrop())
        let workspace = self.workspace
        let left = workspace.offset_x
        let top = workspace.offset_y
        let width = float(workspace.width()) * workspace.zoom
        let height = float(workspace.height()) * workspace.zoom
        # The checkerboard only where the document is, clipped to the view: one
        # 256-point picture of 8-point cells per block, not one rectangle per cell.
        let x0 = math.max(0.0, left)
        let y0 = math.max(0.0, top)
        let x1 = math.min(size.width, left + width)
        let y1 = math.min(size.height, top + height)
        if x1 > x0 and y1 > y0:
            let block = 256.0
            var y = y0 - math.mod(y0 - top, block)
            while y < y1:
                var x = x0 - math.mod(x0 - left, block)
                while x < x1:
                    let cx = math.max(x, x0)
                    let cy = math.max(y, y0)
                    let cw = math.min(x + block, x1) - cx
                    let ch = math.min(y + block, y1) - cy
                    painter.image(self.checker, Rect(cx, cy, cw, ch), Region(int(cx - x), int(cy - y), int(cw), int(ch)), 1.0, Filter.nearest)
                    x += block
                y += block
            if self.moving:
                let dx = (self.move_now_x - self.move_x) / workspace.zoom
                let dy = (self.move_now_y - self.move_y) / workspace.zoom
                workspace.canvas.draw_moving(target, Rect(0.0, 0.0, size.width, size.height), workspace.zoom, left, top, workspace.selected_id(), dx, dy)
            else:
                workspace.canvas.draw(target, Rect(0.0, 0.0, size.width, size.height), workspace.zoom, left, top)
            painter.rectangle(Rect(x0, y0, x1 - x0, 1.0), theme.border())
            painter.rectangle(Rect(x0, y1 - 1.0, x1 - x0, 1.0), theme.border())
            painter.rectangle(Rect(x0, y0, 1.0, y1 - y0), theme.border())
            painter.rectangle(Rect(x1 - 1.0, y0, 1.0, y1 - y0), theme.border())
        # Marching ants along the selection's edge, at screen resolution; while a
        # shape is being dragged its outline is drawn plainly.
        if workspace.canvas.has_selection():
            workspace.canvas.draw_selection(target, Rect(0.0, 0.0, size.width, size.height), workspace.zoom, left, top, self.ants)
        if self.selecting and not self.lasso:
            let sx0 = math.min(self.select_x, self.select_now_x) * workspace.zoom + left
            let sy0 = math.min(self.select_y, self.select_now_y) * workspace.zoom + top
            let sx1 = math.max(self.select_x, self.select_now_x) * workspace.zoom + left
            let sy1 = math.max(self.select_y, self.select_now_y) * workspace.zoom + top
            painter.rectangle(Rect(sx0, sy0, sx1 - sx0, 1.0), theme.text())
            painter.rectangle(Rect(sx0, sy1 - 1.0, sx1 - sx0, 1.0), theme.text())
            painter.rectangle(Rect(sx0, sy0, 1.0, sy1 - sy0), theme.text())
            painter.rectangle(Rect(sx1 - 1.0, sy0, 1.0, sy1 - sy0), theme.text())
        if self.pointer_inside and not self.dragging and (workspace.tool == "brush" or workspace.tool == "eraser"):
            # The brush outline, at screen resolution, one dark and one light ring.
            let radius = workspace.diameter * workspace.zoom * 0.5
            let segments = 48
            var index = 0
            while index < segments:
                let angle = float(index) * 6.283185307 / float(segments)
                let next = float(index + 1) * 6.283185307 / float(segments)
                let a = Point(self.pointer_x + math.cos(angle) * radius, self.pointer_y + math.sin(angle) * radius)
                let b = Point(self.pointer_x + math.cos(next) * radius, self.pointer_y + math.sin(next) * radius)
                painter.line(a, b, 3.0, theme.backdrop())
                painter.line(a, b, 1.0, theme.text())
                index += 1
        painter.close()

    ## Advance the marching ants; called from the frame timer.
    pub func march(self):
        if self.workspace.canvas.has_selection():
            self.ants += 1.0
            self.box.invalidate()

    ## Document coordinates of a view point.
    func document_x(self, x: float) -> float:
        return (x - self.workspace.offset_x) / self.workspace.zoom

    func document_y(self, y: float) -> float:
        return (y - self.workspace.offset_y) / self.workspace.zoom

    pub func event(self, event: Event) -> unit!:
        if event.cancelled:
            self.dragging = false
            if self.painting:
                self.painting = false
                self.workspace.end_stroke()
            self.pointer_inside = false
            self.box.invalidate()
            return
        if event.kind == EventKind.key_down and self.workspace.tool == "move" and (event.key == Key.left or event.key == Key.right or event.key == Key.up or event.key == Key.down):
            let step = 10 if event.shift else 1
            let dx = -step if event.key == Key.left else (step if event.key == Key.right else 0)
            let dy = -step if event.key == Key.up else (step if event.key == Key.down else 0)
            self.workspace.move_layer(dx, dy)
        elif event.kind == EventKind.key_down and event.key == Key.space:
            self.space_held = true
        elif event.kind == EventKind.key_up and event.key == Key.space:
            self.space_held = false
            self.dragging = false
        elif event.kind == EventKind.magnify:
            # A touchpad pinch: the magnification change, about the pointer.
            self.workspace.zoom_about(1.0 + event.scroll_y, event.x, event.y)
        elif event.kind == EventKind.scroll:
            if event.scroll_unit == ScrollUnit.lines or event.meta or event.control:
                # A notched mouse wheel zooms about the pointer; so does any scroll with cmd/ctrl held.
                let step = 1.0 if event.scroll_unit == ScrollUnit.points else 24.0
                let factor = math.pow(1.0025, event.scroll_y * step)
                self.workspace.zoom_about(factor, event.x, event.y)
            else:
                # Precise touchpad scrolling pans.
                self.workspace.pan(event.scroll_x, event.scroll_y)
        elif event.kind == EventKind.pointer_down and event.inside and (event.button == 2 or (event.button == 0 and (self.space_held or self.workspace.tool == "hand"))):
            self.dragging = true
            self.last_x = event.x
            self.last_y = event.y
        elif event.kind == EventKind.pointer_down and event.inside and event.button == 0 and self.workspace.tool == "zoom":
            self.workspace.zoom_about(0.5 if event.alt else 2.0, event.x, event.y)
        elif event.kind == EventKind.pointer_down and event.inside and event.button == 0 and self.workspace.tool == "move":
            self.moving = true
            self.move_x = event.x
            self.move_y = event.y
            self.move_now_x = event.x
            self.move_now_y = event.y
        elif event.kind == EventKind.pointer_down and event.inside and event.button == 0 and self.workspace.tool == "gradient":
            self.gradient_dragging = true
            self.gradient_x = self.document_x(event.x)
            self.gradient_y = self.document_y(event.y)
        elif event.kind == EventKind.pointer_up and event.button == 0 and self.gradient_dragging:
            self.gradient_dragging = false
            let x1 = self.document_x(event.x)
            let y1 = self.document_y(event.y)
            if math.abs(x1 - self.gradient_x) + math.abs(y1 - self.gradient_y) >= 1.0:
                self.workspace.fill_gradient(self.gradient_x, self.gradient_y, x1, y1)
        elif event.kind == EventKind.pointer_down and event.inside and event.button == 0 and (self.workspace.tool == "eyedropper" or self.workspace.sampling):
            self.workspace.pick(self.document_x(event.x), self.document_y(event.y))
        elif event.kind == EventKind.pointer_down and event.inside and event.button == 0 and self.workspace.tool == "text":
            self.workspace.text_x = self.document_x(event.x)
            self.workspace.text_y = self.document_y(event.y)
            if let place = self.on_text:
                place()
        elif event.kind == EventKind.pointer_down and event.inside and event.button == 0 and self.workspace.tool == "wand":
            self.workspace.select_wand(self.document_x(event.x), self.document_y(event.y), 1 if event.shift else (2 if event.alt else 0))
        elif event.kind == EventKind.pointer_down and event.inside and event.button == 0 and (self.workspace.tool == "marquee" or self.workspace.tool == "ellipse" or self.workspace.tool == "lasso"):
            self.selecting = true
            self.lasso = self.workspace.tool == "lasso"
            self.select_mode = 1 if event.shift else (2 if event.alt else 0)
            self.select_x = self.document_x(event.x)
            self.select_y = self.document_y(event.y)
            self.select_now_x = self.select_x
            self.select_now_y = self.select_y
            if self.lasso:
                self.workspace.canvas.clear_points()
                self.workspace.canvas.add_point(self.select_x, self.select_y)
                self.lasso_points = 1
                self.lasso_last_x = self.select_x
                self.lasso_last_y = self.select_y
            elif self.select_mode == 0:
                self.workspace.deselect()
        elif event.kind == EventKind.pointer_down and event.inside and event.button == 0:
            self.workspace.begin_stroke(self.document_x(event.x), self.document_y(event.y), event.pressure)
            self.painting = self.workspace.canvas.painting()
        elif event.kind == EventKind.pointer_moved:
            self.pointer_x = event.x
            self.pointer_y = event.y
            self.pointer_inside = event.inside
            if self.dragging:
                self.workspace.pan(event.x - self.last_x, event.y - self.last_y)
                self.last_x = event.x
                self.last_y = event.y
            elif self.painting:
                self.workspace.extend_stroke(self.document_x(event.x), self.document_y(event.y), event.pressure)
            elif self.selecting:
                self.select_now_x = self.document_x(event.x)
                self.select_now_y = self.document_y(event.y)
                if self.lasso:
                    let dx = self.select_now_x - self.lasso_last_x
                    let dy = self.select_now_y - self.lasso_last_y
                    if dx * dx + dy * dy >= 4.0:
                        self.workspace.canvas.add_point(self.select_now_x, self.select_now_y)
                        self.lasso_points += 1
                        self.lasso_last_x = self.select_now_x
                        self.lasso_last_y = self.select_now_y
            elif self.moving:
                self.move_now_x = event.x
                self.move_now_y = event.y
        elif event.kind == EventKind.pointer_up:
            self.dragging = false
            if self.moving:
                # The move previews while dragging and commits once, on release.
                self.moving = false
                let dx = int(math.floor((event.x - self.move_x) / self.workspace.zoom + 0.5))
                let dy = int(math.floor((event.y - self.move_y) / self.workspace.zoom + 0.5))
                self.workspace.move_layer(dx, dy)
            if self.selecting:
                self.selecting = false
                if self.lasso:
                    if self.lasso_points >= 3:
                        self.workspace.canvas.select_polygon(self.select_mode)
                        self.workspace.touch()
                    else:
                        self.workspace.canvas.clear_points()
                else:
                    self.workspace.select_shape(self.select_x, self.select_y, self.document_x(event.x), self.document_y(event.y), self.workspace.tool == "ellipse", self.select_mode)
            if self.painting:
                self.painting = false
                self.workspace.extend_stroke(self.document_x(event.x), self.document_y(event.y), event.pressure)
                self.workspace.end_stroke()
        elif event.kind == EventKind.pointer_left:
            self.pointer_inside = false
        self.box.invalidate()
