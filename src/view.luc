## The canvas view: it draws the document at the workspace's zoom and offset,
## and turns pointer, key and scroll input into what the active tool does —
## painting, selecting, moving, zooming and panning.
from ui import Widget, Layout, Size, Constraints, Event, Painter, Image, Point
from gpu import RenderTarget, Rect, Region, Filter, Color
from input import EventKind, Cursor, Key, ScrollUnit
from workspace import Workspace
from selection_drag import SelectionDrag, mode_of
from kit import outline, dropped_paths
from transform_box import grab_move
import theme
import math
import time

## The document on screen: backdrop, checkerboard under transparent pixels,
## the flattened document at the workspace's zoom and offset, and a hairline
## around it drawn at screen resolution. Touchpad scrolling pans; a mouse
## wheel, or scrolling with the primary modifier, zooms about the pointer; a
## pinch zooms; space or the middle button drags.
pub class CanvasView: Widget:
    let box: Layout
    pub let workspace: Workspace
    ## Called when the text tool clicks, after the position is remembered.
    pub var on_text: func() -> unit!? = none
    ## Files dropped on the canvas: the ones luced-2d can open.
    pub var on_open_files: func(list[str]) -> unit!? = none
    ## A key let go over the canvas, for spring-loaded tools.
    pub var on_key_up: func(Key) -> unit!? = none
    ## Something the window shows changed from the keyboard (an opacity by digit).
    pub var on_changed: func() -> unit!? = none
    ## Something a press could not do, said to the user: painting on a group.
    pub var on_refused: func(str) -> unit!? = none
    pub var pointer_x: float = 0.0
    pub var pointer_y: float = 0.0
    pub var pointer_inside: bool = false
    ## Layouts that show the pointer (the rulers), redrawn with the view.
    pub var linked: list[Layout]
    ## Panning: by the hand tool, space held, or the middle button.
    var panning: bool = false
    var space_held: bool = false
    var last_x: float = 0.0
    var last_y: float = 0.0
    var painting: bool = false
    ## Where the last stroke ended, in document pixels, for Shift-click lines.
    var stroke_end_x: float = 0.0
    var stroke_end_y: float = 0.0
    var has_stroke_end: bool = false
    ## A Shift-drag stroke keeps to the axis it first moves along: 0 not yet
    ## chosen, 1 horizontal, 2 vertical; -1 when Shift was not held.
    var axis: int = -1
    var stroke_x: float = 0.0
    var stroke_y: float = 0.0
    ## The last digit typed and when, so two quick digits give an exact opacity.
    var digit: int = -1
    var digit_at: int = 0
    let selection: SelectionDrag
    ## A gradient drag in progress, from a document point.
    var gradient_dragging: bool = false
    var gradient_x: float = 0.0
    var gradient_y: float = 0.0
    ## A move drag: it previews while dragging and commits once, on release —
    ## the whole layer, or with a selection its selected pixels (copied with
    ## Alt), shown through a canvas preview.
    var moving: bool = false
    var move_pixels: bool = false
    var move_copy: bool = false
    var move_shown_x: int = 0
    var move_shown_y: int = 0
    ## A selection tool dragging inside the selection moves its outline; the
    ## whole pixels applied so far.
    var outline_moving: bool = false
    var outline_x: float = 0.0
    var outline_y: float = 0.0
    var outline_applied_x: int = 0
    var outline_applied_y: int = 0
    var move_x: float = 0.0
    var move_y: float = 0.0
    var move_now_x: float = 0.0
    var move_now_y: float = 0.0
    ## A free transform's or the Crop tool's box being dragged.
    var boxing: bool = false
    ## A zoom tool drag: right zooms in, left out, about where it started.
    var zooming: bool = false
    var zoom_moved: bool = false
    var zoom_out: bool = false
    var zoom_x: float = 0.0
    var zoom_y: float = 0.0
    var zoom_start: float = 1.0
    var ants: float = 0.0
    let checker: Image

    pub func init(self, workspace: Workspace) -> unit!:
        self.workspace = workspace
        self.selection = SelectionDrag()
        self.checker = Image(256, 256)
        for y in 0..<256:
            for x in 0..<256:
                self.checker.set_pixel(x, y, theme.checker_dark() if (x // 8 + y // 8) % 2 == 1 else theme.checker_light())
        self.box = Layout()
        self.box.set_focusable(true)
        self.box.set_cursor(Cursor.arrow)
        self.box.set_flex()
        self.box.set_limits(Size(200.0, 160.0), Size(16384.0, 16384.0))
        # Pictures and documents dropped on the canvas open, each in its own tab.
        self.box.set_drop_target(true)
        self.linked = []

    pub func layout(self) -> Layout:
        return self.box

    pub func measure(self, available: Constraints) -> Size!:
        return Size(900.0, 700.0)

    # -- Drawing.

    pub func draw(self, target: RenderTarget) -> unit!:
        let painter = Painter(target)
        let size = target.size()
        let workspace = self.workspace
        if not workspace.fitted:
            workspace.fit(size.width, size.height)
        painter.rectangle(Rect(0.0, 0.0, size.width, size.height), theme.backdrop())
        let left = workspace.offset_x
        let top = workspace.offset_y
        let whole = Rect(0.0, 0.0, size.width, size.height)
        # The document's part of the view.
        let x0 = math.max(0.0, left)
        let y0 = math.max(0.0, top)
        let x1 = math.min(size.width, left + float(workspace.width()) * workspace.zoom)
        let y1 = math.min(size.height, top + float(workspace.height()) * workspace.zoom)
        if x1 > x0 and y1 > y0:
            self.draw_checker(painter, x0, y0, x1, y1)
            if self.moving and not self.move_pixels:
                let dx = (self.move_now_x - self.move_x) / workspace.zoom
                let dy = (self.move_now_y - self.move_y) / workspace.zoom
                workspace.canvas.draw_moving(target, whole, workspace.zoom, left, top, workspace.selected_id(), dx, dy)
            else:
                workspace.canvas.draw(target, whole, workspace.zoom, left, top)
            if workspace.show_grid:
                self.draw_grid(painter, x0, y0, x1, y1)
            outline(painter, Rect(x0, y0, x1 - x0, y1 - y0), theme.border())
        # Marching ants along the selection's edge, at screen resolution, moving
        # with selected pixels being dragged; while a shape is being dragged its
        # outline is drawn plainly.
        if workspace.canvas.has_selection():
            var ants_left = left
            var ants_top = top
            if self.moving and self.move_pixels:
                ants_left += float(self.move_shown_x) * workspace.zoom
                ants_top += float(self.move_shown_y) * workspace.zoom
            workspace.canvas.draw_selection(target, whole, workspace.zoom, ants_left, ants_top, self.ants)
        self.selection.draw(painter, workspace.zoom, left, top, theme.text())
        self.draw_box(painter, size.width, size.height)
        if self.pointer_inside and not self.panning and brushed(workspace.tool):
            self.draw_brush_outline(painter)
            if workspace.tool == "clone" and workspace.canvas.has_clone_source():
                self.draw_clone_source(painter)
        painter.close()

    ## The checkerboard under the document's part of the view, clipped to it:
    ## one 256-point picture of 8-point cells per block, not a rectangle per cell.
    func draw_checker(self, painter: Painter, x0: float, y0: float, x1: float, y1: float) -> unit!:
        let left = self.workspace.offset_x
        let top = self.workspace.offset_y
        let block = 256.0
        var y = y0 - math.mod(y0 - top, block)
        while y < y1:
            var x = x0 - math.mod(x0 - left, block)
            while x < x1:
                let cx = math.max(x, x0)
                let cy = math.max(y, y0)
                let cw = math.min(x + block, x1) - cx
                let ch = math.min(y + block, y1) - cy
                # The block's texels this piece covers: whole texels, inside the
                # 256-texel tile, at least one wide. Fractional offsets (a pan, a
                # zoom) otherwise round a sliver to nothing or past the tile.
                let sx = clamp_texel(int(math.floor(cx - x)))
                let sy = clamp_texel(int(math.floor(cy - y)))
                let sw = texel_span(sx, int(math.ceil(cx + cw - x)))
                let sh = texel_span(sy, int(math.ceil(cy + ch - y)))
                if cw > 0.0 and ch > 0.0:
                    painter.image(self.checker, Rect(cx, cy, cw, ch), Region(sx, sy, sw, sh), 1.0, Filter.nearest)
                x += block
            y += block

    ## The brush's outline around the pointer, at screen resolution, one dark and one light ring.
    func draw_brush_outline(self, painter: Painter) -> unit!:
        let radius = self.workspace.brush.diameter * self.workspace.zoom * 0.5
        let segments = 48
        var index = 0
        while index < segments:
            let angle = float(index) * 6.283185307 / float(segments)
            let next = float(index + 1) * 6.283185307 / float(segments)
            let a = Point(self.pointer_x + math.cos(angle) * radius, self.pointer_y + math.sin(angle) * radius)
            let b = Point(self.pointer_x + math.cos(next) * radius, self.pointer_y + math.sin(next) * radius)
            painter.line(a, b, 3.0, theme.backdrop())
            painter.line(a, b, 1.0, theme.text())
            index += 1

    ## The Clone Stamp's source: a crosshair where a stroke from the pointer
    ## would copy from, white under black as Compositor's.
    func draw_clone_source(self, painter: Painter) -> unit!:
        let workspace = self.workspace
        let canvas = workspace.canvas
        let x = canvas.clone_sample_x(self.document_x(self.pointer_x)) * workspace.zoom + workspace.offset_x
        let y = canvas.clone_sample_y(self.document_y(self.pointer_y)) * workspace.zoom + workspace.offset_y
        for width in [3.0, 1.0]:
            let ink = theme.text() if width == 3.0 else theme.backdrop()
            painter.line(Point(x - 7.0, y), Point(x + 7.0, y), width, ink)
            painter.line(Point(x, y - 7.0), Point(x, y + 7.0), width, ink)

    ## The grid over the document: majors every grid_major document pixels, their
    ## subdivisions fainter; a level whose lines would crowd closer than a few
    ## points on screen is left out.
    func draw_grid(self, painter: Painter, x0: float, y0: float, x1: float, y1: float) -> unit!:
        let workspace = self.workspace
        let major = workspace.grid_major() * workspace.zoom
        let minor = major / float(workspace.grid_divisions())
        if minor >= 6.0:
            self.grid_lines(painter, minor, x0, y0, x1, y1, Color(1.0, 1.0, 1.0), 0.10)
        if major >= 8.0:
            self.grid_lines(painter, major, x0, y0, x1, y1, Color(1.0, 1.0, 1.0), 0.32)

    func grid_lines(self, painter: Painter, step: float, x0: float, y0: float, x1: float, y1: float, ink: Color, opacity: float) -> unit!:
        let left = self.workspace.offset_x
        let top = self.workspace.offset_y
        var x = left + math.ceil((x0 - left) / step) * step
        while x <= x1:
            painter.rectangle(Rect(math.floor(x), y0, 1.0, y1 - y0), ink, opacity)
            x += step
        var y = top + math.ceil((y0 - top) / step) * step
        while y <= y1:
            painter.rectangle(Rect(x0, math.floor(y), x1 - x0, 1.0), ink, opacity)
            y += step

    ## Advance the marching ants; called from the frame timer.
    pub func march(self):
        if self.workspace.canvas.has_selection():
            self.ants += 1.0
            self.box.invalidate()

    ## Document coordinates of a view point.
    func document_x(self, x: float) -> float:
        return (x - self.workspace.offset_x) / self.workspace.zoom

    func document_y(self, y: float) -> float:
        return (y - self.workspace.offset_y) / self.workspace.zoom

    # -- Input.

    pub func event(self, event: Event) -> unit!:
        let kind = event.kind
        if kind == EventKind.drag_entered:
            self.box.set_drop_accepted(dropped_paths(self.box, self.workspace.can_open).length > 0)
            return
        if kind == EventKind.drop:
            let files = dropped_paths(self.box, self.workspace.can_open)
            if let open = self.on_open_files:
                open(files)
            return
        if kind == EventKind.drag_moved or kind == EventKind.drag_left:
            return
        if event.cancelled:
            self.cancel()
        elif kind == EventKind.key_down or kind == EventKind.key_up or kind == EventKind.modifiers_changed:
            self.key(event)
        elif kind == EventKind.scroll or kind == EventKind.magnify:
            self.scroll(event)
        elif kind == EventKind.pointer_down and event.inside:
            self.press(event)
        elif kind == EventKind.pointer_moved:
            self.pointer_x = event.x
            self.pointer_y = event.y
            self.pointer_inside = event.inside
            self.drag(event)
        elif kind == EventKind.pointer_up:
            self.release(event)
        elif kind == EventKind.pointer_left:
            self.pointer_inside = false
        self.box.invalidate()
        for linked in self.linked:
            linked.invalidate()

    ## The view lost the pointer mid-gesture: end what is in progress.
    func cancel(self) -> unit!:
        self.panning = false
        if self.painting:
            self.painting = false
            self.workspace.end_stroke()
        self.pointer_inside = false

    func key(self, event: Event) -> unit!:
        if event.kind == EventKind.key_down:
            if event.key == Key.space:
                self.space_held = true
            elif event.key == Key.escape and self.painting:
                # Esc drops the stroke in progress.
                self.painting = false
                self.workspace.cancel_stroke()
            elif (event.key == Key.enter or event.key == Key.escape) and not self.boxing and (self.workspace.transform != none or self.workspace.crop_box != none):
                # Enter applies a free transform or crops; Esc drops it.
                if self.workspace.transform != none:
                    self.workspace.finish_transform(event.key == Key.enter)
                else:
                    self.workspace.finish_crop(event.key == Key.enter)
                if let changed = self.on_changed:
                    changed()
            elif not event.meta and not event.control and not event.repeated and digit_value(event.key) >= 0:
                self.type_digit(digit_value(event.key))
            elif event.key == Key.left or event.key == Key.right or event.key == Key.up or event.key == Key.down:
                self.nudge(event)
        elif event.kind == EventKind.key_up:
            if event.key == Key.space:
                self.space_held = false
                self.panning = false
            elif let released = self.on_key_up:
                released(event.key)
        else:
            # Shift or alt pressed or let go mid-drag reshapes the marquee at once.
            self.selection.modifiers(event.shift, event.alt)

    func scroll(self, event: Event) -> unit!:
        if event.kind == EventKind.magnify:
            # A touchpad pinch: the magnification change, about the pointer.
            self.workspace.zoom_about(1.0 + event.scroll_y, event.x, event.y)
        elif event.scroll_unit == ScrollUnit.lines or event.meta or event.control or event.alt:
            # A notched mouse wheel zooms about the pointer; so does any scroll with cmd, ctrl or alt held.
            let step = 1.0 if event.scroll_unit == ScrollUnit.points else 24.0
            self.workspace.zoom_about(math.pow(1.0025, event.scroll_y * step), event.x, event.y)
        else:
            # Precise touchpad scrolling pans.
            self.workspace.pan(event.scroll_x, event.scroll_y)

    ## A press on the canvas starts what the active tool does.
    func press(self, event: Event) -> unit!:
        let workspace = self.workspace
        let tool = workspace.tool
        if event.button == 0 and not self.space_held:
            # A tool used while its key is held springs back when the key is let go.
            workspace.tool_used = true
        if event.button == 2 or (event.button == 0 and (self.space_held or tool == "hand")):
            self.panning = true
            self.last_x = event.x
            self.last_y = event.y
            return
        if event.button != 0:
            return
        let x = self.document_x(event.x)
        let y = self.document_y(event.y)
        # A free transform or the Crop tool's box takes presses while it is up;
        # handles answer within 6 points whatever the zoom.
        let reach = 6.0 / workspace.zoom
        if let session = workspace.transform:
            let grab = session.box.hit(x, y, reach)
            # Alt-dragging inside moves a copy, the original left in place.
            if grab == grab_move and event.alt:
                workspace.duplicate_in_transform()
            if let carried = workspace.transform:
                carried.box.begin(grab, x, y)
            self.boxing = true
            return
        if let crop = workspace.crop_box:
            crop.begin(crop.hit(x, y, reach), x, y)
            self.boxing = true
            return
        # Cmd (Ctrl) held makes most tools the Move tool for the drag, as in Photoshop.
        let temporary_move = (event.meta or event.control) and tool != "hand" and tool != "zoom"
        let selecting_tool = tool == "marquee" or tool == "ellipse" or tool == "lasso" or tool == "wand"
        # With Show Transform Controls a handle starts a free transform.
        if tool == "move" and not temporary_move:
            if let shown = workspace.controls_box():
                let grab = shown.hit(x, y, reach)
                if grab >= 0 and grab < 8 and workspace.begin_transform():
                    if let session = workspace.transform:
                        session.box.begin(grab, x, y)
                    self.boxing = true
                    return
        if tool == "move" or temporary_move:
            self.start_move(event)
        elif selecting_tool and not event.shift and not event.alt and workspace.in_selection(x, y):
            # Inside the selection a selection tool drags its outline.
            self.outline_moving = true
            self.outline_x = x
            self.outline_y = y
            self.outline_applied_x = 0
            self.outline_applied_y = 0
        elif tool == "zoom":
            self.zooming = true
            self.zoom_moved = false
            self.zoom_out = event.alt
            self.zoom_x = event.x
            self.zoom_y = event.y
            self.zoom_start = workspace.zoom
        elif tool == "clone" and event.alt:
            # Alt-click: where the Clone Stamp copies from, as Photoshop's.
            workspace.set_clone_source(x, y)
        elif (tool == "brush" or tool == "gradient") and event.alt:
            # Alt held: the eyedropper, as Photoshop's brush and gradient take it.
            workspace.pick(x, y)
        elif self.refuses_group(tool):
            return
        elif tool == "gradient":
            self.gradient_dragging = true
            self.gradient_x = x
            self.gradient_y = y
        elif tool == "eyedropper" or workspace.sampling:
            workspace.pick(x, y)
        elif tool == "text":
            workspace.text_x = x
            workspace.text_y = y
            if let place = self.on_text:
                place()
        elif tool == "wand":
            workspace.select_wand(x, y, mode_of(event.shift, event.alt))
        elif tool == "marquee" or tool == "ellipse" or tool == "lasso":
            self.selection.begin(workspace, x, y, tool == "lasso", tool == "ellipse", event.shift, event.alt)
        else:
            self.begin_painting(x, y, event.shift, event.pressure)

    ## Whether `tool` needs pixels and the selected layer is a group, which has
    ## none: then say so, as Photoshop does, and do nothing.
    func refuses_group(self, tool: str) -> bool!:
        let paints = tool == "brush" or tool == "eraser" or tool == "gradient" or tool == "text" or tool == "clone" or tool == "heal" or tool == "smear"
        if not paints or not self.workspace.canvas.layer_is_group(self.workspace.selected):
            return false
        if let refused = self.on_refused:
            refused("The layer is a group: pick a layer inside it to paint on")
        return true

    ## Start painting at a document point. With Shift, a straight line first
    ## runs from where the last stroke ended, and the stroke keeps to one axis.
    func begin_painting(self, x: float, y: float, shift: bool, pressure: float) -> unit!:
        let workspace = self.workspace
        if shift and self.has_stroke_end:
            workspace.begin_stroke(self.stroke_end_x, self.stroke_end_y, pressure)
            workspace.extend_stroke(x, y, pressure)
        else:
            workspace.begin_stroke(x, y, pressure)
        self.painting = workspace.canvas.painting()
        self.axis = 0 if shift else -1
        self.stroke_x = x
        self.stroke_y = y

    ## A stroke point kept to the stroke's axis once it has one: Shift-drag
    ## chooses horizontal or vertical by the first few pixels of travel.
    func on_axis(self, x: float, y: float) -> Point:
        if self.axis == 0:
            let dx = math.abs(x - self.stroke_x)
            let dy = math.abs(y - self.stroke_y)
            if (dx + dy) * self.workspace.zoom >= 4.0:
                self.axis = 1 if dx >= dy else 2
        if self.axis == 1:
            return Point(x, self.stroke_y)
        if self.axis == 2:
            return Point(self.stroke_x, y)
        return Point(x, y)

    ## A number key, as Photoshop's: 1..9 set 10%..90% and 0 sets 100%; two
    ## digits within half a second set that exact percentage (0 then 5: 5%).
    ## Painting tools take it as the brush's opacity, the others as the layer's.
    func type_digit(self, value: int) -> unit!:
        let now = time.now() // 1000000
        var percent = 100 if value == 0 else value * 10
        if self.digit >= 0 and now - self.digit_at < 500:
            percent = self.digit * 10 + value
            self.digit = -1
        else:
            self.digit = value
        self.digit_at = now
        let workspace = self.workspace
        let fraction = math.max(0.01, float(percent) / 100.0)
        if workspace.tool == "brush" or workspace.tool == "eraser" or workspace.tool == "gradient":
            workspace.brush.opacity = fraction
            workspace.touch()
        else:
            workspace.set_opacity(fraction)
        if let changed = self.on_changed:
            changed()

    ## A Move tool press: the selected pixels when there is a selection (Alt
    ## copies them), else the whole layer (Alt moves a copy of it). With
    ## Auto-Select, or Cmd held with the Move tool, the press first picks the
    ## top layer with pixels under it.
    func start_move(self, event: Event) -> unit!:
        let workspace = self.workspace
        if workspace.tool == "move" and (workspace.auto_select or event.meta or event.control):
            workspace.pick_layer(self.document_x(event.x), self.document_y(event.y))
            if let changed = self.on_changed:
                changed()
        if event.alt and not workspace.canvas.has_selection():
            workspace.duplicate()
        self.moving = true
        self.move_x = event.x
        self.move_y = event.y
        self.move_now_x = event.x
        self.move_now_y = event.y
        self.move_shown_x = 0
        self.move_shown_y = 0
        self.move_copy = event.alt
        self.move_pixels = self.workspace.canvas.has_selection()
        if self.move_pixels:
            self.workspace.begin_preview() catch failure:
                discard(failure)
                self.move_pixels = false

    ## View points moved as whole document pixels.
    func move_whole(self, points: float) -> int:
        return int(math.floor(points / self.workspace.zoom + 0.5))

    ## Arrows nudge a pixel, Shift ten: the selected pixels with the Move tool
    ## (or the layer with no selection), the outline with a selection tool.
    func nudge(self, event: Event) -> unit!:
        let step = 10 if event.shift else 1
        let dx = -step if event.key == Key.left else (step if event.key == Key.right else 0)
        let dy = -step if event.key == Key.up else (step if event.key == Key.down else 0)
        let workspace = self.workspace
        let tool = workspace.tool
        let selection = workspace.canvas.has_selection()
        if tool == "move":
            if selection:
                workspace.move_selected_pixels(dx, dy, false)
            else:
                workspace.move_layer(dx, dy)
        elif selection and (tool == "marquee" or tool == "ellipse" or tool == "lasso" or tool == "wand"):
            workspace.move_selection(dx, dy)

    ## A free transform's or the Crop tool's box dragged to a document point.
    func drag_box(self, x: float, y: float, shift: bool, alt: bool, distort: bool) -> unit!:
        if let session = self.workspace.transform:
            session.box.drag(x, y, shift, alt, distort)
            self.workspace.preview_transform()
            return
        if let crop = self.workspace.crop_box:
            crop.drag(x, y, shift)

    func end_box(self):
        if let session = self.workspace.transform:
            session.box.end()
            return
        if let crop = self.workspace.crop_box:
            crop.end()

    ## A free transform's box, else the Crop tool's, else the Move tool's transform controls, over the view.
    func draw_box(self, painter: Painter, width: float, height: float) -> unit!:
        let workspace = self.workspace
        if let session = workspace.transform:
            session.box.draw(painter, workspace.zoom, workspace.offset_x, workspace.offset_y, theme.text(), theme.backdrop())
            return
        if let crop = workspace.crop_box:
            crop.draw(painter, width, height, workspace.zoom, workspace.offset_x, workspace.offset_y, theme.text(), theme.backdrop())
            return
        # Not while a move is dragged: the box stays where the layer was.
        if not self.moving:
            if let shown = workspace.controls_box():
                shown.draw(painter, workspace.zoom, workspace.offset_x, workspace.offset_y, theme.text(), theme.backdrop())

    ## The pointer moved: carry on the gesture in progress.
    func drag(self, event: Event) -> unit!:
        if self.boxing:
            # Cmd (Ctrl) on a corner distorts, as in Compositor.
            self.drag_box(self.document_x(event.x), self.document_y(event.y), event.shift, event.alt, event.meta or event.control)
        elif self.panning:
            self.workspace.pan(event.x - self.last_x, event.y - self.last_y)
            self.last_x = event.x
            self.last_y = event.y
        elif self.painting:
            let point = self.on_axis(self.document_x(event.x), self.document_y(event.y))
            self.workspace.extend_stroke(point.x, point.y, event.pressure)
        elif self.zooming:
            # Scrubby zoom: every 100 points right doubles, left halves.
            let dx = event.x - self.zoom_x
            if math.abs(dx) >= 3.0:
                self.zoom_moved = true
            if self.zoom_moved:
                self.workspace.zoom_about(self.zoom_start * math.pow(2.0, dx / 100.0) / self.workspace.zoom, self.zoom_x, self.zoom_y)
        elif self.selection.active:
            self.selection.drag(self.workspace, self.document_x(event.x), self.document_y(event.y), event.shift, event.alt)
        elif self.moving:
            self.move_now_x = event.x
            self.move_now_y = event.y
            if event.shift:
                # Shift keeps the move to the axis it goes further along.
                if math.abs(event.x - self.move_x) >= math.abs(event.y - self.move_y):
                    self.move_now_y = self.move_y
                else:
                    self.move_now_x = self.move_x
            if self.move_pixels:
                let dx = self.move_whole(self.move_now_x - self.move_x)
                let dy = self.move_whole(self.move_now_y - self.move_y)
                if dx != self.move_shown_x or dy != self.move_shown_y:
                    self.workspace.preview_move_selected(dx, dy, self.move_copy)
                    self.move_shown_x = dx
                    self.move_shown_y = dy
        elif self.outline_moving:
            let dx = int(math.floor(self.document_x(event.x) - self.outline_x + 0.5))
            let dy = int(math.floor(self.document_y(event.y) - self.outline_y + 0.5))
            if dx != self.outline_applied_x or dy != self.outline_applied_y:
                self.workspace.move_selection(dx - self.outline_applied_x, dy - self.outline_applied_y)
                self.outline_applied_x = dx
                self.outline_applied_y = dy

    ## The button let go: finish the gesture in progress.
    func release(self, event: Event) -> unit!:
        let workspace = self.workspace
        let x = self.document_x(event.x)
        let y = self.document_y(event.y)
        self.panning = false
        if self.boxing:
            self.boxing = false
            self.end_box()
        elif self.zooming:
            self.zooming = false
            if not self.zoom_moved:
                workspace.zoom_about(0.5 if self.zoom_out else 2.0, self.zoom_x, self.zoom_y)
        elif self.moving:
            self.moving = false
            var end_x = event.x
            var end_y = event.y
            if event.shift:
                if math.abs(end_x - self.move_x) >= math.abs(end_y - self.move_y):
                    end_y = self.move_y
                else:
                    end_x = self.move_x
            let dx = self.move_whole(end_x - self.move_x)
            let dy = self.move_whole(end_y - self.move_y)
            if self.move_pixels:
                self.move_pixels = false
                if dx == 0 and dy == 0:
                    workspace.end_preview(false)
                else:
                    workspace.preview_move_selected(dx, dy, self.move_copy)
                    workspace.end_preview(true)
                    workspace.move_selection(dx, dy)
            else:
                workspace.move_layer(dx, dy)
        elif self.outline_moving:
            self.outline_moving = false
            if self.outline_applied_x == 0 and self.outline_applied_y == 0:
                # A click without a drag: the wand selects there, the others deselect.
                if workspace.tool == "wand":
                    workspace.select_wand(x, y, 0)
                else:
                    workspace.deselect()
        elif self.gradient_dragging:
            self.gradient_dragging = false
            # Shift keeps the gradient to 45° steps, as Photoshop's.
            let end = snapped(self.gradient_x, self.gradient_y, x, y) if event.shift else Point(x, y)
            if math.abs(end.x - self.gradient_x) + math.abs(end.y - self.gradient_y) >= 1.0:
                workspace.fill_gradient(self.gradient_x, self.gradient_y, end.x, end.y)
        elif self.selection.active:
            self.selection.finish(workspace, x, y, event.shift, event.alt)
        elif self.painting:
            self.painting = false
            let point = self.on_axis(x, y)
            workspace.extend_stroke(point.x, point.y, event.pressure)
            workspace.end_stroke()
            self.stroke_end_x = point.x
            self.stroke_end_y = point.y
            self.has_stroke_end = true

## (`x`, `y`) turned about (`x0`, `y0`) to the nearest 45° step, as far away.
func snapped(x0: float, y0: float, x: float, y: float) -> Point:
    let dx = x - x0
    let dy = y - y0
    let length = math.hypot(dx, dy)
    let step = math.pi / 4.0
    let angle = math.round(math.atan2(dy, dx) / step) * step
    return Point(x0 + math.cos(angle) * length, y0 + math.sin(angle) * length)

## Whether `tool` paints with the brush's tip, and so shows its outline.
func brushed(tool: str) -> bool:
    return tool == "brush" or tool == "eraser" or tool == "clone" or tool == "heal" or tool == "smear"

## The digit a number key types, or -1.
func digit_value(key: Key) -> int:
    if key == Key.digit_0:
        return 0
    if key == Key.digit_1:
        return 1
    if key == Key.digit_2:
        return 2
    if key == Key.digit_3:
        return 3
    if key == Key.digit_4:
        return 4
    if key == Key.digit_5:
        return 5
    if key == Key.digit_6:
        return 6
    if key == Key.digit_7:
        return 7
    if key == Key.digit_8:
        return 8
    if key == Key.digit_9:
        return 9
    return -1

## A texel index kept inside a 256-texel checker tile, leaving room for one texel.
pub func clamp_texel(value: int) -> int:
    return value if value >= 0 and value <= 255 else (0 if value < 0 else 255)

## Texels from `start` to `end`, at least one and not past the tile.
pub func texel_span(start: int, end: int) -> int:
    let span = end - start
    if span < 1:
        return 1
    return span if span <= 256 - start else 256 - start
