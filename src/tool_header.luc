## The contextual tool header across the top, after Compositor's: the active
## tool's name and only its options — the brush's preset, size, hardness,
## opacity, flow and spacing (eleusis scrubbers: drag to change, click to
## type), the wand's tolerance, the text size, the Move tool's Auto-Select,
## the Clone Stamp's Aligned and Sample, the Smudge tool's mode,
## Cancel and Apply while a free transform or the Crop tool's box is up — and
## the tool's hint, shown at the right of the status line.
from ui import Text, HStack, Toolbar, Size, Spacer, Menu, Command, Slider, NumberField, Checkbox
from workspace import Workspace
from kit import Kit
from brush import preset_names
from tools import tool_by_id
from transform_controls import TransformControls
from type_controls import TypeControls
from selection_controls import SelectionControls

pub class ToolHeader:
    pub let bar: Toolbar
    pub let title: Text
    pub let hint: Text
    pub let size_field: NumberField
    pub let hardness_field: NumberField
    pub let opacity_field: NumberField
    pub let flow_field: NumberField
    pub let spacing_field: NumberField
    pub let preset_menu: Menu
    pub let brush_controls: HStack
    pub let tolerance_slider: Slider
    pub let contiguous_button: Checkbox
    pub let wand_controls: HStack
    pub let text_controls: HStack
    pub let auto_select_box: Checkbox
    pub let move_controls: HStack
    pub let aligned_box: Checkbox
    pub let sample_menu: Menu
    pub let clone_controls: HStack
    pub let smear_menu: Menu
    pub let gradient_menu: Menu
    pub let reverse_box: Checkbox
    pub let transparent_box: Checkbox
    pub let gradient_controls: HStack
    pub let box_controls: HStack
    pub let transform_controls: TransformControls
    pub let type_controls: TypeControls
    pub let selection_controls: SelectionControls
    pub let controls_box: Checkbox
    ## Brush…: the window opens Brush Settings; a preset picked: the window
    ## refreshes; Apply or Cancel: the window finishes the box, keeping it or not.
    pub var brush_settings: func() -> unit!? = none
    pub var refreshed: func() -> unit!? = none
    pub var finished: func(bool) -> unit!? = none
    let workspace: Workspace
    let kit: Kit

    pub func init(self, workspace: Workspace, kit: Kit) -> unit!:
        self.workspace = workspace
        self.kit = kit
        let font = kit.font
        self.title = Text("Brush", font = font)
        self.title.layout().set_limits(Size(150.0, 0.0), Size(150.0, 16384.0))
        self.hint = Text("", font = font)
        self.size_field = self.scrubber(workspace.brush.diameter, 1.0, 500.0, " px", func (value: float) -> unit!:
            self.workspace.brush.diameter = value)
        self.hardness_field = self.scrubber(workspace.brush.hardness * 100.0, 0.0, 100.0, "%", func (value: float) -> unit!:
            self.workspace.brush.hardness = value / 100.0)
        self.opacity_field = self.scrubber(workspace.brush.opacity * 100.0, 1.0, 100.0, "%", func (value: float) -> unit!:
            self.workspace.brush.opacity = value / 100.0)
        self.flow_field = self.scrubber(workspace.brush.flow * 100.0, 1.0, 100.0, "%", func (value: float) -> unit!:
            self.workspace.brush.flow = value / 100.0)
        self.spacing_field = self.scrubber(workspace.brush.spacing * 100.0, 1.0, 500.0, "%", func (value: float) -> unit!:
            self.workspace.brush.spacing = value / 100.0)
        var presets: list[Command] = []
        for name in preset_names():
            let chosen = name
            let command = Command(name, id = "preset_" + name)
            kit.bind(command, func () -> unit!:
                self.workspace.apply_preset(chosen)
                if let refresh = self.refreshed:
                    refresh())
            presets.append(command)
        self.preset_menu = Menu(workspace.brush.preset + " ▾", presets, font = font)
        self.brush_controls = HStack([self.preset_menu, kit.labelled("Size", self.size_field), kit.labelled("Hardness", self.hardness_field),
                                      kit.labelled("Opacity", self.opacity_field), kit.labelled("Flow", self.flow_field),
                                      kit.labelled("Spacing", self.spacing_field), kit.button("Brush…", self.open_brush_settings)], spacing = 12.0)
        self.tolerance_slider = Slider("Tolerance", 0.0, 255.0, workspace.tolerance, 1.0, font = font)
        kit.keep(self.tolerance_slider.on_change(func (value: float) -> unit!:
            self.workspace.tolerance = value))
        self.contiguous_button = kit.checkbox("Contiguous", self.toggle_contiguous)
        self.wand_controls = HStack([self.tolerance_slider, self.contiguous_button], spacing = 12.0)
        self.selection_controls = SelectionControls(workspace, kit, self.wand_controls)
        self.type_controls = TypeControls(workspace, kit)
        self.text_controls = self.type_controls.row
        self.auto_select_box = kit.checkbox("Auto-Select", func () -> unit!:
            self.workspace.auto_select = not self.workspace.auto_select)
        self.controls_box = kit.checkbox("Show Transform Controls", func () -> unit!:
            self.workspace.show_transform_controls = not self.workspace.show_transform_controls
            self.workspace.touch())
        self.move_controls = HStack([self.auto_select_box, self.controls_box], spacing = 12.0)
        self.transform_controls = TransformControls(workspace, kit)
        self.transform_controls.changed = func () -> unit!:
            if let refresh = self.refreshed:
                refresh()
        let cancel = kit.button("Cancel", func () -> unit!:
            self.finish(false))
        let apply = kit.button("Apply", func () -> unit!:
            self.finish(true))
        self.box_controls = HStack([cancel, apply], spacing = 8.0)
        self.aligned_box = kit.checkbox("Aligned", func () -> unit!:
            self.workspace.clone_aligned = not self.workspace.clone_aligned)
        let this_layer = self.choice("This Layer", "clone_sample_layer", func () -> unit!:
            self.workspace.clone_all = false)
        let all_layers = self.choice("All Layers", "clone_sample_all", func () -> unit!:
            self.workspace.clone_all = true)
        self.sample_menu = Menu("This Layer ▾", [this_layer, all_layers], font = font)
        self.clone_controls = HStack([self.aligned_box, kit.labelled("Sample", self.sample_menu)], spacing = 12.0)
        let smudge = self.choice("Smudge", "smear_smudge", func () -> unit!:
            self.workspace.smear_mode = 0)
        let blur = self.choice("Blur", "smear_blur", func () -> unit!:
            self.workspace.smear_mode = 1)
        let liquify = self.choice("Liquify", "smear_liquify", func () -> unit!:
            self.workspace.smear_mode = 2)
        self.smear_menu = Menu("Smudge ▾", [smudge, blur, liquify], font = font)
        let linear = self.choice("Linear", "gradient_linear", func () -> unit!:
            self.workspace.gradient_radial = false)
        let radial = self.choice("Radial", "gradient_radial", func () -> unit!:
            self.workspace.gradient_radial = true)
        self.gradient_menu = Menu("Linear ▾", [linear, radial], font = font)
        self.reverse_box = kit.checkbox("Reverse", func () -> unit!:
            self.workspace.gradient_reverse = not self.workspace.gradient_reverse)
        self.transparent_box = kit.checkbox("To Transparent", func () -> unit!:
            self.workspace.gradient_transparent = not self.workspace.gradient_transparent)
        self.gradient_controls = HStack([self.gradient_menu, self.reverse_box, self.transparent_box], spacing = 12.0)
        self.bar = Toolbar([self.title, self.smear_menu, self.gradient_controls, self.brush_controls, self.clone_controls, self.selection_controls.row, self.text_controls, self.move_controls,
                            self.transform_controls.row, Spacer(), self.box_controls],
                           font = font, inset = 10.0, gap = 6.0)

    ## A brush setting's scrubber; `apply` takes each edit.
    func scrubber(self, value: float, minimum: float, maximum: float, suffix: str, apply: func(float) -> unit!) -> NumberField!:
        let field = NumberField(value, minimum, maximum, 1.0, suffix = suffix, font = self.kit.font)
        self.kit.keep(field.on_change(func (changed: float) -> unit!:
            apply(changed)
            self.workspace.touch()))
        return field

    func open_brush_settings(self) -> unit!:
        if let open = self.brush_settings:
            open()

    ## A menu entry that does `change` and shows the header again.
    func choice(self, name: str, id: str, change: func() -> unit!) -> Command!:
        let command = Command(name, id = id)
        self.kit.bind(command, func () -> unit!:
            change()
            if let refresh = self.refreshed:
                refresh())
        return command

    func finish(self, keep: bool) -> unit!:
        if let done = self.finished:
            done(keep)

    func toggle_contiguous(self) -> unit!:
        self.workspace.contiguous = not self.workspace.contiguous
        self.contiguous_button.set_checked(self.workspace.contiguous)

    ## Show the active tool's name, options and hint; `sampling` while the
    ## color picker takes clicks on the canvas.
    pub func show(self, sampling: bool) -> unit!:
        let workspace = self.workspace
        let tool = workspace.tool
        let active = tool_by_id(tool)
        let on_mask = workspace.canvas.editing_mask() and (tool == "brush" or tool == "eraser")
        # A free transform takes over the header until it is applied or cancelled.
        let transforming = workspace.transform != none
        self.title.set_text("Transform" if transforming else (active.title + " on mask" if on_mask else active.title))
        let retouching = tool == "clone" or tool == "heal" or tool == "smear"
        self.brush_controls.layout().set_visible(not transforming and (tool == "brush" or tool == "eraser" or tool == "gradient" or retouching))
        self.clone_controls.layout().set_visible(not transforming and tool == "clone")
        self.smear_menu.layout().set_visible(not transforming and tool == "smear")
        self.aligned_box.set_checked(workspace.clone_aligned)
        self.sample_menu.set_text("All Layers ▾" if workspace.clone_all else "This Layer ▾")
        self.smear_menu.set_text(["Smudge ▾", "Blur ▾", "Liquify ▾"][workspace.smear_mode])
        self.gradient_controls.layout().set_visible(not transforming and tool == "gradient")
        self.gradient_menu.set_text("Radial ▾" if workspace.gradient_radial else "Linear ▾")
        self.reverse_box.set_checked(workspace.gradient_reverse)
        self.transparent_box.set_checked(workspace.gradient_transparent)
        let selecting = tool == "marquee" or tool == "ellipse" or tool == "lasso" or tool == "polygon" or tool == "wand"
        self.selection_controls.row.layout().set_visible(not transforming and selecting)
        self.selection_controls.show(tool)
        self.text_controls.layout().set_visible(not transforming and tool == "text")
        if tool == "text":
            self.type_controls.show()
        self.move_controls.layout().set_visible(not transforming and tool == "move")
        self.controls_box.set_checked(workspace.show_transform_controls)
        self.transform_controls.row.layout().set_visible(transforming)
        self.transform_controls.show()
        self.box_controls.layout().set_visible(transforming or workspace.crop_box != none)
        self.auto_select_box.set_checked(workspace.auto_select)
        self.size_field.set_value(workspace.brush.diameter)
        self.hardness_field.set_value(workspace.brush.hardness * 100.0)
        self.opacity_field.set_value(workspace.brush.opacity * 100.0)
        self.flow_field.set_value(workspace.brush.flow * 100.0)
        self.spacing_field.set_value(workspace.brush.spacing * 100.0)
        self.preset_menu.set_text(workspace.brush.preset + " ▾")
        if transforming:
            self.hint.set_text("Corner scales (shift frees) · side stretches · alt about the middle · cmd-corner distorts · alt-drag inside copies · outside turns · Enter applies")
        else:
            self.hint.set_text("Click the canvas to sample a color · X swaps · D resets" if sampling else active.hint)
