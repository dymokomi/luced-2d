from canvas import Canvas
import math

## One open document and how it is shown: the luce-image canvas, its file,
## the view's zoom and offset, and which layer is selected. Every change bumps
## `revision` so views know to redraw.
pub class Workspace:
    pub var canvas: Canvas
    pub var path: str = ""
    pub var zoom: float = 1.0
    pub var offset_x: float = 0.0
    pub var offset_y: float = 0.0
    pub var selected: int = 0
    pub var revision: int = 0
    pub var fitted: bool = false
    pub var erasing: bool = false
    ## The active tool: "move", "marquee", "brush", "eraser", "hand" or "zoom".
    pub var tool: str = "brush"
    pub var diameter: float = 32.0
    pub var hardness: float = 0.75
    pub var opacity: float = 1.0
    pub var red: float = 0.0
    pub var green: float = 0.0
    pub var blue: float = 0.0
    var next_name: int = 1

    pub func init(self, width: int, height: int) -> unit!:
        self.canvas = Canvas(width, height)
        discard(self.canvas.add_layer("Background"))
        self.touch()

    pub func touch(self):
        self.revision += 1

    pub func width(self) -> int:
        return self.canvas.width()

    pub func height(self) -> int:
        return self.canvas.height()

    ## Replace the document with a new empty one.
    pub func create(self, width: int, height: int) -> unit!:
        self.canvas = Canvas(width, height)
        discard(self.canvas.add_layer("Background"))
        self.path = ""
        self.selected = 0
        self.fitted = false
        self.touch()

    ## Replace the document with the picture at `path`.
    pub func open(self, path: str) -> unit!:
        self.canvas = Canvas.open(path)
        self.path = path
        self.selected = 0
        self.fitted = false
        self.touch()

    ## Save to `path`: an `.l2d` package keeps every layer; any other extension
    ## writes the flattened picture in that format.
    pub func save(self, path: str) -> unit!:
        if path.length > 4 and path[path.length - 4..] == ".l2d":
            self.canvas.save_package(path)
        else:
            self.canvas.save(path)
        self.path = path
        self.touch()

    pub func layer_count(self) -> int:
        return self.canvas.layer_count()

    pub func selected_id(self) -> int!:
        return self.canvas.layer_id(self.selected)

    pub func add_layer(self) -> unit!:
        self.next_name += 1
        discard(self.canvas.add_layer(f"Layer {self.next_name}"))
        self.selected = self.layer_count() - 1
        self.touch()

    pub func delete_layer(self) -> unit!:
        if self.layer_count() <= 1:
            return
        self.canvas.remove_layer(self.selected_id())
        if self.selected >= self.layer_count():
            self.selected = self.layer_count() - 1
        self.touch()

    pub func reorder(self, step: int) -> unit!:
        let target = self.selected + step
        if target < 0 or target >= self.layer_count():
            return
        self.canvas.reorder_layer(self.selected_id(), step)
        self.selected = target
        self.touch()

    pub func duplicate(self) -> unit!:
        let name = self.canvas.layer_name(self.selected) + " copy"
        discard(self.canvas.duplicate_layer(self.selected_id(), name))
        self.selected += 1
        self.touch()

    pub func merge_down(self) -> unit!:
        if self.selected == 0:
            return
        self.canvas.merge_down(self.selected_id())
        self.selected -= 1
        self.touch()

    pub func crop(self) -> unit!:
        self.canvas.crop()
        self.fitted = false
        self.touch()

    pub func resize_canvas(self, width: int, height: int, offset_x: int, offset_y: int) -> unit!:
        self.canvas.resize_canvas(width, height, offset_x, offset_y)
        self.fitted = false
        self.touch()

    pub func resize_image(self, width: int, height: int) -> unit!:
        self.canvas.resize_image(width, height)
        self.fitted = false
        self.touch()

    pub func toggle_visibility(self) -> unit!:
        let id = self.selected_id()
        self.canvas.set_layer(id, not self.canvas.layer_visible(self.selected), self.canvas.layer_opacity(self.selected), self.canvas.layer_blend(self.selected))
        self.touch()

    ## Step the selected layer's blend mode through Photoshop's list.
    pub func cycle_blend(self, step: int) -> unit!:
        let id = self.selected_id()
        let count = Canvas.blend_mode_count()
        let next = (self.canvas.layer_blend(self.selected) + step + count) % count
        self.canvas.set_layer(id, self.canvas.layer_visible(self.selected), self.canvas.layer_opacity(self.selected), next)
        self.touch()

    pub func toggle_mask(self) -> unit!:
        let id = self.selected_id()
        self.canvas.set_mask(id, not self.canvas.layer_masked(self.selected))
        self.touch()

    pub func toggle_mask_editing(self) -> unit!:
        if self.canvas.layer_masked(self.selected):
            self.canvas.edit_mask(not self.canvas.editing_mask())
        else:
            self.canvas.edit_mask(false)
        self.touch()

    pub func toggle_clipped(self) -> unit!:
        let id = self.selected_id()
        self.canvas.set_clipped(id, not self.canvas.layer_clipped(self.selected))
        self.touch()

    pub func blend_name(self, index: int) -> str!:
        return Canvas.blend_mode_name(self.canvas.layer_blend(index))

    pub func set_opacity(self, opacity: float) -> unit!:
        let id = self.selected_id()
        self.canvas.set_layer(id, self.canvas.layer_visible(self.selected), math.max(0.0, math.min(1.0, opacity)), self.canvas.layer_blend(self.selected))
        self.touch()

    ## Push the brush settings to the canvas and start a stroke on the selected layer.
    pub func begin_stroke(self, x: float, y: float) -> unit!:
        if not self.canvas.layer_visible(self.selected):
            return
        self.canvas.set_brush(self.diameter, self.hardness, self.opacity, 1.0, self.red, self.green, self.blue, self.erasing)
        self.canvas.begin_stroke(self.selected_id(), x, y)
        self.touch()

    pub func extend_stroke(self, x: float, y: float) -> unit!:
        if self.canvas.painting():
            self.canvas.extend_stroke(x, y)
            self.touch()

    pub func end_stroke(self) -> unit!:
        if self.canvas.painting():
            self.canvas.end_stroke()
            self.touch()

    pub func undo(self) -> unit!:
        if self.canvas.can_undo():
            self.canvas.undo()
            self.touch()

    pub func redo(self) -> unit!:
        if self.canvas.can_redo():
            self.canvas.redo()
            self.touch()

    ## Apply a destructive adjustment to the selected layer.
    pub func adjust(self, kind: int, values: list[float]) -> unit!:
        var params: list[float] = []
        for value in values:
            params.append(value)
        while params.length < 5:
            params.append(0.0)
        self.canvas.adjust_layer(self.selected_id(), kind, params[0], params[1], params[2], params[3], params[4])
        self.touch()

    pub func set_color(self, red: float, green: float, blue: float):
        self.red = red
        self.green = green
        self.blue = blue
        if self.tool == "eraser":
            self.choose_tool("brush")
        self.touch()

    pub func choose_tool(self, tool: str):
        self.tool = tool
        self.erasing = tool == "eraser"
        self.touch()

    pub func select_all(self) -> unit!:
        self.canvas.select_all()
        self.touch()

    pub func deselect(self) -> unit!:
        self.canvas.deselect()
        self.touch()

    pub func invert_selection(self) -> unit!:
        self.canvas.invert_selection()
        self.touch()

    pub func adjust_selection(self, pixels: int, feather: int) -> unit!:
        self.canvas.adjust_selection(pixels, feather)
        self.touch()

    ## A rectangle or ellipse between two corners, combined by `mode`
    ## (0 replace, 1 add, 2 subtract, 3 intersect).
    pub func select_shape(self, x0: float, y0: float, x1: float, y1: float, ellipse: bool, mode: int) -> unit!:
        let left = int(math.floor(math.min(x0, x1)))
        let top = int(math.floor(math.min(y0, y1)))
        let right = int(math.ceil(math.max(x0, x1)))
        let bottom = int(math.ceil(math.max(y0, y1)))
        if right <= left or bottom <= top:
            return
        if ellipse:
            self.canvas.select_ellipse(left, top, right - left, bottom - top, mode)
        else:
            self.canvas.select_rectangle(left, top, right - left, bottom - top, mode)
        self.touch()

    pub func fill_selection(self, erase: bool) -> unit!:
        self.canvas.set_brush(self.diameter, self.hardness, self.opacity, 1.0, self.red, self.green, self.blue, false)
        self.canvas.fill(self.selected_id(), erase)
        self.touch()

    pub func move_layer(self, dx: int, dy: int) -> unit!:
        self.canvas.move_layer(self.selected_id(), dx, dy)
        self.touch()

    pub func blur(self, radius: float) -> unit!:
        self.canvas.blur_layer(self.selected_id(), radius)
        self.touch()

    pub func tool_name(self) -> str:
        if self.tool == "move":
            return "Move"
        if self.tool == "marquee":
            return "Marquee"
        if self.tool == "ellipse":
            return "Ellipse"
        if self.tool == "lasso":
            return "Lasso"
        if self.tool == "eraser":
            return "Eraser"
        if self.tool == "hand":
            return "Hand"
        if self.tool == "zoom":
            return "Zoom"
        return "Brush"

    pub func scale_brush(self, factor: float):
        self.diameter = math.max(1.0, math.min(4096.0, math.floor(self.diameter * factor + 0.5)))
        self.touch()

    pub func select(self, index: int) -> unit!:
        if index >= 0 and index < self.layer_count():
            self.selected = index
            if not self.canvas.layer_masked(index):
                self.canvas.edit_mask(false)
            self.touch()

    ## Zoom about a point of the view, keeping the document pixel under it still.
    pub func zoom_about(self, factor: float, x: float, y: float):
        let next = math.max(1.0 / 64.0, math.min(64.0, self.zoom * factor))
        let applied = next / self.zoom
        self.offset_x = x - (x - self.offset_x) * applied
        self.offset_y = y - (y - self.offset_y) * applied
        self.zoom = next
        self.fitted = false
        self.touch()

    pub func pan(self, dx: float, dy: float):
        self.offset_x += dx
        self.offset_y += dy
        self.fitted = false
        self.touch()

    ## Fit the document into a `width` by `height` view with a margin.
    pub func fit(self, width: float, height: float):
        let margin = 40.0
        let available_x = math.max(1.0, width - margin * 2.0)
        let available_y = math.max(1.0, height - margin * 2.0)
        self.zoom = math.max(1.0 / 64.0, math.min(64.0, math.min(available_x / float(self.width()), available_y / float(self.height()))))
        self.center(width, height)
        self.fitted = true
        self.touch()

    pub func actual_size(self, width: float, height: float):
        self.zoom = 1.0
        self.center(width, height)
        self.touch()

    func center(self, width: float, height: float):
        self.offset_x = math.floor((width - float(self.width()) * self.zoom) * 0.5)
        self.offset_y = math.floor((height - float(self.height()) * self.zoom) * 0.5)
