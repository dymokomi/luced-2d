## The editing session: the open documents (one live at a time, its fields
## kept on the workspace so tools never look past it), the active tool, the
## brush, the foreground and background colors, and the view aids. Every
## change bumps `revision` so views know to redraw. Layer operations act on
## the selected layer; `selected` is its stack index, `selected_id()` its id.
from canvas import Canvas
from theme import Look
from brush import Brush, preset
from documents import Document, title_of, blank_canvas
from hex_color import hex_of_linear, linear_of_hex
import math
import transfer
import paths
from units import pixels_per
from free_transform import FreeTransform, begin_free_transform, box_around
from selection_options import SelectionOptions
from transform_box import TransformBox
from crop_box import CropBox

pub class Workspace:
    pub var canvas: Canvas
    ## Every open document, and which one the live fields belong to.
    pub var documents: list[Document]
    pub var current: int = 0
    ## The configurable look (accent, radius), set from Settings.
    pub var look: Look
    pub var path: str = ""
    pub var zoom: float = 1.0
    pub var offset_x: float = 0.0
    pub var offset_y: float = 0.0
    pub var selected: int = 0
    pub var revision: int = 0
    pub var fitted: bool = false
    ## The active tool, a `tools()` id, and whether the brush erases (the eraser).
    pub var tool: str = "brush"
    pub var erasing: bool = false
    ## Spring-loaded tools, as in Photoshop: the tool before the last switch,
    ## and whether the current one has been used on the canvas since. Holding a
    ## tool's key while using it returns to the previous tool on release.
    pub var tool_before: str = "brush"
    pub var tool_used: bool = false
    pub var brush: Brush
    ## The text tool's size in pixels and where the next text goes.
    pub var text_size: float = 48.0
    pub var text_x: float = 0.0
    pub var text_y: float = 0.0
    ## The Move tool's Auto-Select: a press picks the top layer with pixels under it.
    pub var auto_select: bool = false
    ## The retouching tools' options: the Clone Stamp keeps its first offset
    ## (aligned) and samples this layer or all; the Smudge tool smudges (0),
    ## blurs (1) or pushes as Liquify does (2).
    pub var clone_aligned: bool = true
    pub var clone_all: bool = false
    pub var smear_mode: int = 0
    ## The Gradient tool's options: radial rather than linear, the colors
    ## reversed, and from the foreground to transparent instead of to the
    ## background.
    pub var gradient_radial: bool = false
    pub var gradient_reverse: bool = false
    pub var gradient_transparent: bool = false
    ## The free transform under way on the canvas, if any, and how the next resamples.
    pub var transform: FreeTransform? = none
    pub var transform_sampling: int = 1
    ## The transform numbers keep width and height in proportion.
    pub var lock_transform_ratio: bool = true
    ## The Move tool shows the transform box around the selected layers; a
    ## handle dragged starts a free transform (View › Show Transform Controls).
    pub var show_transform_controls: bool = false
    var controls_cache: TransformBox? = none
    var controls_revision: int = -1
    ## The Crop tool's box while the tool is active.
    pub var crop_box: CropBox? = none
    ## Magic wand settings: color tolerance 0..255 and whether the pixels must connect.
    pub var tolerance: float = 32.0
    pub var contiguous: bool = true
    ## The foreground and background colors (linear), black over white by
    ## default, as Compositor's palette: the brush, text and fills use the
    ## foreground; gradients run to the background; cmd-Delete fills with it.
    pub var red: float = 0.0
    pub var green: float = 0.0
    pub var blue: float = 0.0
    pub var back_red: float = 1.0
    pub var back_green: float = 1.0
    pub var back_blue: float = 1.0
    ## While the picker is open a canvas click samples into the color it edits.
    pub var sampling: bool = false
    pub var sampling_background: bool = false
    ## The view aids: rulers, the grid, and the unit rulers and sizes are shown in
    ## ("px", "mm" or "in"; physical units use the document's resolution).
    pub var show_rulers: bool = true
    pub var show_grid: bool = false
    pub var units: str = "px"
    ## The picker's history: sRGB hex strings, newest first, at most 16.
    pub var recent: list[str]
    ## Layers selected besides `selected` (Cmd- and Shift-click in Layers), by
    ## id; and the groups folded shut in the Layers panel, by id.
    pub var picked: list[int]
    pub var collapsed: list[int]
    ## The selection tools' options (selection_options.luc).
    pub let selecting: SelectionOptions
    var next_name: int = 1
    pub var next_group: int = 1

    pub func init(self, width: int, height: int) -> unit!:
        self.canvas = blank_canvas(width, height)
        self.look = Look()
        self.brush = Brush()
        self.recent = []
        self.picked = []
        self.collapsed = []
        self.selecting = SelectionOptions()
        self.documents = [Document(self.canvas, "")]
        self.touch()

    pub func touch(self):
        self.revision += 1

    # -- Documents: the live fields are the current document's; switching stashes and restores them.

    ## Copy the live fields into the current document's record; a free
    ## transform under way is dropped first.
    func stash(self) -> unit!:
        if self.current < 0 or self.current >= self.documents.length:
            return
        self.finish_transform(false)
        let document = self.documents[self.current]
        document.canvas = self.canvas
        document.path = self.path
        document.zoom = self.zoom
        document.offset_x = self.offset_x
        document.offset_y = self.offset_y
        document.selected = self.selected
        document.fitted = self.fitted
        document.next_name = self.next_name

    ## Make document `index` the live one.
    func restore(self, index: int):
        let document = self.documents[index]
        self.current = index
        self.canvas = document.canvas
        self.path = document.path
        self.zoom = document.zoom
        self.offset_x = document.offset_x
        self.offset_y = document.offset_y
        self.selected = document.selected
        self.picked = []
        self.collapsed = []
        self.fitted = document.fitted
        self.next_name = document.next_name
        # The Crop tool's box goes around the document now shown.
        if self.crop_box != none:
            self.crop_box = CropBox(float(self.width()), float(self.height()))
        self.touch()

    ## Add `document` as a new tab and switch to it — or, when the only open
    ## document is the untouched untitled one, take its place, as Photoshop does.
    func adopt(self, document: Document) -> unit!:
        self.stash()
        if self.documents.length == 1 and self.path == "" and not self.canvas.can_undo() and self.layer_count() == 1:
            self.canvas.close()
            self.documents = [document]
            self.restore(0)
            return
        self.documents.append(document)
        self.restore(self.documents.length - 1)

    pub func switch_document(self, index: int) -> unit!:
        if index < 0 or index >= self.documents.length or index == self.current:
            return
        self.stash()
        self.restore(index)

    ## Step to the next (or previous) tab, wrapping.
    pub func next_document(self, step: int) -> unit!:
        let count = self.documents.length
        self.switch_document(((self.current + step) % count + count) % count)

    ## Close document `index`. The last one closing leaves a fresh untitled canvas.
    pub func close_document(self, index: int) -> unit!:
        if index < 0 or index >= self.documents.length:
            return
        self.stash()
        let closing = self.documents[index]
        var kept: list[Document] = []
        var at = 0
        for document in self.documents:
            if at != index:
                kept.append(document)
            at += 1
        if kept.length == 0:
            kept.append(Document(blank_canvas(closing.canvas.width(), closing.canvas.height()), ""))
        closing.canvas.close()
        self.documents = kept
        # The tab that was current stays current, unless it was the one closed: then its neighbor.
        var next = self.current
        if index < self.current:
            next = self.current - 1
        if next >= kept.length:
            next = kept.length - 1
        if next < 0:
            next = 0
        self.restore(next)

    pub func document_count(self) -> int:
        return self.documents.length

    ## The tab name of document `index`, the live one read live.
    pub func document_title(self, index: int) -> str:
        return title_of(self.path) if index == self.current else self.documents[index].title()

    ## Whether document `index` has unsaved work, the live one read live.
    pub func document_dirty(self, index: int) -> bool:
        return self.canvas.modified() if index == self.current else self.documents[index].dirty()

    pub func width(self) -> int:
        return self.canvas.width()

    pub func height(self) -> int:
        return self.canvas.height()

    ## Open a new empty document in its own tab.
    pub func create(self, width: int, height: int) -> unit!:
        self.adopt(Document(blank_canvas(width, height), ""))

    ## Open the picture at `path` in its own tab.
    pub func open(self, path: str) -> unit!:
        self.adopt(Document(Canvas.open(path), path))

    ## Save the document to `path` as an `.l2d` package, which keeps every
    ## layer (a name without the extension gets it); it is the document's file
    ## from now on. Flattened pictures are `export`ed instead, so a later Save
    ## never overwrites a picture with the flattened document by surprise.
    pub func save(self, path: str) -> unit!:
        let package = path if path.lower().ends_with(".l2d") else path + ".l2d"
        self.canvas.save_package(package)
        self.path = package
        self.touch()

    ## File › Export: the flattened picture to `path`, its format by the
    ## extension. JPEG has no transparency, so it is written at `quality`
    ## (1..100) over the `matte` gray (0 black .. 1 white). The document keeps
    ## its own file.
    pub func export(self, path: str, quality: int = 90, matte: float = 1.0) -> unit!:
        let lowered = path.lower()
        let jpeg = lowered.ends_with(".jpg") or lowered.ends_with(".jpeg")
        self.canvas.save(path, quality, matte if jpeg else -1.0, matte, matte)

    ## A file name for an exported picture: the document's, its extension
    ## replaced by `extension`.
    pub func export_name(self, extension: str) -> str:
        let pieces = title_of(self.path).split(".")
        if pieces.length == 1:
            return pieces[0] + extension
        return pieces[..<(pieces.length - 1)].join(".") + extension

    ## Whether `path` is a file luced-2d opens: a picture, a Photoshop document or
    ## its own .l2d package.
    pub func can_open(self, path: str) -> bool:
        return self.can_place(path) or path.lower().ends_with(".psd") or path.lower().ends_with(".l2d")

    ## Whether `path` is a picture that can become a layer.
    pub func can_place(self, path: str) -> bool:
        let lowered = path.lower()
        for suffix in [".png", ".jpg", ".jpeg", ".tif", ".tiff", ".exr"]:
            if lowered.ends_with(suffix):
                return true
        return false

    ## Put the picture at `path` on a new layer named after the file, centred on
    ## document point (`x`, `y`), and select it.
    pub func place_file(self, path: str, x: float, y: float) -> unit!:
        self.as_one("Place", func () -> unit!:
            let id = self.canvas.add_layer(paths.stem(path))
            self.canvas.place_layer(id, path, int(x), int(y))
            self.place_above_selected(id))

    # -- Units and the grid.

    ## Document pixels per one of the current unit.
    pub func pixels_per_unit(self) -> float:
        return pixels_per(self.units, self.canvas.resolution())

    ## The grid's major spacing in document pixels: every 64 px, 10 mm or 1 inch.
    pub func grid_major(self) -> float:
        if self.units == "mm":
            return 10.0 * self.pixels_per_unit()
        if self.units == "in":
            return self.pixels_per_unit()
        return 64.0

    ## How many parts each major grid square is cut into.
    pub func grid_divisions(self) -> int:
        return 10 if self.units == "mm" else 8

    # -- Layers: each acts on the selected one.

    pub func layer_count(self) -> int:
        return self.canvas.layer_count()

    ## The selected layer's id, which the canvas's setters take.
    pub func selected_id(self) -> int!:
        return self.canvas.layer_id(self.selected)

    ## Select the layer at stack index `index`; leaving a layer without a mask
    ## leaves mask editing too.
    pub func select(self, index: int) -> unit!:
        if index >= 0 and index < self.layer_count():
            self.selected = index
            self.picked = []
            if not self.canvas.layer_masked(index):
                self.canvas.edit_mask(false)
            self.touch()

    ## The stack index of the layer whose id is `id`, or -1.
    pub func index_of(self, id: int) -> int!:
        var index = 0
        while index < self.layer_count():
            if self.canvas.layer_id(index) == id:
                return index
            index += 1
        return -1

    ## Whether the layer at `index` is selected, alone or with others.
    pub func is_selected(self, index: int) -> bool!:
        if index == self.selected:
            return true
        let id = self.canvas.layer_id(index)
        for picked in self.picked:
            if picked == id:
                return true
        return false

    ## Every selected layer's id, bottom to top.
    pub func selected_ids(self) -> list[int]!:
        var ids: list[int] = []
        var index = 0
        while index < self.layer_count():
            if self.is_selected(index):
                ids.append(self.canvas.layer_id(index))
            index += 1
        return ids

    ## Cmd-click in Layers: add the layer to the selection, or take it out; it
    ## becomes the one the tools act on.
    pub func toggle_picked(self, index: int) -> unit!:
        let id = self.canvas.layer_id(index)
        if self.is_selected(index) and index != self.selected:
            var kept: list[int] = []
            for picked in self.picked:
                if picked != id:
                    kept.append(picked)
            self.picked = kept
        elif index != self.selected:
            let before = self.canvas.layer_id(self.selected)
            var kept = self.picked
            kept.append(before)
            self.selected = index
            self.picked = kept
        self.touch()

    ## Shift-click in Layers: select every layer from the selected one to `index`.
    pub func pick_range(self, index: int) -> unit!:
        let low = self.selected if self.selected < index else index
        let high = index if self.selected < index else self.selected
        var ids: list[int] = []
        var at = low
        while at <= high:
            if at != index:
                ids.append(self.canvas.layer_id(at))
            at += 1
        self.selected = index
        self.picked = ids
        self.touch()

    ## A new empty layer just above the selected one, in its group, selected.
    pub func add_layer(self) -> unit!:
        self.next_name += 1
        self.as_one("New Layer", func () -> unit!:
            self.place_above_selected(self.canvas.add_layer(f"Layer {self.next_name}")))

    ## Make `change` one undo step named `name`, however many changes it makes.
    pub func as_one(self, name: str, change: func() -> unit!) -> unit!:
        self.canvas.begin_edit(name)
        change() catch failure:
            self.canvas.end_edit()
            error(failure.code, failure.message)
        self.canvas.end_edit()

    ## Put the new layer `id` just above the selected layer, in the same group,
    ## and select it — or, above a group, just above the whole group.
    pub func place_above_selected(self, id: int) -> unit!:
        let created = self.index_of(id)
        if self.selected != created and self.selected < self.layer_count():
            let parent = self.canvas.layer_parent(self.selected)
            let position = self.canvas.layer_position(self.selected)
            self.canvas.move_into(id, parent, position + 1)
        self.select_id(id)

    ## Delete every selected layer (a group with all it holds), keeping one.
    pub func delete_layer(self) -> unit!:
        let at = self.selected
        for id in self.selected_ids():
            let index = self.index_of(id)
            # One layer always stays; a group going takes its layers, so check each time.
            if index >= 0 and self.layer_count() > 1:
                self.canvas.remove_layer(id)
        self.picked = []
        self.selected = at if at < self.layer_count() else self.layer_count() - 1
        self.touch()

    ## Move the selected layer one place up among its group's layers (negative:
    ## down); a group goes with everything in it.
    pub func reorder(self, step: int) -> unit!:
        let id = self.selected_id()
        self.canvas.reorder_layer(id, step)
        self.selected = self.index_of(id)
        self.touch()

    pub func duplicate(self) -> unit!:
        let name = self.canvas.layer_name(self.selected) + " copy"
        let copy = self.canvas.duplicate_layer(self.selected_id(), name)
        self.select_id(copy)

    pub func merge_down(self) -> unit!:
        if self.selected == 0:
            return
        let below = self.canvas.layer_id(self.selected - 1)
        self.canvas.merge_down(self.selected_id())
        self.select_id(below)

    ## Copy the selected layer's selected pixels (all of them without a
    ## selection) to the system clipboard, or the whole picture's with
    ## `merged`; with `cut` they leave the layer.
    pub func copy_selection(self, merged: bool, cut: bool) -> unit!:
        self.canvas.copy_selection(self.selected_id(), merged, cut)
        self.touch()

    ## The clipboard's image on a new layer just above the selected one, centred
    ## on a document point, and selected.
    pub func paste(self, x: float, y: float) -> unit!:
        let parent = self.canvas.layer_parent(self.selected)
        let position = self.canvas.layer_position(self.selected)
        self.as_one("Paste", func () -> unit!:
            let id = self.canvas.paste(int(x), int(y))
            self.canvas.move_into(id, parent, position + 1)
            self.select_id(id))

    ## Layer via Copy (via Cut with `cut`): a new layer of the selected pixels, selected.
    pub func layer_via_copy(self, cut: bool) -> unit!:
        let id = self.canvas.layer_via_copy(self.selected_id(), cut)
        self.select_id(id)

    ## Select the layer whose id is `id`.
    pub func select_id(self, id: int) -> unit!:
        let index = self.index_of(id)
        if index >= 0:
            self.select(index)

    ## Rename the selected layer.
    pub func rename(self, name: str) -> unit!:
        self.canvas.rename_layer(self.selected_id(), name)
        self.touch()

    ## The blend mode's name of the layer at stack index `index`.
    pub func blend_name(self, index: int) -> str!:
        return Canvas.blend_mode_name(self.canvas.layer_blend(index))

    ## Set the selected layer's visibility, opacity and blend mode together, as
    ## the canvas takes them.
    func set_appearance(self, visible: bool, opacity: float, blend: int) -> unit!:
        self.canvas.set_layer(self.selected_id(), visible, math.max(0.0, math.min(1.0, opacity)), blend)
        self.touch()

    pub func toggle_visibility(self) -> unit!:
        let at = self.selected
        self.set_appearance(not self.canvas.layer_visible(at), self.canvas.layer_opacity(at), self.canvas.layer_blend(at))

    pub func set_opacity(self, opacity: float) -> unit!:
        let at = self.selected
        self.set_appearance(self.canvas.layer_visible(at), opacity, self.canvas.layer_blend(at))

    pub func set_blend(self, mode: int) -> unit!:
        let at = self.selected
        self.set_appearance(self.canvas.layer_visible(at), self.canvas.layer_opacity(at), mode)

    ## Step the selected layer's blend mode `step` places through Photoshop's list, wrapping.
    pub func cycle_blend(self, step: int) -> unit!:
        let count = Canvas.blend_mode_count()
        self.set_blend((self.canvas.layer_blend(self.selected) + step % count + count) % count)

    ## Add a mask — revealing the selection when there is one, as Photoshop's
    ## button does, else everything; `hide` hides everything instead — or
    ## remove the mask the layer has.
    pub func toggle_mask(self, hide: bool = false) -> unit!:
        if self.canvas.layer_masked(self.selected):
            self.canvas.set_mask(self.selected_id(), false)
        else:
            self.canvas.set_mask(self.selected_id(), true, 1 if hide else (2 if self.canvas.has_selection() else 0))
        self.touch()

    ## Keep the selected layer's mask but stop it hiding anything, or bring it back.
    pub func toggle_mask_enabled(self) -> unit!:
        if self.canvas.layer_masked(self.selected):
            self.canvas.enable_mask(self.selected_id(), not self.canvas.layer_mask_enabled(self.selected))
            self.touch()

    ## The selected layer's transparency becomes the selection.
    pub func load_transparency(self) -> unit!:
        self.canvas.select_from_layer(self.selected_id(), false, 0)
        self.touch()

    ## \: paint on the selected layer's mask, or back on its pixels.
    pub func toggle_mask_editing(self) -> unit!:
        self.canvas.edit_mask(self.canvas.layer_masked(self.selected) and not self.canvas.editing_mask())
        self.touch()

    pub func toggle_clipped(self) -> unit!:
        self.canvas.set_clipped(self.selected_id(), not self.canvas.layer_clipped(self.selected))
        self.touch()

    ## Move every selected layer by whole pixels, as one undo step; a group
    ## moves what it holds.
    pub func move_layer(self, dx: int, dy: int) -> unit!:
        var first = true
        for id in self.moving_ids():
            if not first:
                self.canvas.join_next_edit()
            self.canvas.move_layer(id, dx, dy)
            first = false
        self.touch()

    ## The pixel layers a move takes: the selected ones and those inside
    ## selected groups, each once.
    func moving_ids(self) -> list[int]!:
        var ids: list[int] = []
        var index = 0
        while index < self.layer_count():
            if not self.canvas.layer_is_group(index) and self.inside_selection(index):
                ids.append(self.canvas.layer_id(index))
            index += 1
        return ids

    ## Whether the layer at `index` is selected or inside a selected group.
    func inside_selection(self, index: int) -> bool!:
        if self.is_selected(index):
            return true
        var parent = self.canvas.layer_parent(index)
        while parent != 0:
            let holder = self.index_of(parent)
            if holder < 0:
                return false
            if self.is_selected(holder):
                return true
            parent = self.canvas.layer_parent(holder)
        return false

    # -- The whole image.

    pub func crop(self) -> unit!:
        self.canvas.crop()
        self.fitted = false
        self.touch()

    ## Crop to the Crop tool's box (Enter), or put it back around the whole
    ## canvas (Esc). Past the canvas's edges the canvas grows, transparent.
    pub func finish_crop(self, keep: bool) -> unit!:
        if let box = self.crop_box:
            if keep:
                box.end()
                self.canvas.resize_canvas(box.width(), box.height(), -int(box.left), -int(box.top))
                self.fitted = false
            self.crop_box = CropBox(float(self.width()), float(self.height()))
            self.touch()

    ## The canvas `width` by `height`, the old one's top-left at (`offset_x`, `offset_y`).
    pub func resize_canvas(self, width: int, height: int, offset_x: int, offset_y: int) -> unit!:
        self.canvas.resize_canvas(width, height, offset_x, offset_y)
        self.fitted = false
        self.touch()

    ## Image › Reveal All: the canvas grown to hold every layer's pixels,
    ## those moved past it included; false when nothing lies past it.
    pub func reveal_all(self) -> bool!:
        if not self.canvas.reveal_all():
            return false
        self.fitted = false
        self.touch()
        return true

    ## Every layer resampled to `width` by `height`.
    pub func resize_image(self, width: int, height: int, smooth: bool = true) -> unit!:
        self.canvas.resize_image(width, height, smooth)
        self.fitted = false
        self.touch()

    # -- Painting.

    ## Start again from brush preset `name`, keeping the size and opacity.
    pub func apply_preset(self, name: str) -> unit!:
        self.brush = preset(name, self.brush.diameter, self.brush.opacity)
        self.touch()

    ## [ and ]: the brush size by `factor`.
    pub func scale_brush(self, factor: float):
        self.brush.scale(factor)
        self.touch()

    ## Shift ] and Shift [: the brush's hardness by `step`, within 0..1.
    pub func harden_brush(self, step: float):
        self.brush.hardness = math.max(0.0, math.min(1.0, self.brush.hardness + step))
        self.touch()

    ## Start a stroke on the selected layer at a document point; `pressure` is
    ## the stylus's, 0..1, or zero from a mouse. A hidden layer takes no paint.
    pub func begin_stroke(self, x: float, y: float, pressure: float = 0.0) -> unit!:
        if not self.canvas.layer_visible(self.selected):
            return
        self.brush.apply(self.canvas, self.red, self.green, self.blue, self.erasing)
        self.canvas.set_retouch(self.retouch_kind())
        self.canvas.set_clone_options(self.clone_aligned, self.clone_all)
        self.canvas.begin_stroke(self.selected_id(), x, y, pressure if pressure > 0.0 else 1.0)
        self.touch()

    ## The canvas's retouching tool for the active tool: 0 plain paint, 1 clone
    ## stamp, 2 spot healing, 3 blur, 4 smudge, 5 push.
    pub func retouch_kind(self) -> int:
        if self.tool == "clone":
            return 1
        if self.tool == "heal":
            return 2
        if self.tool == "smear":
            return 4 if self.smear_mode == 0 else (3 if self.smear_mode == 1 else 5)
        return 0

    ## Alt-click with the Clone Stamp: where it copies from.
    pub func set_clone_source(self, x: float, y: float):
        self.canvas.set_clone_source(x, y)
        self.touch()

    ## Continue the stroke in progress, if any, to a document point.
    pub func extend_stroke(self, x: float, y: float, pressure: float = 0.0) -> unit!:
        if self.canvas.painting():
            self.canvas.extend_stroke(x, y, pressure if pressure > 0.0 else 1.0)
            self.touch()

    ## Esc mid-stroke: end the stroke and take back what it painted.
    pub func cancel_stroke(self) -> unit!:
        if self.canvas.painting():
            self.canvas.end_stroke()
            self.canvas.undo()
            self.touch()

    ## End the stroke in progress, keeping what it painted.
    pub func end_stroke(self) -> unit!:
        if self.canvas.painting():
            self.canvas.end_stroke()
            self.touch()

    ## Fill the selection on the selected layer with the foreground (or
    ## background) color at the brush's opacity, or `erase` it.
    pub func fill_selection(self, erase: bool, background: bool = false) -> unit!:
        let b = self.brush
        if background:
            self.canvas.set_brush(b.diameter, b.hardness, b.opacity, 1.0, self.back_red, self.back_green, self.back_blue, false)
        else:
            self.canvas.set_brush(b.diameter, b.hardness, b.opacity, 1.0, self.red, self.green, self.blue, false)
        self.canvas.fill(self.selected_id(), erase)
        self.touch()

    ## A linear gradient on the selected layer from the foreground color at one
    ## document point to the background color at another, within the selection.
    pub func fill_gradient(self, x0: float, y0: float, x1: float, y1: float) -> unit!:
        let opacity = self.brush.opacity
        # From the foreground to the background, or to the foreground faded out.
        var first = [self.red, self.green, self.blue, opacity]
        var second = [self.red, self.green, self.blue, 0.0] if self.gradient_transparent else [self.back_red, self.back_green, self.back_blue, opacity]
        if self.gradient_reverse:
            let swap = first
            first = second
            second = swap
        self.canvas.fill_gradient(self.selected_id(), x0, y0, x1, y1, first[0], first[1], first[2], first[3], second[0], second[1], second[2], second[3], self.gradient_radial)
        self.touch()

    ## Set `text` on the selected layer at the remembered text position, in the foreground color.
    pub func draw_text(self, text: str) -> unit!:
        self.canvas.draw_text(self.selected_id(), self.text_x, self.text_y, text, self.text_size, self.red, self.green, self.blue)
        self.touch()

    # -- History and previews.

    pub func undo(self) -> unit!:
        if self.canvas.can_undo() and not self.canvas.previewing():
            let width = self.width()
            let height = self.height()
            self.canvas.undo()
            self.after_history(width, height)

    pub func redo(self) -> unit!:
        if self.canvas.can_redo() and not self.canvas.previewing():
            let width = self.width()
            let height = self.height()
            self.canvas.redo()
            self.after_history(width, height)

    ## Undo or redo may have changed the layers under the selection — keep it
    ## in range — or the canvas size from `width` × `height`: fit it again.
    func after_history(self, width: int, height: int):
        self.picked = []
        if self.selected >= self.layer_count():
            self.selected = self.layer_count() - 1
        if self.selected < 0:
            self.selected = 0
        if self.width() != width or self.height() != height:
            self.fitted = false
        self.touch()

    ## Start showing edits live on the selected layer; `end_preview` keeps or drops them.
    pub func begin_preview(self) -> unit!:
        self.canvas.begin_preview(self.selected_id())

    pub func previewing(self) -> bool:
        return self.canvas.previewing()

    ## Preview adjustment `kind` (as `adjust`) with the engine's `numbers`.
    pub func preview_adjust(self, kind: int, numbers: list[float]) -> unit!:
        self.stage(numbers)
        self.canvas.preview_adjust(kind)
        self.touch()

    ## Preview Add Noise: grain of deviation `amount` (0..1), `seed` fixing it.
    pub func preview_noise(self, amount: float, monochrome: bool, seed: int) -> unit!:
        self.canvas.preview_noise(amount, monochrome, seed)
        self.touch()

    ## A new adjustment layer of `kind` named `name`, with the engine's
    ## `numbers`, just above the selected layer and selected; its id.
    pub func add_adjustment_layer(self, kind: int, name: str, numbers: list[float]) -> int!:
        self.stage(numbers)
        let id = self.canvas.add_adjustment_layer(name, kind)
        self.place_above_selected(id)
        return id

    ## Adjustment layer `id`'s settings, live.
    pub func update_adjustment_layer(self, id: int, numbers: list[float]) -> unit!:
        self.stage(numbers)
        self.canvas.update_adjustment_layer(id)
        self.touch()

    ## Take layer `id` away (a group with all it holds), keeping a selection.
    pub func remove_layer_id(self, id: int) -> unit!:
        self.canvas.remove_layer(id)
        self.picked = []
        if self.selected >= self.layer_count():
            self.selected = self.layer_count() - 1
        self.touch()

    ## The foreground then the background color, sRGB-encoded 0..1: the Gradient Map's ends.
    pub func colors_encoded(self) -> list[float]:
        return [transfer.srgb_encode(self.red), transfer.srgb_encode(self.green), transfer.srgb_encode(self.blue),
                transfer.srgb_encode(self.back_red), transfer.srgb_encode(self.back_green), transfer.srgb_encode(self.back_blue)]

    ## The engine's `numbers` staged for the next adjustment, the rest 0.
    func stage(self, numbers: list[float]) -> unit!:
        self.canvas.clear_adjustments()
        var index = 0
        for number in numbers:
            self.canvas.set_adjustment(index, number)
            index += 1

    ## Preview a Gaussian blur of `radius` pixels.
    pub func preview_blur(self, radius: float) -> unit!:
        self.canvas.preview_blur(radius)
        self.touch()

    ## Edit › Free Transform: a box around the selected layers' pixels (or the
    ## selection's, whose pixels then float), shown live until
    ## `finish_transform`. False when there is nothing to transform, or
    ## something else is previewing.
    pub func begin_transform(self) -> bool!:
        if self.transform != none or self.previewing():
            return false
        self.transform = begin_free_transform(self.canvas, self.moving_ids(), self.transform_sampling)
        self.touch()
        return self.transform != none

    ## Show the layers as the transform box has them now.
    pub func preview_transform(self) -> unit!:
        if let session = self.transform:
            session.preview()
            self.touch()

    ## Apply the transform (Enter) or drop it (Esc). Applied, it is one undo
    ## step, and linked masks go with the pixels.
    pub func finish_transform(self, keep: bool) -> unit!:
        if let session = self.transform:
            self.transform = none
            session.finish(keep)
            self.touch()

    ## The box the Move tool shows with Show Transform Controls, measured again
    ## only after a change; none when it is not shown or nothing is painted.
    pub func controls_box(self) -> TransformBox?!:
        if not self.show_transform_controls or self.tool != "move" or self.transform != none or self.crop_box != none:
            return none
        if self.controls_revision != self.revision:
            self.controls_cache = box_around(self.canvas, self.moving_ids())
            self.controls_revision = self.revision
        return self.controls_cache

    ## Alt-drag inside the box: carry on the same box on a copy of the layer,
    ## the original left as it was. Not for floating pixels or several layers.
    pub func duplicate_in_transform(self) -> unit!:
        let session = self.transform else return
        if session.floats() or session.ids.length != 1:
            return
        self.transform = none
        session.finish(false)
        self.duplicate()
        self.transform = begin_free_transform(self.canvas, [self.selected_id()], session.sampling, session.box)
        self.touch()

    ## The transform's sampling (0 nearest, 1 smooth, 2 high quality), kept for the next.
    pub func set_transform_sampling(self, sampling: int) -> unit!:
        self.transform_sampling = sampling
        if let session = self.transform:
            session.set_sampling(sampling)
            self.touch()

    ## Edit › Transform › Flip: the selected layer mirrored about its painted middle.
    pub func flip_layer(self, horizontal: bool) -> unit!:
        self.canvas.flip_layer(self.selected_id(), horizontal)
        self.touch()

    ## Image › Flip Canvas: every layer mirrored about the canvas's middle.
    pub func flip_canvas(self, horizontal: bool) -> unit!:
        self.canvas.flip_canvas(horizontal)
        self.touch()

    pub func end_preview(self, keep: bool) -> unit!:
        self.canvas.end_preview(keep)
        self.touch()

    ## Apply adjustment `kind` to the selected layer's pixels at once, with the
    ## engine's `numbers` (the rest 0; adjust.frag lists them). Kinds are
    ## luce-image's: 0 brightness/contrast, 1 hue/saturation/lightness,
    ## 2 invert, 3 levels, 4 desaturate, 5 threshold, 6 posterize, 7 curves,
    ## 8 exposure, 9 black & white, 10 color balance, 11 gradient map.
    pub func adjust(self, kind: int, numbers: list[float]) -> unit!:
        self.stage(numbers)
        self.canvas.adjust_layer(self.selected_id(), kind)
        self.touch()

    ## A Gaussian blur of `radius` pixels on the selected layer at once.
    pub func blur(self, radius: float) -> unit!:
        self.canvas.blur_layer(self.selected_id(), radius)
        self.touch()

    # -- Layer styles.

    ## Set one style setting of the selected layer, by field (see Canvas.style_value).
    pub func set_style_value(self, field: int, value: float) -> unit!:
        self.canvas.set_style_value(self.selected_id(), field, value)
        self.touch()

    ## One style setting of the selected layer (see Canvas.style_value).
    pub func style_value(self, field: int) -> float!:
        return self.canvas.style_value(self.selected, field)

    # -- Colors.

    ## The foreground (or background) color as sRGB hex, for the picker.
    pub func color_hex(self, background: bool = false) -> str:
        if background:
            return hex_of_linear(self.back_red, self.back_green, self.back_blue)
        return hex_of_linear(self.red, self.green, self.blue)

    ## Set the foreground (or background) color from sRGB hex like "#e7a03f"; anything else is ignored.
    pub func set_color_hex(self, text: str, background: bool = false):
        let values = linear_of_hex(text) else return
        self.set_palette(values[0], values[1], values[2], background)

    ## Set the foreground color, linear components.
    pub func set_color(self, red: float, green: float, blue: float):
        self.set_palette(red, green, blue, false)

    ## Set one color of the palette, linear components. Picking a foreground
    ## color while erasing goes back to the brush, as Photoshop does.
    pub func set_palette(self, red: float, green: float, blue: float, background: bool):
        if background:
            self.back_red = red
            self.back_green = green
            self.back_blue = blue
        else:
            self.red = red
            self.green = green
            self.blue = blue
            if self.tool == "eraser":
                self.choose_tool("brush")
        self.touch()

    ## X: the foreground and background colors change places.
    pub func swap_colors(self):
        let red = self.red
        let green = self.green
        let blue = self.blue
        self.set_palette(self.back_red, self.back_green, self.back_blue, false)
        self.set_palette(red, green, blue, true)

    ## D: black over white again.
    pub func reset_colors(self):
        self.set_palette(0.0, 0.0, 0.0, false)
        self.set_palette(1.0, 1.0, 1.0, true)

    ## The eyedropper: the flattened color under a document point becomes the
    ## foreground color (the background one while the picker samples for it).
    pub func pick(self, x: float, y: float) -> unit!:
        let px = int(math.floor(x))
        let py = int(math.floor(y))
        if px < 0 or py < 0 or px >= self.width() or py >= self.height():
            return
        self.canvas.pick(px, py)
        if self.canvas.picked_alpha() > 0.0:
            self.set_palette(self.canvas.picked_red(), self.canvas.picked_green(), self.canvas.picked_blue(), self.sampling and self.sampling_background)

    # -- Tools and selections.

    ## Make `tool` (a `tools()` id) active.
    pub func choose_tool(self, tool: str):
        if tool != self.tool:
            self.tool_before = self.tool
        self.tool_used = false
        self.tool = tool
        self.erasing = tool == "eraser"
        # The Crop tool's box starts around the whole canvas, and goes with the tool.
        if tool == "crop":
            if self.crop_box == none:
                self.crop_box = CropBox(float(self.width()), float(self.height()))
        else:
            self.crop_box = none
        self.touch()

    pub func select_all(self) -> unit!:
        self.canvas.select_all()
        self.touch()

    pub func deselect(self) -> unit!:
        self.canvas.deselect()
        self.touch()

    pub func invert_selection(self) -> unit!:
        self.canvas.invert_selection()
        self.touch()

    ## Grow the selection by `pixels` (negative: shrink) and soften its edge by `feather`.
    pub func adjust_selection(self, pixels: int, feather: int) -> unit!:
        self.canvas.adjust_selection(pixels, feather)
        self.touch()

    ## Select the top visible layer with pixels at a document point, if any.
    pub func pick_layer(self, x: float, y: float, add: bool = false) -> unit!:
        let index = self.canvas.layer_at(int(math.floor(x)), int(math.floor(y)))
        if index < 0 or index == self.selected:
            return
        # With `add` it joins the selection (or leaves it), as Cmd-Shift-click.
        if add:
            self.toggle_picked(index)
        else:
            self.select(index)

    ## Whether the document pixel under a point is selected at all.
    pub func in_selection(self, x: float, y: float) -> bool:
        let px = int(math.floor(x))
        let py = int(math.floor(y))
        if not self.canvas.has_selection() or px < 0 or py < 0 or px >= self.width() or py >= self.height():
            return false
        return self.canvas.selected_at(px, py) > 0

    ## Move the selection's outline by whole pixels, leaving the pixels.
    pub func move_selection(self, dx: int, dy: int) -> unit!:
        self.canvas.move_selection(dx, dy)
        self.touch()

    ## Move (or, with `copy`, copy) the selected pixels of the selected layer by
    ## whole pixels, the outline with them. Undoable.
    pub func move_selected_pixels(self, dx: int, dy: int, copy: bool) -> unit!:
        self.canvas.move_selected_pixels(self.selected_id(), dx, dy, copy)
        self.touch()

    ## Show the selected pixels moved by whole pixels, within a preview begun
    ## with `begin_preview`; `end_preview` keeps or drops it.
    pub func preview_move_selected(self, dx: int, dy: int, copy: bool) -> unit!:
        self.canvas.preview_move_selected(dx, dy, copy)
        self.touch()

    ## A rectangle or ellipse between two document corners, combined with the
    ## selection by `mode` (0 replace, 1 add, 2 subtract, 3 intersect).
    pub func select_shape(self, x0: float, y0: float, x1: float, y1: float, ellipse: bool, mode: int) -> unit!:
        let left = int(math.floor(math.min(x0, x1)))
        let top = int(math.floor(math.min(y0, y1)))
        let right = int(math.ceil(math.max(x0, x1)))
        let bottom = int(math.ceil(math.max(y0, y1)))
        if right <= left or bottom <= top:
            return
        self.selecting.apply(self.canvas, not ellipse)
        if ellipse:
            self.canvas.select_ellipse(left, top, right - left, bottom - top, mode)
        else:
            self.canvas.select_rectangle(left, top, right - left, bottom - top, mode)
        self.touch()

    ## The magic wand at a document pixel on the selected layer, combined by `mode` (as `select_shape`).
    pub func select_wand(self, x: float, y: float, mode: int) -> unit!:
        let px = int(math.floor(x))
        let py = int(math.floor(y))
        if px < 0 or py < 0 or px >= self.width() or py >= self.height():
            return
        self.selecting.apply(self.canvas, false)
        self.canvas.select_wand(self.selected_id(), px, py, self.tolerance, self.contiguous, mode, self.selecting.sample, self.selecting.all_layers)
        self.touch()

    # -- The view.

    ## Zoom about a point of the view, keeping the document pixel under it still.
    pub func zoom_about(self, factor: float, x: float, y: float):
        let next = math.max(1.0 / 64.0, math.min(64.0, self.zoom * factor))
        let applied = next / self.zoom
        self.offset_x = x - (x - self.offset_x) * applied
        self.offset_y = y - (y - self.offset_y) * applied
        self.zoom = next
        self.touch()

    pub func pan(self, dx: float, dy: float):
        self.offset_x += dx
        self.offset_y += dy
        self.touch()

    ## Fit the document into a `width` by `height` view with a margin.
    pub func fit(self, width: float, height: float):
        let margin = 40.0
        let available_x = math.max(1.0, width - margin * 2.0)
        let available_y = math.max(1.0, height - margin * 2.0)
        self.zoom = math.max(1.0 / 64.0, math.min(64.0, math.min(available_x / float(self.width()), available_y / float(self.height()))))
        self.center_in(width, height)
        self.fitted = true
        self.touch()

    ## 100%, centred in a `width` by `height` view.
    pub func actual_size(self, width: float, height: float):
        self.zoom = 1.0
        self.center_in(width, height)
        self.touch()

    func center_in(self, width: float, height: float):
        self.offset_x = math.floor((width - float(self.width()) * self.zoom) * 0.5)
        self.offset_y = math.floor((height - float(self.height()) * self.zoom) * 0.5)

