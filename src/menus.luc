## The menu bar: the shared commands, shortcuts and all, grouped as Photoshop
## groups them. Every item is a Command from `Actions`; what it does is wired
## in `Panels`.
from ui import Font, Toolbar, Menu, Command, Spacer
from actions import Actions

pub func menu_bar(actions: Actions, font: Font) -> Toolbar!:
    return Toolbar([Menu("File", [actions.new_document, actions.open_document, actions.save, actions.save_as, divider(), actions.close_document], font = font),
                    Menu("Edit", [actions.undo, actions.redo, actions.free_transform, actions.fill, actions.fill_background, actions.clear,
                                  actions.swap_colors, actions.reset_colors, divider(), actions.settings], font = font),
                    Menu("Select", [actions.select_all, actions.deselect, actions.inverse, actions.expand, actions.contract, actions.feather], font = font),
                    Menu("Image", [actions.document_settings, divider(), actions.crop, actions.canvas_size, actions.image_size], font = font),
                    Menu("Adjust", actions.adjustments, font = font),
                    Menu("Layer", [actions.add_layer, actions.duplicate_layer, actions.layer_up, actions.layer_down, actions.merge_down, actions.delete_layer,
                                   actions.toggle_mask, actions.toggle_mask_editing, actions.toggle_clipped, actions.toggle_visibility,
                                   actions.rename_layer, actions.layer_style], font = font),
                    Menu("Filter", [actions.blur], font = font),
                    Menu("View", [actions.fit, actions.actual_size, actions.zoom_in, actions.zoom_out, divider(), actions.show_rulers, actions.show_grid]
                                 + actions.units + [divider(), actions.next_document, actions.previous_document], font = font),
                    Spacer()], font = font)

## A menu's separator line.
func divider() -> Command!:
    return Command("", divider = true)
