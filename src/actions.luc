## One Command instance per action, as in luced: the menus, the tool rail and
## the keyboard all present the same command, so a shortcut shows beside its
## menu item and disabling an action disables it everywhere at once.
from ui import Command, Shortcut
from input import Key
from workspace import Workspace
from canvas import Canvas
from tools import tools
from units import unit_ids, unit_label

pub class Actions:
    # File
    pub let new_document: Command
    pub let open_document: Command
    pub let save: Command
    pub let save_as: Command
    pub let close_document: Command
    pub let next_document: Command
    pub let previous_document: Command
    # Edit
    pub let undo: Command
    pub let redo: Command
    ## The system clipboard: the selected pixels of the layer (or, Copy Merged,
    ## of the whole picture) as an image; Paste makes a new layer.
    pub let cut: Command
    pub let copy: Command
    pub let copy_merged: Command
    pub let paste: Command
    pub let fill: Command
    pub let fill_background: Command
    pub let clear: Command
    pub let swap_colors: Command
    pub let reset_colors: Command
    pub let free_transform: Command
    pub let settings: Command
    # Select
    pub let select_all: Command
    pub let deselect: Command
    pub let inverse: Command
    pub let expand: Command
    pub let contract: Command
    pub let feather: Command
    # Image
    pub let crop: Command
    pub let canvas_size: Command
    pub let image_size: Command
    # Adjust, one per luce-image adjustment kind, and Filter
    pub let adjustments: list[Command]
    pub let blur: Command
    # Layer
    pub let add_layer: Command
    pub let duplicate_layer: Command
    ## Cmd-J and Shift-Cmd-J: a new layer of the selected pixels, copied or cut.
    pub let layer_via_copy: Command
    pub let layer_via_cut: Command
    pub let layer_up: Command
    pub let layer_down: Command
    pub let merge_down: Command
    pub let delete_layer: Command
    pub let toggle_mask: Command
    pub let toggle_mask_editing: Command
    pub let toggle_clipped: Command
    pub let toggle_visibility: Command
    pub let layer_style: Command
    pub let rename_layer: Command
    pub let blends: list[Command]
    ## Shift + and Shift -: the selected layer's blend mode, one step through Photoshop's list.
    pub let next_blend: Command
    pub let previous_blend: Command
    # View
    pub let fit: Command
    pub let show_rulers: Command
    pub let show_grid: Command
    ## Rulers and sizes in pixels, millimeters or inches.
    pub let units: list[Command]
    pub let document_settings: Command
    pub let actual_size: Command
    pub let zoom_in: Command
    pub let zoom_out: Command
    ## One command per tool, in `tools()` order; the command id is the tool's id.
    pub let tools: list[Command]
    pub let bigger: Command
    pub let smaller: Command
    ## Shift ] and Shift [: the brush's hardness by a quarter.
    pub let harder: Command
    pub let softer: Command
    pub let all: list[Command]

    pub func init(self) -> unit!:
        self.new_document = Command("New…", Shortcut(Key.n, primary = true), id = "new")
        self.open_document = Command("Open…", Shortcut(Key.o, primary = true), id = "open")
        self.save = Command("Save", Shortcut(Key.s, primary = true), id = "save")
        self.save_as = Command("Save As…", Shortcut(Key.s, primary = true, shift = true), id = "save_as")
        self.close_document = Command("Close", Shortcut(Key.w, primary = true), id = "close_document")
        self.next_document = Command("Next Document", Shortcut(Key.right_bracket, primary = true, alt = true), id = "next_document")
        self.previous_document = Command("Previous Document", Shortcut(Key.left_bracket, primary = true, alt = true), id = "previous_document")
        self.undo = Command("Undo", Shortcut(Key.z, primary = true), id = "undo")
        self.redo = Command("Redo", Shortcut(Key.z, primary = true, shift = true), id = "redo")
        self.cut = Command("Cut", Shortcut(Key.x, primary = true), id = "cut")
        self.copy = Command("Copy", Shortcut(Key.c, primary = true), id = "copy")
        self.copy_merged = Command("Copy Merged", Shortcut(Key.c, primary = true, shift = true), id = "copy_merged")
        self.paste = Command("Paste", Shortcut(Key.v, primary = true), id = "paste")
        self.fill = Command("Fill Selection with Color", Shortcut(Key.backspace, alt = true), id = "fill")
        self.clear = Command("Clear Selection", Shortcut(Key.backspace), id = "clear")
        self.fill_background = Command("Fill Selection with Background", Shortcut(Key.backspace, primary = true), id = "fill_background")
        self.swap_colors = Command("Swap Colors", Shortcut(Key.x), id = "swap_colors")
        self.reset_colors = Command("Default Colors", Shortcut(Key.d), id = "reset_colors")
        self.free_transform = Command("Free Transform…", Shortcut(Key.t, primary = true), id = "free_transform")
        self.settings = Command("Settings…", Shortcut(Key.comma, primary = true), id = "settings")
        self.select_all = Command("All", Shortcut(Key.a, primary = true), id = "select_all")
        self.deselect = Command("Deselect", Shortcut(Key.d, primary = true), id = "deselect")
        self.inverse = Command("Inverse", Shortcut(Key.i, primary = true, shift = true), id = "inverse")
        self.expand = Command("Expand…", id = "expand")
        self.contract = Command("Contract…", id = "contract")
        self.feather = Command("Feather…", id = "feather")
        self.crop = Command("Crop to Selection", id = "crop")
        self.canvas_size = Command("Canvas Size…", id = "canvas_size")
        self.image_size = Command("Image Size…", id = "image_size")
        self.adjustments = [Command("Brightness / Contrast…", id = "adjust_0"), Command("Hue / Saturation / Lightness…", Shortcut(Key.u, primary = true), id = "adjust_1"),
                            Command("Invert", Shortcut(Key.i, primary = true), id = "adjust_2"), Command("Levels…", Shortcut(Key.l, primary = true), id = "adjust_3"),
                            Command("Desaturate", Shortcut(Key.u, primary = true, shift = true), id = "adjust_4"),
                            Command("Threshold…", id = "adjust_5"), Command("Posterize…", id = "adjust_6"),
                            Command("Curves…", Shortcut(Key.m, primary = true), id = "adjust_7")]
        self.blur = Command("Gaussian Blur…", id = "blur")
        self.add_layer = Command("New Layer", Shortcut(Key.n, primary = true, shift = true), id = "add_layer")
        self.duplicate_layer = Command("Duplicate Layer", id = "duplicate_layer")
        self.layer_via_copy = Command("Layer via Copy", Shortcut(Key.j, primary = true), id = "layer_via_copy")
        self.layer_via_cut = Command("Layer via Cut", Shortcut(Key.j, primary = true, shift = true), id = "layer_via_cut")
        self.layer_up = Command("Move Layer Up", Shortcut(Key.right_bracket, primary = true), id = "layer_up")
        self.layer_down = Command("Move Layer Down", Shortcut(Key.left_bracket, primary = true), id = "layer_down")
        self.merge_down = Command("Merge Down", Shortcut(Key.e, primary = true), id = "merge_down")
        self.delete_layer = Command("Delete Layer", Shortcut(Key.delete, primary = true, shift = true), id = "delete_layer")
        self.toggle_mask = Command("Add / Remove Mask", id = "toggle_mask")
        self.toggle_mask_editing = Command("Edit Mask / Pixels", Shortcut(Key.backslash), id = "toggle_mask_editing")
        self.toggle_clipped = Command("Clip to Below / Release", Shortcut(Key.g, primary = true, alt = true), id = "toggle_clipped")
        self.toggle_visibility = Command("Hide / Show", Shortcut(Key.h, primary = true, shift = true), id = "toggle_visibility")
        self.layer_style = Command("Layer Style…", id = "layer_style")
        self.rename_layer = Command("Rename Layer…", id = "rename_layer")
        self.blends = []
        var mode = 0
        while mode < Canvas.blend_mode_count():
            self.blends.append(Command(Canvas.blend_mode_name(mode), id = f"blend_{mode}"))
            mode += 1
        self.next_blend = Command("Next Blend Mode", Shortcut(Key.equal, shift = true), id = "next_blend")
        self.previous_blend = Command("Previous Blend Mode", Shortcut(Key.minus, shift = true), id = "previous_blend")
        self.fit = Command("Fit", Shortcut(Key.digit_0, primary = true), id = "fit")
        self.show_rulers = Command("Show Rulers", Shortcut(Key.r, primary = true), id = "show_rulers")
        self.show_grid = Command("Show Grid", Shortcut(Key.apostrophe, primary = true), id = "show_grid")
        self.units = []
        for unit_id in unit_ids():
            self.units.append(Command(unit_label(unit_id), id = f"units_{unit_id}"))
        self.document_settings = Command("Document Settings…", Shortcut(Key.i, primary = true, alt = true), id = "document_settings")
        self.actual_size = Command("Actual Size", Shortcut(Key.digit_1, primary = true), id = "actual_size")
        self.zoom_in = Command("Zoom In", Shortcut(Key.equal, primary = true), id = "zoom_in")
        self.zoom_out = Command("Zoom Out", Shortcut(Key.minus, primary = true), id = "zoom_out")
        self.tools = []
        for tool in tools():
            self.tools.append(Command(tool.name, Shortcut(tool.key, shift = tool.shift), id = tool.id))
        self.bigger = Command("Bigger Brush", Shortcut(Key.right_bracket), id = "bigger")
        self.smaller = Command("Smaller Brush", Shortcut(Key.left_bracket), id = "smaller")
        self.harder = Command("Harder Brush", Shortcut(Key.right_bracket, shift = true), id = "harder")
        self.softer = Command("Softer Brush", Shortcut(Key.left_bracket, shift = true), id = "softer")
        self.all = [self.new_document, self.open_document, self.save, self.save_as, self.close_document, self.next_document, self.previous_document, self.undo, self.redo, self.cut, self.copy, self.copy_merged, self.paste, self.fill, self.fill_background, self.clear, self.swap_colors, self.reset_colors, self.free_transform, self.settings,
                    self.select_all, self.deselect, self.inverse, self.expand, self.contract, self.feather,
                    self.crop, self.canvas_size, self.image_size, self.blur,
                    self.add_layer, self.duplicate_layer, self.layer_via_copy, self.layer_via_cut, self.layer_up, self.layer_down, self.merge_down, self.delete_layer,
                    self.toggle_mask, self.toggle_mask_editing, self.toggle_clipped, self.toggle_visibility, self.layer_style, self.rename_layer,
                    self.fit, self.actual_size, self.zoom_in, self.zoom_out, self.show_rulers, self.show_grid, self.document_settings, self.bigger, self.smaller, self.harder, self.softer, self.next_blend, self.previous_blend] + self.adjustments + self.blends + self.tools + self.units

    ## Enable what the document's state allows.
    pub func update(self, workspace: Workspace) -> unit!:
        let canvas = workspace.canvas
        let previewing = canvas.previewing()
        let selection = canvas.has_selection()
        let layers = workspace.layer_count()
        self.undo.set_enabled(canvas.can_undo() and not previewing)
        self.redo.set_enabled(canvas.can_redo() and not previewing)
        self.deselect.set_enabled(selection)
        self.cut.set_enabled(selection and not previewing)
        self.layer_via_cut.set_enabled(selection and not previewing)
        self.inverse.set_enabled(selection)
        self.expand.set_enabled(selection)
        self.contract.set_enabled(selection)
        self.feather.set_enabled(selection)
        self.crop.set_enabled(selection)
        self.layer_up.set_enabled(workspace.selected < layers - 1)
        self.layer_down.set_enabled(workspace.selected > 0)
        self.merge_down.set_enabled(workspace.selected > 0)
        self.delete_layer.set_enabled(layers > 1)
        self.toggle_mask_editing.set_enabled(canvas.layer_masked(workspace.selected))
        self.toggle_clipped.set_enabled(workspace.selected > 0)
        for command in self.adjustments:
            command.set_enabled(not previewing)
        self.blur.set_enabled(not previewing)
        self.free_transform.set_enabled(not previewing)
        self.layer_style.set_enabled(not previewing)
