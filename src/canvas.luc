from ui import Widget, Layout, Size, Constraints, Event, Painter, Point, Raster
from gpu import RenderTarget, Rect, Color
from input import EventKind, Cursor
from document import Document
import math

pub class Canvas: Widget:
    let box: Layout
    pub let document: Document
    var cache: Raster
    var revision: int = -1
    var dragging: bool = false
    var last_x: float = 0.0
    var last_y: float = 0.0
    var pointer_x: float = 0.0
    var pointer_y: float = 0.0
    var pointer_inside: bool = false

    pub func init(self, document: Document) -> unit!:
        self.document = document
        self.cache = Raster(document.width, document.height)
        self.box = Layout()
        self.box.set_focusable(true)
        self.box.set_cursor(Cursor.arrow)
        self.box.set_flex()
        self.box.set_limits(Size(200.0, 160.0), Size(16384.0, 16384.0))

    pub func layout(self) -> Layout:
        return self.box

    pub func measure(self, available: Constraints) -> Size!:
        return Size(820.0, 640.0)

    pub func scale(self) -> float:
        let bounds = self.box.bounds()
        return math.max(0.01, math.min((bounds.width - 48.0) / float(self.document.width), (bounds.height - 48.0) / float(self.document.height)))

    pub func rectangle(self) -> Rect:
        let bounds = self.box.bounds()
        let width = float(self.document.width) * self.scale()
        let height = float(self.document.height) * self.scale()
        return Rect((bounds.width - width) * 0.5, (bounds.height - height) * 0.5, width, height)

    pub func draw(self, target: RenderTarget) -> unit!:
        let painter = Painter(target)
        let size = target.size()
        painter.rectangle(Rect(0.0, 0.0, size.width, size.height), Color(0.028, 0.028, 0.031))
        let rect = self.rectangle()
        painter.rectangle(Rect(rect.x + 4.0, rect.y + 4.0, rect.width, rect.height), Color(0.008, 0.008, 0.01))
        painter.rectangle(rect, Color(0.78, 0.78, 0.78))
        var y = 0.0
        var row = 0
        while y < rect.height:
            var x = 0.0
            var column = 0
            while x < rect.width:
                if (column + row) % 2 == 0:
                    painter.rectangle(Rect(rect.x + x, rect.y + y, math.min(12.0, rect.width - x), math.min(12.0, rect.height - y)), Color(0.58, 0.58, 0.58))
                x += 12.0
                column += 1
            y += 12.0
            row += 1
        if self.revision != self.document.revision:
            self.cache = self.document.flattened()
            self.revision = self.document.revision
        self.cache.draw(target, rect)
        if self.pointer_inside:
            let radius = float(self.document.diameter()) * self.scale() * 0.5
            for index in 0..<48:
                let angle = float(index) * 6.283185307 / 48.0
                let next = float(index + 1) * 6.283185307 / 48.0
                let a = Point(self.pointer_x + math.cos(angle) * radius, self.pointer_y + math.sin(angle) * radius)
                let b = Point(self.pointer_x + math.cos(next) * radius, self.pointer_y + math.sin(next) * radius)
                painter.line(a, b, 3.0, Color(0.01, 0.01, 0.01))
                painter.line(a, b, 1.0, Color(0.9, 0.9, 0.9))
        painter.close()

    pub func rendered_alpha(self, x: int, y: int) -> float!:
        return self.cache.alpha_at(x, y)

    pub func event(self, event: Event) -> unit!:
        if event.cancelled:
            self.dragging = false
            self.pointer_inside = false
            self.box.invalidate()
            return
        let rect = self.rectangle()
        let x = (event.x - rect.x) / self.scale()
        let y = (event.y - rect.y) / self.scale()
        let inside = x >= 0.0 and y >= 0.0 and x < float(self.document.width) and y < float(self.document.height)
        if event.kind == EventKind.pointer_down and event.button == 0 and event.inside and inside:
            if not self.document.active().visible:
                return
            self.document.checkpoint()
            self.dragging = true
            self.document.dab(x, y)
            self.last_x = x
            self.last_y = y
        elif event.kind == EventKind.pointer_moved:
            self.pointer_x = event.x
            self.pointer_y = event.y
            self.pointer_inside = inside
            if self.dragging:
                self.document.segment(self.last_x, self.last_y, x, y)
                self.last_x = x
                self.last_y = y
        elif event.kind == EventKind.pointer_up and event.button == 0:
            if self.dragging:
                self.document.segment(self.last_x, self.last_y, x, y)
            self.dragging = false
        elif event.kind == EventKind.pointer_left:
            self.pointer_inside = false
        self.box.invalidate()
