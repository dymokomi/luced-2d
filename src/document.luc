from ui import Raster
from gpu import Color
import math

pub class Layer:
    pub var name: str
    pub var pixels: Raster
    pub var opacity: int = 100
    pub var visible: bool = true

    pub func init(self, name: str, pixels: Raster):
        self.name = name
        self.pixels = pixels

pub class Document:
    pub var width: int = 800
    pub var height: int = 600
    pub var dpi: int = 72
    pub let layers: list[Layer]
    pub var selected: int = 0
    pub var revision: int = 0
    pub var serial: int = 1
    pub var erasing: bool = false
    pub var brush_diameter: int = 32
    pub var brush_hardness: int = 75
    pub var eraser_diameter: int = 64
    pub var eraser_hardness: int = 100
    pub var color: Color = Color(0.02, 0.18, 0.65)
    let history: list[Raster]
    let future: list[Raster]

    pub func init(self) -> unit!:
        self.layers = [Layer("Layer 1", Raster(self.width, self.height))]
        self.history = []
        self.future = []

    pub func active(self) -> Layer:
        return self.layers[self.selected]

    pub func diameter(self) -> int:
        return self.eraser_diameter if self.erasing else self.brush_diameter

    pub func hardness(self) -> int:
        return self.eraser_hardness if self.erasing else self.brush_hardness

    pub func touch(self):
        self.revision += 1

    pub func forget(self):
        self.history.clear()
        self.future.clear()

    pub func checkpoint(self) -> unit!:
        self.history.append(self.active().pixels.copy())
        if self.history.length > 12:
            discard(self.history.remove_at(0))
        self.future.clear()

    pub func undo(self) -> unit!:
        if self.history.length == 0:
            return
        self.future.append(self.active().pixels)
        self.active().pixels = self.history.pop()
        self.touch()

    pub func redo(self) -> unit!:
        if self.future.length == 0:
            return
        self.history.append(self.active().pixels)
        self.active().pixels = self.future.pop()
        self.touch()

    pub func choose(self, index: int):
        if index >= 0 and index < self.layers.length and index != self.selected:
            self.selected = index
            self.forget()
            self.touch()

    pub func add(self) -> unit!:
        if self.layers.length >= 16:
            return
        self.serial += 1
        self.layers.insert(self.selected + 1, Layer(f"Layer {self.serial}", Raster(self.width, self.height)))
        self.selected += 1
        self.forget()
        self.touch()

    pub func remove(self):
        if self.layers.length <= 1:
            return
        discard(self.layers.remove_at(self.selected))
        self.selected = math.imin(self.selected, self.layers.length - 1)
        self.forget()
        self.touch()

    pub func move(self, direction: int):
        let index = self.selected + direction
        if index < 0 or index >= self.layers.length:
            return
        let layer = self.layers.remove_at(self.selected)
        self.layers.insert(index, layer)
        self.selected = index
        self.forget()
        self.touch()

    pub func resize(self, width: int, height: int) -> unit!:
        let replacements: list[Raster] = []
        for layer in self.layers:
            replacements.append(layer.pixels.resized(width, height))
        for index in 0..<self.layers.length:
            let layer = self.layers[index]
            layer.pixels = replacements[index]
        self.width = width
        self.height = height
        self.forget()
        self.touch()

    pub func dab(self, x: float, y: float) -> unit!:
        self.active().pixels.dab(x, y, float(self.diameter()), float(self.hardness()) / 100.0, self.color, self.erasing)
        self.touch()

    pub func segment(self, x: float, y: float, end_x: float, end_y: float) -> unit!:
        let dx = end_x - x
        let dy = end_y - y
        let distance = math.sqrt(dx * dx + dy * dy)
        let steps = math.imax(1, int(math.ceil(distance / math.max(1.0, float(self.diameter()) * 0.15))))
        for step in 1..=steps:
            let fraction = float(step) / float(steps)
            self.dab(x + dx * fraction, y + dy * fraction)

    pub func flattened(self) -> Raster!:
        let result = Raster(self.width, self.height)
        for layer in self.layers:
            if layer.visible and layer.opacity > 0:
                result.composite(layer.pixels, float(layer.opacity) / 100.0)
        return result
