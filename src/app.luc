from ui import Application, Font, Command, Shortcut
from input import Key
from interop import Connection
from document import Document
from panels import Panels

pub class Luce2D:
    pub let app: Application
    pub let document: Document
    pub let panels: Panels
    let connections: list[Connection]

    pub func init(self) -> unit!:
        let font = Font()
        let document = Document()
        let panels = Panels(document, font)
        let app = Application(panels.body, title = "luced-2d", width = 1200, height = 800)
        let brush = Command("Brush", Shortcut(Key.b), id = "brush")
        let eraser = Command("Eraser", Shortcut(Key.e), id = "eraser")
        let undo = Command("Undo", Shortcut(Key.z, primary = true), id = "undo")
        let redo = Command("Redo", Shortcut(Key.z, primary = true, shift = true), id = "redo")
        let connections: list[Connection] = []
        connections.append(brush.on_trigger(panels.brush))
        connections.append(eraser.on_trigger(panels.erase))
        connections.append(undo.on_trigger(panels.undo))
        connections.append(redo.on_trigger(panels.redo))
        app.set_commands([brush, eraser, undo, redo])
        self.app = app
        self.document = document
        self.panels = panels
        self.connections = connections

    pub func run(self, arguments: list[str]) -> unit!:
        self.app.run(frame_limit = 3 if "--smoke" in arguments else 0)

    pub func close(self):
        for connection in self.connections:
            connection.disconnect()
        self.connections.clear()
        self.panels.close()
        self.app.close()
