## luced-2d's application: it loads the settings, builds the workspace and the
## window's panels, opens any files named on the command line, and runs the
## window until it closes.
from ui import Application, Font
from interop import Connection
from workspace import Workspace
from canvas import Canvas
from panels import Panels
from actions import Actions
from settings import Store
from tool_memory import tools_path, restore_tools, remember_tools
from dock_layout import layout_path
from update_check import UpdateCheck
import theme
import crash

## The version crash reports carry; keep it equal to package.prisma's.
pub let version: str = "0.1.102"

pub class Luce2D:
    pub let app: Application
    pub let workspace: Workspace
    pub let panels: Panels
    let connections: list[Connection]
    let update: UpdateCheck

    pub func init(self) -> unit!:
        # Crash reports first, so anything below that traps leaves one; then the
        # report the last run left, if it crashed, to show once the window is up.
        crash.enable("luced-2d", version)
        let previous_crash = crash.take_report("luced-2d")
        let font = Font()
        # Settings come first: a new canvas takes their size, the window their theme.
        let store = Store()
        let settings = store.load()
        let workspace = Workspace(settings.canvas_width, settings.canvas_height)
        let actions = Actions()
        # The tool options as the last run left them, the tool in hand with them.
        restore_tools(workspace, tools_path())
        let panels = Panels(workspace, actions, font, store)
        panels.choose_tool(workspace.tool)
        # The panels as the last run left them.
        panels.dock_layout.restore(layout_path())
        let app = Application(panels.body, title = "luced-2d", width = 1400, height = 900, theme = theme.editor_theme(workspace.look))
        panels.files.app = app
        # Keys go to the canvas from the start, so a tool's letter picks the tool.
        app.focus(panels.view.layout())
        app.set_close_handler(panels.files.can_quit)
        panels.settings_dialog.app = app
        panels.scripts.app = app
        # Whether a newer release is out, asked in the background and told once.
        let update = UpdateCheck(version)
        update.start()
        let connections: list[Connection] = []
        connections.append(app.on_frame(func (elapsed: float) -> unit!:
            discard(elapsed)
            panels.view.march()
            panels.scripts.poll()
            panels.adjust.poll()
            panels.rail.poll()
            panels.color_range.poll()
            panels.select_mask.poll()
            panels.catalog.poll()
            panels.dock_layout.poll()
            panels.settle_focus()
            panels.refresh_if_changed()
            if update.poll():
                panels.status.set_text(update.notice)))
        app.set_commands(actions.all)
        # What input could not do (a filter on a group, a file that would not
        # open) is said in a prompt rather than ending the run.
        app.set_error_handler(panels.prompts.tell)
        panels.settings_dialog.apply()
        if store.warning != "":
            panels.status.set_text(store.warning)
        if previous_crash != "":
            panels.show_crash(previous_crash)
        self.app = app
        self.workspace = workspace
        self.panels = panels
        self.connections = connections
        self.update = update

    pub func run(self, arguments: list[str]) -> unit!:
        # Luce's `main` gets the arguments without the program: each is a file to open.
        for argument in arguments:
            if argument.length > 0 and argument != "--smoke":
                self.workspace.open(argument)
                self.panels.refresh()
        self.app.run(frame_limit = 3 if "--smoke" in arguments else 0)

    pub func close(self):
        remember_tools(self.workspace, tools_path()) catch failure:
            discard(failure)
        self.panels.dock_layout.save() catch failure:
            discard(failure)
        self.update.close()
        for connection in self.connections:
            connection.disconnect()
        self.connections.clear()
        self.panels.close()
        self.app.close()
        # Nothing reads tiles now: the scratch file and its folder can go.
        Canvas.release_scratch_file()
