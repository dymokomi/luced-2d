from luce_std import files, paths
from brush_tests import brush_tests
from background_tests import background_tests
from workspace_tests import layers, viewing, contents, settings_round_trip, checker_regions, picking, adjustment_table, unsaved_changes, whole_layers, tool_options_kept, update_versions, opens_photos, settings_save_pending
from canvas_tool_tests import tool_gestures, boxes, retouch_tools, selection_tools, guides_and_snapping, live_text, live_gradient, crop_box_options, stroke_undo, eyedropper_sample, brush_sizing, tool_modes, dodge_and_burn, pen_paths, lasso_cycle, corner_modes, warping
from panel_tests import layer_panel_ops, size_dialogs, mask_actions, effect_rows, filter_dialogs, color_range, replace_color, on_image_adjustment, hue_ranges, panel_catalog, aligning, dock_layouts, navigator_boxes, refining_selections, color_panel_modes
from properties_tests import properties_rows
from layer_kind_tests import scripts, script_editor, groups_and_shapes, alpha_channel_panel, vector_panel, node_editor

## The update check compares src/app.luc's version, which must be the package's.
func application_version(root: str) -> unit!:
    let declared = files.read_text(paths.join(root, "package.prisma")).split("    str version = \"")[1].split("\"")[0]
    let said = files.read_text(paths.join(root, "src/app.luc")).split("pub let version: str = \"")[1].split("\"")[0]
    assert(said == declared, f"src/app.luc says {said}; package.prisma says {declared}")

## Headless checks of the workspace and the window contents, without a device:
## drawing on a standalone frame records nothing but must not fail. The checks that write
## files get a scratch folder under build/tests/app.
pub func main(arguments: list[str]) -> int!:
    let root = files.canonical("../..")
    application_version(root)
    let folder = paths.join(root, "build/tests/app/scratch")
    if files.exists(folder):
        files.remove_tree(folder)
    files.ensure_directory(folder)
    let scratch = [folder]
    layers()
    picking()
    viewing()
    contents()
    settings_round_trip()
    checker_regions()
    tool_gestures()
    boxes()
    corner_modes()
    adjustment_table()
    retouch_tools()
    unsaved_changes(scratch)
    layer_panel_ops()
    properties_rows()
    size_dialogs()
    selection_tools()
    guides_and_snapping()
    live_text()
    live_gradient()
    crop_box_options()
    mask_actions()
    stroke_undo()
    eyedropper_sample()
    effect_rows()
    brush_sizing()
    whole_layers()
    filter_dialogs()
    tool_options_kept()
    update_versions()
    color_range()
    replace_color()
    tool_modes()
    scripts()
    script_editor()
    groups_and_shapes()
    dodge_and_burn()
    on_image_adjustment()
    hue_ranges()
    opens_photos()
    panel_catalog()
    navigator_boxes()
    pen_paths()
    aligning()
    dock_layouts(scratch)
    settings_save_pending(scratch)
    lasso_cycle()
    refining_selections()
    warping()
    alpha_channel_panel(scratch)
    vector_panel(scratch)
    node_editor(scratch)
    color_panel_modes()
    brush_tests(scratch)
    background_tests(scratch)
    print("PASS luced-2d workspace, view and panels")
    return 0
