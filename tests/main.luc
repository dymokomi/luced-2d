## Headless checks of the workspace and the window contents, without a device:
## drawing on a standalone frame records nothing but must not fail.
pub func main(arguments: list[str]) -> int!:
    layers()
    picking()
    viewing()
    contents()
    settings_round_trip()
    checker_regions()
    tool_gestures()
    boxes()
    adjustment_table()
    retouch_tools()
    unsaved_changes(arguments)
    layer_panel_ops()
    size_dialogs()
    selection_tools()
    guides_and_snapping()
    live_text()
    live_gradient()
    crop_box_options()
    mask_actions()
    stroke_undo()
    eyedropper_sample()
    effect_rows()
    brush_sizing()
    whole_layers()
    filter_dialogs()
    tool_options_kept()
    update_versions()
    color_range()
    tool_modes()
    scripts()
    script_editor()
    groups_and_shapes()
    dodge_and_burn()
    on_image_adjustment()
    hue_ranges()
    opens_photos()
    print("PASS luced-2d workspace, view and panels")
    return 0

func layers() -> unit!:
    let workspace = Workspace(640, 480)
    assert(workspace.width() == 640 and workspace.height() == 480 and workspace.layer_count() == 1)
    workspace.add_layer()
    workspace.add_layer()
    assert(workspace.layer_count() == 3 and workspace.selected == 2)
    workspace.toggle_visibility()
    assert(not workspace.canvas.layer_visible(2))
    workspace.set_opacity(0.25)
    assert(workspace.canvas.layer_opacity(2) == 0.25)
    workspace.select(0)
    workspace.delete_layer()
    assert(workspace.layer_count() == 2 and workspace.selected == 0)
    workspace.create(32, 16)
    assert(workspace.width() == 32 and workspace.layer_count() == 1 and workspace.path == "")

func viewing() -> unit!:
    let workspace = Workspace(200, 100)
    workspace.fit(1000.0, 600.0)
    assert(workspace.zoom == 4.6 and workspace.offset_x == 40.0 and workspace.offset_y == 70.0)
    workspace.zoom_about(2.0, 40.0, 70.0)
    assert(workspace.zoom == 9.2 and workspace.offset_x == 40.0 and workspace.offset_y == 70.0)
    # Zooming and panning keep the first fit done, so the view does not fit again over them.
    assert(workspace.fitted)
    workspace.pan(5.0, 5.0)
    assert(workspace.fitted and workspace.zoom == 9.2)
    workspace.pan(-5.0, -5.0)
    workspace.zoom_about(0.5, 0.0, 0.0)
    assert(workspace.zoom == 4.6 and workspace.offset_x == 20.0 and workspace.offset_y == 35.0)
    workspace.pan(5.0, -5.0)
    assert(workspace.offset_x == 25.0 and workspace.offset_y == 30.0)
    workspace.actual_size(1000.0, 600.0)
    assert(workspace.zoom == 1.0 and workspace.offset_x == 400.0 and workspace.offset_y == 250.0)
    let view = CanvasView(workspace)
    view.layout().set_size(1000.0, 600.0)
    let frame = Frame(window.Size(1000.0, 600.0, 1000.0, 600.0, 1.0))
    let target = frame.target()
    view.draw(target)
    frame.close()

func contents() -> unit!:
    let workspace = Workspace(300, 200)
    let font = Font()
    let actions = Actions()
    let panels = Panels(workspace, actions, font)
    actions.add_layer.trigger()
    assert(workspace.layer_count() == 2)
    panels.select_layer(0)
    assert(workspace.selected == 0)
    actions.zoom_in.trigger()
    assert(workspace.zoom == 2.0)
    assert(not actions.undo.is_enabled() and not actions.crop.is_enabled())
    actions.select_all.trigger()
    assert(actions.crop.is_enabled())
    actions.tools[10].trigger()
    assert(workspace.tool == "brush")
    actions.tools[5].trigger()
    assert(workspace.tool == "wand")
    # The Crop tool's box starts around the whole canvas and goes with the tool.
    actions.tools[6].trigger()
    let crop = workspace.crop_box else trap("the crop tool shows its box")
    assert(workspace.tool == "crop" and crop.width() == 300 and crop.height() == 200)
    actions.tools[5].trigger()
    assert(workspace.crop_box == none)
    # Brush Settings opens floating, once; docked, it stays where it was put.
    panels.open_brush()
    assert(panels.dock.is_floating(panels.brush.panel) and panels.dock.panel_count() == 4)
    panels.open_brush()
    assert(panels.dock.panel_count() == 4)
    panels.dock.move(panels.brush.panel, panels.properties.panel)
    panels.open_brush()
    assert(not panels.dock.is_floating(panels.brush.panel) and panels.dock.same_group(panels.brush.panel, panels.properties.panel))
    panels.close()

## Settings parse their defaults, survive a round trip through the file text,
## and reject a unit they do not know.
func settings_round_trip() -> unit!:
    let fresh = Settings()
    assert(fresh.canvas_width == 1280 and fresh.canvas_height == 800 and fresh.accent == "#e7a03f" and fresh.control_radius == 5.0)
    let edited = fresh.copy()
    edited.canvas_width = 640
    edited.accent = "#3f8ae7"
    edited.control_radius = 0.0
    edited.shortcuts["save"] = "cmd+shift+s"
    edited.shortcuts["swap_colors"] = "none"
    let reread = Settings(edited.serialize())
    assert(reread.canvas_width == 640 and reread.canvas_height == 800 and reread.accent == "#3f8ae7" and reread.control_radius == 0.0)
    assert(reread.shortcuts["save"] == "cmd+shift+s" and reread.shortcuts["swap_colors"] == "none" and reread.shortcuts.length == 2)
    assert(fresh.shortcuts.length == 0)
    var rejected = false
    discard(Settings("[view]\nunits = \"furlongs\"\n") catch failure:
        discard(failure)
        rejected = true
        return)
    assert(rejected)

## A checker piece of any fractional size and place maps to a source region of
## whole texels inside the 256-texel tile; a pan once rounded a sliver to zero width
## ("an image source region must lie inside its texture").
func checker_regions() -> unit!:
    assert(clamp_texel(-3) == 0 and clamp_texel(300) == 255 and clamp_texel(12) == 12)
    assert(texel_span(0, 0) == 1 and texel_span(255, 400) == 1 and texel_span(10, 20) == 10 and texel_span(0, 256) == 256)
    var start = 0
    while start < 256:
        var end = start - 2
        while end < 260:
            let span = texel_span(clamp_texel(start), end)
            assert(span >= 1 and clamp_texel(start) + span <= 256)
            end += 7
        start += 5

func press(view: CanvasView, x: float, y: float, shift: bool = false, alt: bool = false) -> unit!:
    view.event(Event(kind = EventKind.pointer_down, x = x, y = y, button = 0, inside = true, shift = shift, alt = alt))

func drag_to(view: CanvasView, x: float, y: float, shift: bool = false, alt: bool = false) -> unit!:
    view.event(Event(kind = EventKind.pointer_moved, x = x, y = y, inside = true, shift = shift, alt = alt))

func release(view: CanvasView, x: float, y: float, shift: bool = false, alt: bool = false) -> unit!:
    view.event(Event(kind = EventKind.pointer_up, x = x, y = y, button = 0, inside = true, shift = shift, alt = alt))

## Photoshop's gestures: Z held while using the zoom tool springs back to the
## tool before, a zoom drag scrubs, and shift or alt pressed mid-drag square or
## center the marquee while held at the press they add or subtract.
func tool_gestures() -> unit!:
    let workspace = Workspace(300, 200)
    let panels = Panels(workspace, Actions(), Font())
    let view = panels.view
    workspace.fitted = true
    workspace.zoom = 1.0
    workspace.offset_x = 0.0
    workspace.offset_y = 0.0
    # Z down picks the zoom tool (its shortcut); a drag right 100 points doubles.
    panels.choose_tool("zoom")
    press(view, 100.0, 100.0)
    drag_to(view, 200.0, 100.0)
    release(view, 200.0, 100.0)
    assert(math.abs(workspace.zoom - 2.0) < 0.001)
    view.event(Event(kind = EventKind.key_up, key = Key.z))
    assert(workspace.tool == "brush")
    # A tap of Z keeps the zoom tool; a click zooms in a step (200% to 300%), alt-click out.
    panels.choose_tool("zoom")
    view.event(Event(kind = EventKind.key_up, key = Key.z))
    assert(workspace.tool == "zoom")
    press(view, 50.0, 50.0)
    release(view, 50.0, 50.0)
    assert(math.abs(workspace.zoom - 3.0) < 0.001)
    press(view, 50.0, 50.0, alt = true)
    release(view, 50.0, 50.0, alt = true)
    assert(math.abs(workspace.zoom - 2.0) < 0.001)
    # Another key let go does not spring back.
    view.event(Event(kind = EventKind.key_up, key = Key.b))
    assert(workspace.tool == "zoom")
    workspace.zoom = 1.0
    workspace.offset_x = 0.0
    workspace.offset_y = 0.0
    # Shift pressed mid-drag squares the marquee to its longer side.
    panels.choose_tool("marquee")
    press(view, 10.0, 10.0)
    drag_to(view, 50.0, 20.0)
    drag_to(view, 50.0, 30.0, shift = true)
    release(view, 50.0, 30.0, shift = true)
    assert(workspace.canvas.selection_left() == 10 and workspace.canvas.selection_top() == 10)
    assert(workspace.canvas.selection_width() == 40 and workspace.canvas.selection_height() == 40)
    # Alt mid-drag centers it on the press.
    press(view, 100.0, 100.0)
    drag_to(view, 120.0, 110.0, alt = true)
    release(view, 120.0, 110.0, alt = true)
    assert(workspace.canvas.selection_left() == 80 and workspace.canvas.selection_top() == 90)
    assert(workspace.canvas.selection_width() == 40 and workspace.canvas.selection_height() == 20)
    # Shift held at the press adds, unconstrained: a tall 20 x 130 strip joins
    # the centered rectangle (squared, it would reach x = 300).
    press(view, 200.0, 20.0, shift = true)
    drag_to(view, 220.0, 150.0, shift = true)
    release(view, 220.0, 150.0, shift = true)
    assert(workspace.canvas.selection_left() == 80 and workspace.canvas.selection_top() == 20)
    assert(workspace.canvas.selection_width() == 140 and workspace.canvas.selection_height() == 130)
    # Shift+Alt held at the press intersects: only the strip's part inside 200..300 x 100..200 stays.
    press(view, 150.0, 100.0, shift = true, alt = true)
    drag_to(view, 300.0, 200.0, shift = true, alt = true)
    release(view, 300.0, 200.0, shift = true, alt = true)
    assert(workspace.canvas.selection_left() == 200 and workspace.canvas.selection_top() == 100)
    assert(workspace.canvas.selection_width() == 20 and workspace.canvas.selection_height() == 50)
    # A selection tool dragging inside the selection moves its outline; arrows nudge it.
    panels.choose_tool("marquee")
    press(view, 10.0, 10.0)
    release(view, 50.0, 50.0)
    press(view, 30.0, 30.0)
    drag_to(view, 40.0, 35.0)
    release(view, 40.0, 35.0)
    assert(workspace.canvas.selection_left() == 20 and workspace.canvas.selection_top() == 15)
    view.event(Event(kind = EventKind.key_down, key = Key.right, shift = true))
    assert(workspace.canvas.selection_left() == 30 and workspace.canvas.selection_width() == 40)
    # A click inside it without a drag deselects.
    press(view, 40.0, 40.0)
    release(view, 40.0, 40.0)
    assert(not workspace.canvas.has_selection())
    # Number keys: 4 then 5 at once is 45% brush opacity; after a pair a single
    # digit starts afresh: with the move tool, 3 is the layer's 30%.
    panels.choose_tool("brush")
    view.event(Event(kind = EventKind.key_down, key = Key.digit_4))
    assert(math.abs(workspace.brush.opacity - 0.4) < 0.001)
    view.event(Event(kind = EventKind.key_down, key = Key.digit_5))
    assert(math.abs(workspace.brush.opacity - 0.45) < 0.001)
    panels.choose_tool("move")
    view.event(Event(kind = EventKind.key_down, key = Key.digit_3))
    assert(math.abs(workspace.canvas.layer_opacity(workspace.selected) - 0.3) < 0.001)
    # The Move tool's Auto-Select checkbox in the header toggles the setting.
    assert(not workspace.auto_select)
    panels.header.auto_select_box.event(Event(kind = EventKind.key_down, key = Key.space))
    assert(workspace.auto_select)
    panels.header.auto_select_box.event(Event(kind = EventKind.key_down, key = Key.space))
    assert(not workspace.auto_select)
    # Shift ] and Shift [ step the hardness; ] and [ always change the size, even at one pixel.
    workspace.brush.hardness = 0.5
    panels.actions.harder.trigger()
    assert(math.abs(workspace.brush.hardness - 0.75) < 0.001)
    panels.actions.softer.trigger()
    panels.actions.softer.trigger()
    panels.actions.softer.trigger()
    assert(workspace.brush.hardness == 0.0)
    workspace.brush.diameter = 1.0
    panels.actions.bigger.trigger()
    assert(workspace.brush.diameter == 2.0)
    panels.actions.smaller.trigger()
    assert(workspace.brush.diameter == 1.0)
    # Shift + and Shift - step the layer's blend mode, wrapping.
    panels.actions.next_blend.trigger()
    assert(workspace.canvas.layer_blend(workspace.selected) == 1)
    panels.actions.previous_blend.trigger()
    panels.actions.previous_blend.trigger()
    assert(workspace.canvas.layer_blend(workspace.selected) == Canvas.blend_mode_count() - 1)
    panels.close()

func near(a: float, b: float) -> bool:
    return math.abs(a - b) < 0.0001

## The free transform's and the Crop tool's box geometry, as Photoshop's.
func boxes() -> unit!:
    let box = TransformBox(0.0, 0.0, 100.0, 50.0)
    assert(box.hit(50.0, 25.0, 3.0) == grab_move and box.hit(1.0, -1.0, 3.0) == 0 and box.hit(200.0, 200.0, 3.0) == grab_turn)
    # The bottom-right corner to (200, 100): twice the size, the top-left held.
    box.begin(4, 100.0, 50.0)
    box.drag(200.0, 100.0, false, false)
    assert(near(box.scale_x, 2.0) and near(box.scale_y, 2.0) and near(box.dx, 50.0) and near(box.dy, 25.0))
    # With Shift the corner goes free: only the width doubles here.
    box.drag(200.0, 50.0, true, false)
    assert(near(box.scale_x, 2.0) and near(box.scale_y, 1.0) and near(box.dx, 50.0) and near(box.dy, 0.0))
    box.end()
    let middle = TransformBox(0.0, 0.0, 100.0, 50.0)
    # Alt stretches the right side about the middle, which stays.
    middle.begin(3, 100.0, 25.0)
    middle.drag(150.0, 25.0, false, true)
    assert(near(middle.scale_x, 2.0) and near(middle.scale_y, 1.0) and near(middle.dx, 0.0))
    middle.end()
    # Outside turns it about its middle; Shift keeps to 15° steps.
    assert(middle.hit(250.0, 25.0, 3.0) == grab_turn)
    middle.begin(grab_turn, 250.0, 25.0)
    middle.drag(50.0, 125.0, false, false)
    assert(near(middle.angle, 90.0))
    middle.drag(60.0, 125.0, true, false)
    assert(near(middle.angle, 90.0))
    middle.end()
    # Turned a quarter, its right side (100 out from the middle) is at the bottom now.
    assert(middle.hit(50.0, 125.0, 3.0) == 3)
    # Cmd on a corner distorts: that corner alone goes where it is dragged.
    let bent = TransformBox(0.0, 0.0, 100.0, 50.0)
    bent.begin(2, 100.0, 0.0)
    bent.drag(130.0, -20.0, false, false, true)
    assert(bent.distorted and not bent.unchanged() and near(bent.corners[2], 130.0) and near(bent.corners[3], -20.0) and near(bent.corners[4], 100.0))
    # Dragged past the bottom-left corner it would fold over: not taken.
    bent.drag(-50.0, 90.0, false, false, true)
    assert(near(bent.corners[2], 130.0))
    bent.end()
    # A side takes both its corners; inside moves all four.
    bent.begin(5, 50.0, 50.0)
    bent.drag(50.0, 60.0, false, false)
    assert(near(bent.corners[5], 60.0) and near(bent.corners[7], 60.0) and near(bent.corners[1], 0.0))
    bent.end()
    assert(bent.contains(50.0, 30.0) and not bent.contains(-20.0, 30.0))
    # The numbers: width with the ratio kept, the middle, the scale, a flip.
    let typed = TransformBox(0.0, 0.0, 100.0, 50.0)
    typed.set_width(200.0, true)
    assert(near(typed.shown_height(), 100.0) and near(typed.middle_x(), 50.0))
    typed.set_middle(10.0, 20.0)
    typed.set_scale(50.0)
    typed.flip(true)
    assert(near(typed.middle_x(), 10.0) and near(typed.scale_x, -0.5) and near(typed.shown_width(), 50.0))
    let crop = CropBox(300.0, 200.0)
    # The bottom-right handle pulled in, to whole pixels.
    crop.begin(crop.hit(300.0, 200.0, 3.0), 300.0, 200.0)
    crop.drag(250.4, 150.6, false)
    crop.end()
    assert(crop.width() == 250 and crop.height() == 151)
    # A drag outside draws a new box, put right however it was drawn.
    assert(crop.hit(280.0, 10.0, 3.0) == crop_new)
    crop.begin(crop_new, 280.0, 10.0)
    crop.drag(260.0, 40.0, false)
    crop.end()
    assert(crop.left == 260.0 and crop.width() == 20 and crop.top == 10.0 and crop.height() == 30)

## Several layers selected, as Photoshop's Layers panel: Cmd-click adds or
## takes one out, Shift-click takes a run, a plain select keeps one.
func picking() -> unit!:
    let workspace = Workspace(64, 64)
    workspace.add_layer()
    workspace.add_layer()
    workspace.add_layer()
    assert(workspace.layer_count() == 4 and workspace.selected == 3)
    workspace.toggle_picked(1)
    assert(workspace.selected == 1 and workspace.is_selected(3) and workspace.is_selected(1) and not workspace.is_selected(2))
    let ids = workspace.selected_ids()
    assert(ids.length == 2 and ids[0] == workspace.canvas.layer_id(1) and ids[1] == workspace.canvas.layer_id(3))
    # Cmd-click again takes it out; the one the tools act on stays.
    workspace.toggle_picked(3)
    assert(not workspace.is_selected(3) and workspace.selected_ids().length == 1)
    workspace.pick_range(3)
    assert(workspace.selected == 3 and workspace.selected_ids().length == 3 and not workspace.is_selected(0))
    workspace.select(0)
    assert(workspace.selected_ids().length == 1)
    # Deleting several at once keeps the rest.
    workspace.pick_range(2)
    workspace.delete_layer()
    assert(workspace.layer_count() == 1)

## The adjustments' table: every kind at its engine number, its values laid
## out page by page then toggles, and the engine's numbers read back as shown.
func adjustment_table() -> unit!:
    let table = adjustments()
    var index = 0
    for adjustment in table:
        assert(adjustment.kind == index and adjustment.defaults().length == adjustment.value_count())
        index += 1
    let levels = table[3]
    assert(levels.value_count() == 20 and levels.defaults()[1] == 255.0 and levels.defaults()[6] == 255.0)
    let numbers = levels.engine(levels.defaults())
    assert(near(numbers[1], 1.0) and near(numbers[2], 1.0) and near(numbers[7], 1.0))
    let back = levels.shown_of(numbers)
    assert(near(back[1], 255.0) and near(back[2], 1.0))
    # Hue/Saturation: seven ranges of three, then Colorize; Color Balance keeps luminosity by default.
    assert(table[1].value_count() == 22 and table[10].defaults()[9] == 1.0 and table[7].layerable)

## The retouching tools tell the canvas what their strokes do.
func retouch_tools() -> unit!:
    let workspace = Workspace(64, 64)
    workspace.choose_tool("brush")
    assert(workspace.retouch_kind() == 0)
    workspace.choose_tool("clone")
    assert(workspace.retouch_kind() == 1)
    workspace.choose_tool("heal")
    assert(workspace.retouch_kind() == 2)
    workspace.choose_tool("smear")
    assert(workspace.retouch_kind() == 4)
    workspace.smear_mode = 1
    assert(workspace.retouch_kind() == 3)
    workspace.smear_mode = 2
    assert(workspace.retouch_kind() == 5)
    workspace.set_clone_source(10.0, 12.0)
    assert(workspace.canvas.has_clone_source() and workspace.canvas.clone_sample_x(40.0) == 10.0)

## Unsaved work: a changed tab asks before it closes and quitting asks too;
## Save writes an .l2d and clears the mark; exporting leaves both alone.
func unsaved_changes(arguments: list[str]) -> unit!:
    # The runner passes a scratch folder to write in.
    let folder = arguments[arguments.length - 1]
    let workspace = Workspace(64, 48)
    workspace.canvas.bind_headless()
    let panels = Panels(workspace, Actions(), Font())
    assert(not workspace.document_dirty(0) and panels.files.can_quit())
    workspace.add_layer()
    assert(workspace.document_dirty(0))
    panels.files.close_document_at(0)
    assert(panels.files.confirm.is_open() and workspace.document_count() == 1 and workspace.layer_count() == 2)
    assert(not panels.files.can_quit())
    assert(workspace.export_name(".png") == "Untitled.png")
    workspace.save(folder + "/unsaved")
    assert(workspace.path == folder + "/unsaved.l2d" and not workspace.document_dirty(0))
    assert(workspace.export_name(".jpg") == "unsaved.jpg")
    workspace.export(folder + "/unsaved.png")
    assert(workspace.path == folder + "/unsaved.l2d" and not workspace.document_dirty(0) and panels.files.can_quit())
    # Nothing past the canvas: Reveal All has nothing to do.
    assert(not workspace.reveal_all())
    panels.close()

## The Layers panel's operations: titles fitted to the selection, groups
## duplicated with what they hold, Merge Group, opacity for every selected
## layer and typed as digits.
func layer_panel_ops() -> unit!:
    let workspace = Workspace(64, 48)
    workspace.canvas.bind_headless()
    let actions = Actions()
    let panels = Panels(workspace, actions, Font())
    actions.add_layer.trigger()
    actions.add_layer.trigger()
    assert(workspace.layer_count() == 3 and workspace.selected == 2)
    workspace.toggle_picked(1)
    panels.layers_panel.fit_titles()
    assert(actions.merge_down.text() == "Merge Layers" and actions.delete_layer.text() == "Delete Selected Layers" and not actions.rename_layer.is_enabled())
    actions.group_layers.trigger()
    assert(workspace.layer_count() == 4 and workspace.canvas.layer_is_group(workspace.selected))
    panels.layers_panel.fit_titles()
    assert(actions.merge_down.text() == "Merge Group")
    # The group's copy holds copies of its two layers.
    actions.duplicate_layer.trigger()
    assert(workspace.layer_count() == 7 and workspace.canvas.layer_is_group(workspace.selected))
    actions.merge_down.trigger()
    assert(workspace.layer_count() == 5 and not workspace.canvas.layer_is_group(workspace.selected))
    assert(workspace.canvas.undo_name() == "Merge Group")
    # Every selected layer takes the opacity, in one step.
    workspace.select(0)
    workspace.toggle_picked(workspace.layer_count() - 1)
    set_opacity_all(workspace, 0.25)
    assert(workspace.canvas.layer_opacity(0) == 0.25 and workspace.canvas.layer_opacity(workspace.layer_count() - 1) == 0.25)
    let keys = OpacityKeys()
    assert(keys.typed(5, 1000) == 0.5 and keys.typed(5, 1200) == 0.55 and keys.typed(0, 5000) == 1.0 and keys.typed(0, 5100) == 0.0)
    panels.close()

## The size dialogs: units and the kept ratio, Canvas Size's anchor and
## extension layer, Trim.
func size_dialogs() -> unit!:
    let fields = SizeFields(Font(), true, true)
    fields.reset(200, 100, 72.0)
    assert(fields.pixels(true) == 200 and fields.pixels(false) == 100)
    fields.set_pixels(300, 150)
    assert(fields.pixels(false) == 150)
    fields.close()
    let workspace = Workspace(40, 30)
    workspace.canvas.bind_headless()
    let panels = Panels(workspace, Actions(), Font())
    let dialogs = panels.size_dialogs
    workspace.set_color(1.0, 0.0, 0.0)
    workspace.fill_selection(false)
    # Grown to 60 by 50 about the bottom-right corner, the new canvas white on a layer of its own.
    dialogs.canvas_size.resize(60, 50, 8, 4)
    assert(workspace.width() == 60 and workspace.height() == 50 and workspace.layer_count() == 2)
    assert(workspace.canvas.layer_name(0) == "Canvas Extension" and workspace.canvas.undo_name() == "Canvas Size")
    # Trimmed by the top-left color (the white extension): back to the red picture.
    assert(dialogs.trim.trim(1, true, true, true, true))
    assert(workspace.width() == 40 and workspace.height() == 30)
    assert(not dialogs.trim.trim(0, true, true, true, true))
    workspace.canvas.undo()
    assert(workspace.width() == 60)
    # One dialog at a time: Canvas Size waits while New Canvas is open. Escape
    # cancels the open one; Enter accepts it (New Canvas creates).
    let app = Application(panels.body)
    app.layout(1200.0, 800.0)
    dialogs.new_canvas.open()
    dialogs.canvas_size.open()
    assert(dialogs.new_canvas.dialog.is_open() and not dialogs.canvas_size.dialog.is_open())
    app.layout(1200.0, 800.0)
    app.dispatch(Event(kind = EventKind.key_down, key = Key.escape))
    assert(not dialogs.new_canvas.dialog.is_open())
    let before = workspace.document_count()
    dialogs.new_canvas.open()
    app.layout(1200.0, 800.0)
    app.dispatch(Event(kind = EventKind.key_down, key = Key.enter))
    assert(not dialogs.new_canvas.dialog.is_open() and workspace.document_count() == before + 1)
    app.close()
    panels.close()

## The Polygonal Lasso and the selection options: corners clicked and closed
## on the first, the header's mode used without modifiers, feathered shapes.
func selection_tools() -> unit!:
    let workspace = Workspace(64, 48)
    workspace.canvas.bind_headless()
    let lasso = PolygonLasso()
    lasso.click(workspace, 10.0, 10.0, false, false, 2.0, 0)
    lasso.click(workspace, 40.0, 10.0, false, false, 2.0, 1000)
    lasso.click(workspace, 40.0, 40.0, false, false, 2.0, 2000)
    lasso.take_back()
    lasso.click(workspace, 40.0, 40.0, false, false, 2.0, 3000)
    assert(lasso.active and not workspace.canvas.has_selection())
    # A click on the first corner closes it: a triangle.
    lasso.click(workspace, 11.0, 10.5, false, false, 2.0, 4000)
    assert(not lasso.active and workspace.canvas.selected_at(35, 15) == 255 and workspace.canvas.selected_at(15, 35) == 0)
    assert(workspace.canvas.undo_name() == "Lasso")
    # Esc lets a shape go.
    lasso.click(workspace, 50.0, 5.0, false, false, 2.0, 5000)
    lasso.cancel()
    assert(not lasso.active)
    # The header's mode applies without modifiers; the modifiers still win.
    workspace.selecting.mode = 1
    assert(workspace.selecting.mode_for(false, false) == 1 and workspace.selecting.mode_for(false, true) == 2 and workspace.selecting.mode_for(true, true) == 3)
    workspace.selecting.feather = 3
    workspace.select_shape(50.0, 30.0, 62.0, 46.0, false, workspace.selecting.mode_for(false, false))
    assert(workspace.canvas.selected_at(35, 15) == 255 and workspace.canvas.selected_at(56, 38) > 200 and workspace.canvas.selected_at(50, 38) < 255)

## Guides out of a ruler, moved, dragged back to go; snapping to the canvas,
## the guides, the other layers and the grid.
func guides_and_snapping() -> unit!:
    let workspace = Workspace(200, 100)
    workspace.canvas.bind_headless()
    let guides = GuideDrag()
    guides.begin_new(workspace, true)
    guides.drag(60.0, 20.0, false)
    guides.finish(workspace)
    assert(workspace.canvas.guide_count() == 1 and workspace.canvas.guide_position(0) == 60.0)
    # Near the middle (100) a guide snaps to it.
    guides.begin_new(workspace, true)
    guides.drag(103.0, 20.0, false)
    guides.finish(workspace)
    assert(workspace.canvas.guide_position(1) == 100.0)
    assert(guides.hit(workspace, 61.0, 50.0, 2.0) == 0 and guides.hit(workspace, 80.0, 50.0, 2.0) == -1)
    # Dragged back over the ruler, a guide goes.
    guides.begin(workspace, 0)
    guides.drag(-5.0, 20.0, true)
    guides.finish(workspace)
    assert(workspace.canvas.guide_count() == 1)
    workspace.lock_guides = true
    assert(guides.hit(workspace, 100.0, 50.0, 2.0) == -1)
    # The snapper: a box moved near the guide at 100 and the canvas's right edge.
    let snapper = Snapper()
    snapper.gather(workspace, [], true)
    assert(snapper.shift_x(95.0, 120.0) == 5.0 and snapper.snap_x(197.0) == 200.0 and snapper.snap_y(30.0) == 30.0)
    workspace.snap = false
    snapper.gather(workspace, [], true)
    assert(snapper.snap_x(197.0) == 197.0)

## Live text: a new text layer typed into, committed and named by its words;
## edited again with its settings; one left empty goes.
func live_text() -> unit!:
    let workspace = Workspace(200, 120)
    workspace.canvas.bind_headless()
    let actions = Actions()
    let panels = Panels(workspace, actions, Font())
    let editing = panels.text_editing
    editing.begin_new(10.0, 10.0, 0.0)
    assert(editing.active() and workspace.layer_count() == 2 and workspace.canvas.layer_typed(1))
    editing.replace_text("Hello there")
    assert(workspace.canvas.layer_text(1) == "Hello there")
    workspace.typing.size = 20.0
    editing.restyle()
    assert(workspace.canvas.layer_type_value(1, 0) == 20.0)
    actions.commit_text.trigger()
    assert(not editing.active() and workspace.canvas.layer_name(1) == "Hello there")
    # Making, naming and typing a new text layer is one undo step.
    assert(workspace.canvas.undo_name() == "Add Text")
    # Edited again, it brings its own settings; cancelled, it says what it said.
    workspace.typing.size = 60.0
    editing.begin_existing(1)
    assert(workspace.typing.size == 20.0)
    editing.replace_text("Changed")
    workspace.typing.size = 44.0
    editing.restyle()
    editing.cancel()
    assert(workspace.canvas.layer_text(1) == "Hello there" and workspace.canvas.layer_type_value(1, 0) == 20.0)
    # Cancelled without a change, the document stays as saved.
    workspace.canvas.mark_saved()
    editing.begin_existing(1)
    editing.cancel()
    assert(not workspace.canvas.modified())
    # A new one cancelled goes, leaving nothing changed.
    editing.begin_new(80.0, 80.0, 0.0)
    editing.replace_text("Gone")
    editing.cancel()
    assert(workspace.layer_count() == 2 and not workspace.canvas.modified())
    # Its box, not only its ink, is where a click edits it; the header restyles it once committed.
    assert(workspace.text_layer_at(12.0, 15.0, 2.0) == 1 and workspace.text_layer_at(190.0, 110.0, 2.0) == -1)
    workspace.select(1)
    workspace.typing.style = "Bold"
    workspace.typing.size = 30.0
    editing.restyle()
    assert(workspace.canvas.layer_font_style(1) == "Bold" and workspace.canvas.layer_type_value(1, 0) == 30.0 and workspace.canvas.layer_text(1) == "Hello there")
    # Left empty, a new one goes.
    editing.begin_new(50.0, 50.0, 100.0)
    editing.commit()
    assert(workspace.layer_count() == 2)
    panels.close()

## A gradient stays live after its drag: a handle moves its end, Enter keeps
## it as one step, a new drag keeps the last and starts another, Esc drops it.
func live_gradient() -> unit!:
    let workspace = Workspace(200, 100)
    workspace.canvas.bind_headless()
    let panels = Panels(workspace, Actions(), Font())
    let view = panels.view
    workspace.fitted = true
    workspace.zoom = 1.0
    workspace.offset_x = 0.0
    workspace.offset_y = 0.0
    panels.choose_tool("gradient")
    let steps = workspace.canvas.step_serial()
    press(view, 10.0, 50.0)
    drag_to(view, 100.0, 50.0)
    release(view, 100.0, 50.0)
    if let edit = workspace.gradient:
        assert(edit.x0 == 10.0 and edit.x1 == 100.0)
    else:
        assert(false)
    assert(workspace.canvas.previewing() and workspace.canvas.step_serial() == steps)
    # The end handle, dragged with Shift, stays level with the start.
    press(view, 100.0, 50.0)
    drag_to(view, 180.0, 58.0, shift = true)
    release(view, 180.0, 58.0, shift = true)
    if let edit = workspace.gradient:
        assert(math.abs(edit.y1 - 50.0) < 0.001 and edit.x1 > 170.0)
    view.event(Event(kind = EventKind.key_down, key = Key.enter))
    assert(workspace.gradient == none and not workspace.canvas.previewing() and workspace.canvas.step_serial() == steps + 1)
    # A new drag keeps the one before; Esc drops the new one.
    press(view, 20.0, 20.0)
    drag_to(view, 20.0, 90.0)
    release(view, 20.0, 90.0)
    press(view, 150.0, 20.0)
    drag_to(view, 150.0, 90.0)
    release(view, 150.0, 90.0)
    assert(workspace.canvas.step_serial() == steps + 2)
    view.event(Event(kind = EventKind.key_down, key = Key.escape))
    assert(workspace.gradient == none and workspace.canvas.step_serial() == steps + 2)
    panels.close()

## The Crop tool's box starts at the selection, fits a ratio about its middle,
## keeps it while dragged, and with Alt pulls both sides about the middle.
func crop_box_options() -> unit!:
    let workspace = Workspace(400, 300)
    workspace.canvas.bind_headless()
    workspace.canvas.select_rectangle(100, 50, 200, 100)
    workspace.choose_tool("crop")
    if let box = workspace.crop_box:
        assert(box.left == 100.0 and box.top == 50.0 and box.width() == 200 and box.height() == 100)
    else:
        assert(false)
    workspace.set_crop_ratio(1.0)
    if let box = workspace.crop_box:
        # Square, the largest inside, about the middle.
        assert(box.width() == 100 and box.height() == 100 and box.left == 150.0)
        # The right edge dragged out 40: the height follows, about the middle.
        box.begin(3, 250.0, 100.0)
        box.drag(290.0, 100.0, false)
        box.end()
        assert(box.width() == 140 and box.height() == 140)
    workspace.set_crop_ratio(0.0)
    if let box = workspace.crop_box:
        # Alt: the left edge moves in as far as the right is pulled out.
        let left = box.left
        let right = box.right
        box.begin(3, right, 100.0)
        box.drag(right + 10.0, 100.0, false, true)
        box.end()
        assert(box.right == right + 10.0 and box.left == left - 10.0)

## Masks: a new one is the target, Unlink keeps it put, Copy and Paste give
## another layer the same mask.
func mask_actions() -> unit!:
    let workspace = Workspace(120, 80)
    workspace.canvas.bind_headless()
    workspace.add_layer()
    let top = workspace.selected
    workspace.toggle_mask()
    assert(workspace.canvas.layer_masked(top) and workspace.canvas.editing_mask())
    workspace.toggle_mask_link()
    assert(not workspace.canvas.layer_mask_linked(top))
    workspace.copy_mask()
    workspace.select(0)
    assert(workspace.mask_source_present())
    workspace.paste_mask()
    assert(workspace.canvas.layer_masked(0) and workspace.canvas.editing_mask())

## A brush stroke through the view ends on release and is one undo step.
func stroke_undo() -> unit!:
    let workspace = Workspace(120, 80)
    workspace.canvas.bind_headless()
    let panels = Panels(workspace, Actions(), Font())
    let view = panels.view
    workspace.fitted = true
    workspace.zoom = 1.0
    workspace.offset_x = 0.0
    workspace.offset_y = 0.0
    panels.choose_tool("brush")
    press(view, 10.0, 10.0)
    drag_to(view, 60.0, 40.0)
    release(view, 60.0, 40.0)
    assert(not workspace.canvas.painting() and workspace.canvas.can_undo() and workspace.canvas.undo_name() == "Brush Stroke")
    # The frame's refresh shows it, and showing it changes nothing more.
    panels.refresh_if_changed()
    let shown = workspace.revision
    panels.refresh_if_changed()
    assert(workspace.revision == shown)
    panels.close()

class Sampled:
    pub var color: list[float]
    pub func init(self):
        self.color = []
    pub func take(self, color: list[float]) -> unit!:
        self.color = color

## A dialog's eyedropper takes one click on the canvas, the color there in sRGB.
func eyedropper_sample() -> unit!:
    let workspace = Workspace(40, 30)
    workspace.canvas.bind_headless()
    workspace.set_color(1.0, 0.0, 0.0)
    workspace.fill_selection(false)
    let sampled = Sampled()
    assert(not workspace.sample_to(5.0, 5.0))
    workspace.sample_for = sampled.take
    assert(workspace.sample_to(5.0, 5.0) and sampled.color.length == 3 and sampled.color[0] > 0.99 and sampled.color[1] < 0.01)

## A layer's effects listed under it: the eye hides one and keeps it listed,
## the cross deletes it, and one copies to another layer with its settings.
func effect_rows() -> unit!:
    let workspace = Workspace(40, 30)
    workspace.canvas.bind_headless()
    workspace.add_layer()
    let top = workspace.selected
    workspace.set_style_value(0, 1.0)
    workspace.set_style_value(3, 9.0)
    let rows = EffectRows()
    let shadow = 5
    assert(rows.listed(workspace.canvas, top) == [shadow])
    rows.toggle(workspace, top, shadow)
    assert(not rows.showing(workspace.canvas, top, shadow) and rows.listed(workspace.canvas, top) == [shadow])
    rows.toggle(workspace, top, shadow)
    assert(rows.showing(workspace.canvas, top, shadow))
    rows.copy(workspace, top, shadow, 0)
    assert(workspace.canvas.style_value(0, 0) == 1.0 and workspace.canvas.style_value(0, 3) == 9.0)
    rows.remove(workspace, top, shadow)
    assert(rows.listed(workspace.canvas, top).length == 0)

## A right-drag sizes the brush: right is bigger; with Shift, up is harder.
func brush_sizing() -> unit!:
    let workspace = Workspace(120, 80)
    let panels = Panels(workspace, Actions(), Font())
    let view = panels.view
    workspace.fitted = true
    workspace.zoom = 1.0
    panels.choose_tool("brush")
    let before = workspace.brush.diameter
    view.event(Event(kind = EventKind.pointer_down, x = 50.0, y = 40.0, button = 1, inside = true))
    view.event(Event(kind = EventKind.pointer_moved, x = 80.0, y = 40.0, inside = true))
    view.event(Event(kind = EventKind.pointer_up, x = 80.0, y = 40.0, button = 1, inside = true))
    assert(math.abs(workspace.brush.diameter - (before + 30.0)) < 0.001)
    panels.close()

## Whole layers: copied with nothing selected they paste above the selected
## layer; cut, they go; dragged onto another tab, they land there centred.
func whole_layers() -> unit!:
    let workspace = Workspace(40, 30)
    workspace.canvas.bind_headless()
    workspace.add_layer()
    workspace.set_style_value(0, 1.0)
    copy_layers(workspace, false)
    assert(Canvas.copied_layers() == 1)
    paste_layers(workspace, false)
    assert(workspace.layer_count() == 3 and workspace.selected == 2 and workspace.canvas.style_value(2, 0) == 1.0)
    copy_layers(workspace, true)
    assert(workspace.layer_count() == 2)
    paste_layers(workspace, true)
    assert(workspace.layer_count() == 3)
    let source = workspace.canvas
    workspace.create(80, 60)
    assert(workspace.current == 1)
    workspace.switch_document(0)
    send_layers(workspace, 1)
    assert(workspace.current == 1 and workspace.layer_count() == 2 and workspace.canvas.style_value(1, 0) == 1.0)
    assert(source.layer_count() == 3)

## The Filter menu's dialogs preview on the layer and keep one step each;
## Vignette, Grain and Noise are also live adjustment layers.
func filter_dialogs() -> unit!:
    let workspace = Workspace(80, 60)
    workspace.canvas.bind_headless()
    let panels = Panels(workspace, Actions(), Font())
    workspace.set_color(0.5, 0.5, 0.5)
    workspace.fill_selection(false)
    let names = ["Motion Blur", "Lens Correction", "Bloom", "Tonal Contrast"]
    var filter = 0
    while filter < 4:
        panels.adjust.filter(filter)
        assert(workspace.previewing())
        panels.adjust.apply()
        assert(not workspace.previewing() and workspace.canvas.undo_name() == names[filter])
        filter += 1
    panels.adjust.open(12)
    panels.adjust.apply()
    let before = workspace.layer_count()
    for kind in [12, 13, 14, 15]:
        let spec = adjustments()[kind]
        discard(workspace.add_adjustment_layer(kind, spec.name, spec.engine(spec.defaults())))
    assert(workspace.layer_count() == before + 4 and workspace.canvas.layer_adjustment(workspace.selected) == 15)
    panels.close()

## Tool options written when the window closes come back when it opens.
func tool_options_kept() -> unit!:
    let path = tools_path(paths.join(files.home_directory(), ".luced-2d-test"))
    let first = Workspace(40, 30)
    first.tool = "lasso"
    first.brush.diameter = 77.0
    first.selecting.feather = 9
    first.typing.family = "Menlo"
    first.gradient_radial = true
    remember_tools(first, path)
    let second = Workspace(40, 30)
    restore_tools(second, path)
    assert(second.tool == "lasso" and second.brush.diameter == 77.0 and second.selecting.feather == 9 and second.typing.family == "Menlo" and second.gradient_radial)
    # What the file gets wrong keeps its default.
    files.write_text(path, "[brush]\ndiameter = -5\n[tool]\ncurrent = \"nothing\"\n")
    let third = Workspace(40, 30)
    restore_tools(third, path)
    assert(third.brush.diameter == 32.0 and third.tool == "brush")

## The update feed tells of a later release only.
func update_versions() -> unit!:
    assert(newer("0.1.58", "0.1.57") and newer("0.2.0", "0.1.99") and newer("1.0.0", "0.9.9"))
    assert(not newer("0.1.57", "0.1.57") and not newer("0.1.9", "0.1.10") and not newer("error: offline", "0.1.57") and not newer("", "0.1.57"))

## Color Range: a click on the disc samples its color and selects it; Shift
## adds the ground, Cancel puts the old selection back; OK keeps it as one step.
func color_range() -> unit!:
    let workspace = Workspace(96, 64)
    workspace.canvas.bind_headless()
    let panels = Panels(workspace, Actions(), Font())
    let view = panels.view
    workspace.fitted = true
    workspace.zoom = 1.0
    workspace.offset_x = 0.0
    workspace.offset_y = 0.0
    workspace.set_color(0.0, 0.0, 1.0)
    workspace.fill_selection(false)
    workspace.canvas.select_ellipse(33, 17, 30, 30, 0)
    workspace.set_color(1.0, 0.8, 0.0)
    workspace.fill_selection(false)
    workspace.canvas.deselect()
    workspace.canvas.select_rectangle(0, 0, 8, 8, 0)
    panels.color_range.open()
    assert(workspace.range_sample_for != none)
    press(view, 48.0, 32.0)
    release(view, 48.0, 32.0)
    panels.color_range.poll()
    # Shown live, out of history.
    assert(workspace.canvas.undo_name() == "Select" and workspace.canvas.selected_at(48, 32) == 255 and workspace.canvas.selected_at(4, 4) == 0)
    press(view, 4.0, 4.0, shift = true)
    release(view, 4.0, 4.0)
    # Nothing is worked out until the frame; then the latest change, once.
    assert(workspace.canvas.selected_at(4, 4) == 0)
    panels.color_range.poll()
    assert(workspace.canvas.selected_at(48, 32) == 255 and workspace.canvas.selected_at(4, 4) == 255)
    panels.color_range.cancel()
    assert(workspace.range_sample_for == none and workspace.canvas.undo_name() == "Select" and not workspace.canvas.can_redo() and workspace.canvas.selected_at(48, 32) == 0)
    # OK: one step.
    panels.color_range.open()
    press(view, 48.0, 32.0)
    release(view, 48.0, 32.0)
    panels.color_range.apply()
    assert(workspace.canvas.undo_name() == "Color Range" and workspace.canvas.selected_at(48, 32) == 255 and workspace.canvas.selected_at(4, 4) == 0)
    # Headless, from a script: the disc's color and the shadows.
    workspace.select_color_range(0, 40.0, false, [1.0, 0.9, 0.0], [false])
    assert(workspace.canvas.selected_at(48, 32) == 255 and workspace.canvas.selected_at(4, 4) == 0)
    workspace.select_color_range(9, 40.0, false, [], [])
    assert(workspace.canvas.selected_at(48, 32) == 0)
    panels.close()

## Tab steps a tool through its modes; the idle tool leaves the canvas alone.
func tool_modes() -> unit!:
    let workspace = Workspace(40, 30)
    workspace.tool = "marquee"
    workspace.cycle_tool_mode()
    assert(workspace.selecting.mode == 1)
    workspace.tool = "brush"
    workspace.cycle_tool_mode()
    assert(workspace.tool == "eraser" and workspace.erasing)
    let panels = Panels(workspace, Actions(), Font())
    panels.choose_tool("idle")
    let steps = workspace.canvas.undo_name()
    press(panels.view, 10.0, 10.0)
    release(panels.view, 12.0, 12.0)
    assert(workspace.canvas.undo_name() == steps and workspace.tool == "idle")
    panels.close()

## A script's lines are read back exactly; a script run by Luce's interpreter
## adds a layer, paints and adjusts as one undo step, and a failing action
## stops it.
func scripts() -> unit!:
    let line = parse_line("@l2d add_layer\tSky\\tblue\t1") else trap("a script line")
    assert(line.action == "add_layer" and line.fields == ["Sky\tblue", "1"])
    assert(parse_line("hello") == none)
    let workspace = Workspace(64, 48)
    workspace.canvas.bind_headless()
    let host = ScriptHost(workspace, none, paths.join(files.home_directory(), ".luced-2d-test-run"))
    let before = workspace.layer_count()
    host.run_to_end("import luced\n\npub func main(arguments: list[str]) -> int!:\n    luced.add_layer(\"Sun\")\n    luced.set_color(1.0, 0.8, 0.0)\n    luced.select_ellipse(10, 10, 20, 20)\n    luced.fill()\n    luced.adjust(\"Exposure\", [0.5])\n    print(f\"{luced.document_width()} wide\")\n    return 0\n")
    if host.console.contains("No such file") or host.console.contains("status 127"):
        # No Luce installed where the tests run: nothing more to check here.
        return
    assert(host.succeeded and host.console.contains("64 wide"))
    assert(workspace.layer_count() == before + 1 and workspace.canvas.layer_name(workspace.selected) == "Sun")
    assert(workspace.canvas.undo_name() == "Script")
    workspace.undo()
    assert(workspace.layer_count() == before)
    host.run_to_end("import luced\n\npub func main(arguments: list[str]) -> int!:\n    luced.select_layer(9)\n    luced.add_layer(\"Never\")\n    return 0\n")
    assert(not host.succeeded and host.console.contains("select_layer failed") and workspace.layer_count() == before)
    # A menu command that needs a selection runs once the script made one,
    # with no window to refresh which commands can run.
    let actions = Actions()
    let panels = Panels(workspace, actions, Font())
    let commands = ScriptCommands(workspace, actions)
    commands.apply(parse_line("@l2d select_rectangle\t10\t10\t30\t30\t0") else trap("line"))
    commands.apply(parse_line("@l2d run\tinverse") else trap("line"))
    assert(workspace.canvas.undo_name() == "Inverse")
    commands.apply(parse_line("@l2d select_color_range\t9\t40\tfalse") else trap("line"))
    assert(workspace.canvas.undo_name() == "Color Range")
    panels.close()

## The Script editor opens with a starter script that runs: dots on a layer.
func script_editor() -> unit!:
    let workspace = Workspace(120, 80)
    workspace.canvas.bind_headless()
    let panels = Panels(workspace, Actions(), Font())
    panels.scripts.open()
    assert(panels.scripts.dialog.is_open())
    let before = workspace.layer_count()
    panels.scripts.run()
    while panels.scripts.host.running():
        panels.scripts.poll()
    panels.scripts.poll()
    if panels.scripts.host.succeeded:
        assert(workspace.layer_count() == before + 1 and workspace.canvas.layer_name(workspace.selected) == "Dots")
    panels.scripts.close()
    panels.close()

## Tools come in groups on the rail; shapes land on layers of their own; the
## pencil paints whole pixels; each tool has its cursor.
func groups_and_shapes() -> unit!:
    assert(group_of("lasso") == group_of("marquee") and group_of("pencil") == group_of("brush") and group_of("line") >= 0 and group_of("wand") == -1)
    assert(cursor_for("zoom", false, false, false) == Cursor.hidden and cursor_for("brush", false, false, false) == Cursor.hidden)
    assert(cursor_for("brush", false, false, true) == Cursor.crosshair and cursor_for("wand", false, false, false) == Cursor.crosshair)
    assert(cursor_for("text", false, false, false) == Cursor.text and cursor_for("hand", false, false, false) == Cursor.grab and cursor_for("move", true, false, false) == Cursor.grabbing)
    let workspace = Workspace(120, 80)
    workspace.canvas.bind_headless()
    let panels = Panels(workspace, Actions(), Font())
    let view = panels.view
    workspace.fitted = true
    workspace.zoom = 1.0
    workspace.offset_x = 0.0
    workspace.offset_y = 0.0
    let before = workspace.layer_count()
    for tool in ["rectangle", "shape_ellipse", "line", "shape_polygon"]:
        panels.choose_tool(tool)
        press(view, 20.0, 20.0)
        drag_to(view, 60.0, 50.0)
        release(view, 60.0, 50.0)
    assert(workspace.layer_count() == before + 4 and workspace.canvas.layer_name(workspace.selected) == "Polygon" and not workspace.canvas.has_selection())
    # They are shape layers: vector, restyled from the header.
    assert(workspace.canvas.layer_shaped(workspace.selected) and workspace.canvas.layer_shape_value(workspace.selected, 0) == 3.0)
    workspace.undo()
    assert(workspace.layer_count() == before + 3)
    workspace.shape_stroke = true
    restyle_selected(workspace)
    assert(workspace.canvas.layer_shape_value(workspace.selected, 11) == 1.0)
    # The line scaled 200%: its weight doubles; the header shows it and a restyle keeps it.
    panels.choose_tool("line")
    workspace.shape_weight = 3.0
    restyle_selected(workspace)
    assert(workspace.begin_transform())
    if let session = workspace.transform:
        session.box.set_scale(200.0)
    workspace.preview_transform()
    workspace.finish_transform(true)
    assert(workspace.canvas.layer_shaped(workspace.selected) and math.abs(workspace.canvas.layer_shape_value(workspace.selected, 15) - 6.0) < 1e-6)
    panels.header.show(false)
    assert(workspace.shape_weight == 6.0)
    workspace.shape_sides = 7
    restyle_selected(workspace)
    assert(math.abs(workspace.canvas.layer_shape_value(workspace.selected, 15) - 6.0) < 1e-6)
    # The transform box is the shape and its stroke, no more: doubled, the pixels are
    # twice as wide (the rasteriser leaves no faint residue beside a shape).
    let big = Workspace(1280, 800)
    big.canvas.bind_headless()
    let big_panels = Panels(big, Actions(), Font())
    big_panels.choose_tool("rectangle")
    big.shape_stroke = true
    big.shape_stroke_width = 4.0
    big.shape_radius = 20.0
    draw_shape(big, "rectangle", 300.0, 300.0, 219.0, 148.0)
    assert(big.canvas.measure_content(big.selected_id()) and big.canvas.content_width() == 223 and big.canvas.content_height() == 152)
    assert(big.begin_transform())
    if let session = big.transform:
        session.box.set_width(session.box.width * 2.0, true)
    big.preview_transform()
    big.finish_transform(true)
    assert(big.canvas.measure_content(big.selected_id()) and big.canvas.content_width() >= 446 and big.canvas.content_width() <= 448)
    assert(big.canvas.layer_shape_value(big.selected, 15) == 8.0)
    big_panels.close()
    # The rail's brush group shows the pencil once it is chosen.
    panels.choose_tool("pencil")
    press(view, 90.0, 10.0)
    drag_to(view, 110.0, 30.0)
    release(view, 110.0, 30.0)
    assert(workspace.canvas.undo_name() != "")
    panels.close()

## Hue/Saturation On Image: a press picks the range of the color there; a
## drag right raises its saturation.
func on_image_adjustment() -> unit!:
    let workspace = Workspace(120, 80)
    workspace.canvas.bind_headless()
    let panels = Panels(workspace, Actions(), Font())
    let view = panels.view
    workspace.fitted = true
    workspace.zoom = 1.0
    workspace.offset_x = 0.0
    workspace.offset_y = 0.0
    workspace.set_color(1.0, 0.0, 0.0)
    workspace.fill_selection(false)
    panels.adjust.open(1)
    panels.adjust.controls.toggle_on_image()
    press(view, 30.0, 30.0)
    drag_to(view, 70.0, 30.0)
    release(view, 70.0, 30.0)
    # Reds (page 1) saturation went up by half the 40 points moved.
    let shown = panels.adjust.controls.values(1)
    assert(shown[3 + 1] > 15.0)
    panels.adjust.cancel()
    assert(workspace.drag_for == none)
    panels.close()

## Every hue finds its range: Reds 1 … Magentas 6, a grey Master.
func hue_ranges() -> unit!:
    assert(range_of([0.82, 0.52, 0.82]) == 6 and range_of([0.9, 0.6, 0.91]) == 6 and range_of([0.9, 0.2, 0.2]) == 1)
    assert(range_of([0.9, 0.9, 0.1]) == 2 and range_of([0.1, 0.9, 0.1]) == 3 and range_of([0.1, 0.9, 0.9]) == 4)
    assert(range_of([0.1, 0.1, 0.9]) == 5 and range_of([0.5, 0.5, 0.5]) == 0 and range_of([0.9, 0.3, 0.8]) == 6)

## Dodge lightens and Burn darkens a grey where they are brushed; Tab steps the range.
func dodge_and_burn() -> unit!:
    let workspace = Workspace(80, 40)
    workspace.canvas.bind_headless()
    let panels = Panels(workspace, Actions(), Font())
    let view = panels.view
    workspace.fitted = true
    workspace.zoom = 1.0
    workspace.offset_x = 0.0
    workspace.offset_y = 0.0
    workspace.set_color(0.2140, 0.2140, 0.2140)
    workspace.fill_selection(false)
    panels.choose_tool("dodge")
    press(view, 20.0, 20.0)
    release(view, 20.0, 20.0)
    assert(workspace.canvas.undo_name() == "Dodge")
    panels.choose_tool("burn")
    press(view, 60.0, 20.0)
    release(view, 60.0, 20.0)
    assert(workspace.canvas.undo_name() == "Burn")
    let range = workspace.tone_range
    workspace.cycle_tool_mode()
    assert(workspace.tone_range == (range + 1) % 3)
    panels.close()


## HEIC photos and camera raws open, as the other pictures.
func opens_photos() -> unit!:
    let workspace = Workspace(16, 16)
    for name in ["IMG_0001.HEIC", "a.heif", "b.dng", "c.CR2", "c.cr3", "d.nef", "e.arw", "f.orf", "g.rw2", "h.pef", "i.raf"]:
        assert(workspace.can_open(name) and workspace.can_place(name))
    assert(not workspace.can_open("notes.txt"))
