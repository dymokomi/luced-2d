from ui import Application, Event, Font
from gpu import Frame
from input import EventKind, Key
from document import Document
from canvas import Canvas
from panels import Panels
from app import Luce2D
import window

pub func main(arguments: list[str]) -> int!:
    discard(arguments)
    painting()
    layers()
    resizing()
    canvas_strokes()
    panels_properties()
    layer_buttons()
    shortcuts()
    print("PASS luced-2d painting, layers, canvas, panels and shortcuts")
    return 0

func painting() -> unit!:
    let document = Document()
    assert(document.width == 800 and document.height == 600 and document.dpi == 72)
    assert(document.layers.length == 1 and document.selected == 0)
    assert(not document.erasing)
    document.dab(100.0, 100.0)
    assert(document.active().pixels.alpha_at(100, 100) > 0.9)
    document.erasing = true
    document.dab(100.0, 100.0)
    assert(document.active().pixels.alpha_at(100, 100) < 0.01)
    document.erasing = false
    document.dab(200.0, 200.0)
    document.checkpoint()
    document.dab(300.0, 300.0)
    document.undo()
    assert(document.active().pixels.alpha_at(300, 300) < 0.01)
    assert(document.active().pixels.alpha_at(200, 200) > 0.9)
    document.redo()
    assert(document.active().pixels.alpha_at(300, 300) > 0.9)
    let segment_document = Document()
    segment_document.segment(50.0, 50.0, 150.0, 50.0)
    assert(segment_document.active().pixels.alpha_at(100, 50) > 0.9)

func layers() -> unit!:
    let document = Document()
    document.add()
    assert(document.layers.length == 2 and document.selected == 1)
    assert(document.active().name == "Layer 2")
    document.active().opacity = 50
    document.dab(50.0, 50.0)
    document.choose(0)
    assert(document.selected == 0)
    let flat = document.flattened()
    let alpha = flat.alpha_at(50, 50)
    assert(alpha > 0.3 and alpha < 0.7)
    document.choose(1)
    document.active().visible = false
    let hidden = document.flattened()
    assert(hidden.alpha_at(50, 50) < 0.01)
    document.active().visible = true
    document.move(-1)
    assert(document.selected == 0 and document.layers[0].name == "Layer 2")
    document.remove()
    assert(document.layers.length == 1)
    document.remove()
    assert(document.layers.length == 1)

func resizing() -> unit!:
    let document = Document()
    document.dab(10.0, 10.0)
    document.resize(100, 100)
    assert(document.width == 100 and document.height == 100)
    assert(document.active().pixels.width() == 100 and document.active().pixels.height() == 100)
    assert(document.active().pixels.alpha_at(10, 10) > 0.9)
    document.resize(200, 150)
    assert(document.active().pixels.alpha_at(10, 10) > 0.9)

func canvas_strokes() -> unit!:
    let document = Document()
    let canvas = Canvas(document)
    let app = Application(canvas, width = 1200, height = 800)
    app.layout(1200.0, 800.0)
    let rect = canvas.rectangle()
    let scale = canvas.scale()
    let x = rect.x + 100.0 * scale
    let y = rect.y + 100.0 * scale
    let end = x + 100.0 * scale
    app.dispatch(Event(kind = EventKind.pointer_down, x = x, y = y))
    app.dispatch(Event(kind = EventKind.pointer_moved, x = end, y = y))
    app.dispatch(Event(kind = EventKind.pointer_up, x = end, y = y))
    assert(document.active().pixels.alpha_at(150, 100) > 0.9)
    let frame = Frame(window.Size(1200.0, 800.0, 1200.0, 800.0, 1.0))
    app.render(frame.target())
    assert(canvas.rendered_alpha(150, 100) > 0.9)
    frame.close()
    document.erasing = true
    app.dispatch(Event(kind = EventKind.pointer_down, x = x + 50.0 * scale, y = y))
    app.dispatch(Event(kind = EventKind.pointer_up, x = x + 50.0 * scale, y = y))
    assert(document.active().pixels.alpha_at(150, 100) < 0.01)
    app.close()

func panels_properties() -> unit!:
    let font = Font()
    let document = Document()
    let panels = Panels(document, font)
    let app = Application(panels.body, width = 1200, height = 800)
    app.layout(1200.0, 800.0)
    assert(panels.layers.selected_index() == 0)
    assert(not panels.prompt.is_open())
    panels.erase()
    assert(document.erasing)
    panels.brush()
    assert(not document.erasing)
    panels.edit_property("width")
    assert(panels.prompt.is_open())
    panels.apply("1024")
    assert(document.width == 1024 and not panels.prompt.is_open())
    panels.edit_property("height")
    panels.apply("768")
    assert(document.height == 768)
    panels.edit_property("width")
    panels.apply("2048")
    assert(document.width == 1024 and panels.prompt.is_open())
    panels.apply("1024")
    assert(not panels.prompt.is_open())
    panels.edit_property("dpi")
    panels.apply("0")
    assert(document.dpi == 72 and panels.prompt.is_open())
    panels.apply("300")
    assert(document.dpi == 300 and not panels.prompt.is_open())
    panels.edit_property("diameter")
    panels.apply("48")
    assert(document.brush_diameter == 48)
    panels.erase()
    panels.edit_property("diameter")
    panels.apply("96")
    assert(document.eraser_diameter == 96)
    panels.edit_property("hardness")
    panels.apply("25")
    assert(document.eraser_hardness == 25)
    panels.brush()
    panels.edit_property("hardness")
    panels.apply("25")
    assert(document.brush_hardness == 25)
    panels.edit_property("opacity")
    panels.apply("60")
    assert(document.active().opacity == 60)
    panels.edit_property("rename")
    panels.apply("Base")
    assert(document.active().name == "Base")
    panels.edit_property("rename")
    panels.apply("")
    assert(document.active().name == "Base" and panels.prompt.is_open())
    panels.apply("Base")
    assert(not panels.prompt.is_open())
    let frame = Frame(window.Size(1200.0, 800.0, 1200.0, 800.0, 1.0))
    app.render(frame.target())
    frame.close()
    panels.close()
    app.close()

func layer_buttons() -> unit!:
    let font = Font()
    let document = Document()
    let panels = Panels(document, font)
    panels.add_layer()
    assert(document.layers.length == 2 and document.selected == 1)
    assert(panels.layers.selected_index() == 0)
    panels.select_layer(1)
    assert(document.selected == 0)
    assert(panels.layers.selected_index() == 1)
    panels.toggle_visibility()
    assert(not document.layers[0].visible)
    panels.toggle_visibility()
    assert(document.layers[0].visible)
    document.dab(20.0, 20.0)
    panels.clear_layer()
    assert(document.layers[0].pixels.alpha_at(20, 20) < 0.01)
    panels.undo()
    assert(document.layers[0].pixels.alpha_at(20, 20) > 0.9)
    panels.redo()
    assert(document.layers[0].pixels.alpha_at(20, 20) < 0.01)
    panels.delete_layer()
    assert(document.layers.length == 1)
    panels.delete_layer()
    assert(document.layers.length == 1)
    panels.close()

func shortcuts() -> unit!:
    let editor = Luce2D()
    let app = editor.app
    let document = editor.document
    app.layout(1200.0, 800.0)
    app.dispatch(Event(kind = EventKind.key_down, key = Key.e))
    assert(document.erasing)
    app.dispatch(Event(kind = EventKind.key_down, key = Key.b))
    assert(not document.erasing)
    document.checkpoint()
    document.dab(10.0, 10.0)
    assert(document.active().pixels.alpha_at(10, 10) > 0.9)
    app.dispatch(Event(kind = EventKind.key_down, key = Key.z, control = true))
    assert(document.active().pixels.alpha_at(10, 10) < 0.01)
    app.dispatch(Event(kind = EventKind.key_down, key = Key.z, control = true, shift = true))
    assert(document.active().pixels.alpha_at(10, 10) > 0.9)
    editor.close()
