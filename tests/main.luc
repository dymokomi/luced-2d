from ui import Font
from gpu import Frame
from workspace import Workspace
from panels import Panels
from view import CanvasView
import window

## Headless checks of the workspace and the window contents, without a device:
## drawing on a standalone frame records nothing but must not fail.
pub func main(arguments: list[str]) -> int!:
    discard(arguments)
    layers()
    viewing()
    contents()
    print("PASS luced-2d workspace, view and panels")
    return 0

func layers() -> unit!:
    let workspace = Workspace(640, 480)
    assert(workspace.width() == 640 and workspace.height() == 480 and workspace.layer_count() == 1)
    workspace.add_layer()
    workspace.add_layer()
    assert(workspace.layer_count() == 3 and workspace.selected == 2)
    workspace.toggle_visibility()
    assert(not workspace.canvas.layer_visible(2))
    workspace.set_opacity(0.25)
    assert(workspace.canvas.layer_opacity(2) == 0.25)
    workspace.select(0)
    workspace.delete_layer()
    assert(workspace.layer_count() == 2 and workspace.selected == 0)
    workspace.create(32, 16)
    assert(workspace.width() == 32 and workspace.layer_count() == 1 and workspace.path == "")

func viewing() -> unit!:
    let workspace = Workspace(200, 100)
    workspace.fit(1000.0, 600.0)
    assert(workspace.zoom == 4.6 and workspace.offset_x == 40.0 and workspace.offset_y == 70.0)
    workspace.zoom_about(2.0, 40.0, 70.0)
    assert(workspace.zoom == 9.2 and workspace.offset_x == 40.0 and workspace.offset_y == 70.0)
    workspace.zoom_about(0.5, 0.0, 0.0)
    assert(workspace.zoom == 4.6 and workspace.offset_x == 20.0 and workspace.offset_y == 35.0)
    workspace.pan(5.0, -5.0)
    assert(workspace.offset_x == 25.0 and workspace.offset_y == 30.0)
    workspace.actual_size(1000.0, 600.0)
    assert(workspace.zoom == 1.0 and workspace.offset_x == 400.0 and workspace.offset_y == 250.0)
    let view = CanvasView(workspace)
    view.layout().set_size(1000.0, 600.0)
    let frame = Frame(window.Size(1000.0, 600.0, 1000.0, 600.0, 1.0))
    let target = frame.target()
    view.draw(target)
    frame.close()

func contents() -> unit!:
    let workspace = Workspace(300, 200)
    let font = Font()
    let panels = Panels(workspace, font)
    panels.add_layer()
    assert(workspace.layer_count() == 2)
    panels.select_layer(0)
    assert(workspace.selected == 0)
    panels.zoom_in()
    assert(workspace.zoom == 2.0)
    panels.close()
