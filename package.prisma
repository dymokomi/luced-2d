#prisma 4.0
def package "luced-2d" {
    str owner = "dymokomi"
    str version = "0.1.0"
    str kind = "application"
    str language = "luce"
    str description = "An image editor written in Luce: layered GPU documents from luce-image, drawn at any zoom, with the look of a brutalist grey-and-orange tool."
    str readme = "README.md"
    str entry = "src/main.luc"

    def application "bundle" {
        str name = "Luced 2D"
        str identifier = "com.luciaos.luced-2d"
    }

    def dependency "luce-ui" {
        str owner = "dymokomi"
        str version = "^0.2.0"
        str path = "../luce-ui"
    }

    def dependency "luce-image" {
        str owner = "dymokomi"
        str version = "^0.2.0"
        str path = "../luce-image"
    }
}
